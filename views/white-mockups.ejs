<%- include('partials/header', { bodyClass: 'category-catalog-page white-mockup-library-page' }) %>
<%
  const typeLabels = Object.fromEntries(categories.map(category => [category.slug, category.label]));
  const cleanAssetTitle = function(asset) {
    return String(asset.title || asset.asset_name || 'Fashion mockup')
      .replace(/^Model\s+\d+\s+/i, '')
      .replace(/\s+From3d(?:\s+V\d+)?/i, '')
      .replace(/\s+/g, ' ')
      .trim();
  };
  const pageHref = function(pageNumber) {
    const params = [];
    if (activeType) params.push(`type=${encodeURIComponent(activeType)}`);
    if (pageNumber > 1) params.push(`page=${pageNumber}`);
    return `/white-mockups${params.length ? `?${params.join('&')}` : ''}#white-mockup-library`;
  };
  const activeLabel = activeCategory ? activeCategory.label : 'All fashion mockups';
%>

<header class="white-catalog-intro">
  <div class="white-catalog-shell">
    <span class="white-catalog-eyebrow">Fashion mockups</span>
    <h1>
      <span class="white-catalog-desktop-title">Choose a look. Add your design.</span>
      <span class="white-catalog-mobile-title">Fashion mockups</span>
    </h1>
    <p>Browse garments worn on real models, then open a look to place your artwork.</p>
    <a class="white-catalog-jump" href="#white-mockup-library">Browse mockups <span aria-hidden="true">↓</span></a>
  </div>
</header>

<section class="white-catalog-section" id="white-mockup-library" aria-labelledby="white-catalog-results-title">
  <div class="white-catalog-shell white-catalog-layout">
    <nav class="white-catalog-categories" aria-label="Fashion mockup categories">
      <h2>Garments</h2>
      <div class="white-catalog-category-list">
        <a href="/white-mockups#white-mockup-library" class="<%= !activeType ? 'active' : '' %>" <% if (!activeType) { %>aria-current="page"<% } %>>
          <span>All garments</span><small><%= assetSummary.total %></small>
        </a>
        <% categories.forEach(function(category) { %>
          <a href="/white-mockups?type=<%= category.slug %>#white-mockup-library" class="<%= activeType === category.slug ? 'active' : '' %>" <% if (activeType === category.slug) { %>aria-current="page"<% } %>>
            <span><%= category.label %></span><small><%= category.count %></small>
          </a>
        <% }); %>
      </div>
    </nav>

    <div class="white-catalog-results">
      <div class="white-catalog-results-header">
        <div>
          <h2 id="white-catalog-results-title"><%= activeLabel %></h2>
          <% if (activeCategory) { %><p><%= activeCategory.description %></p><% } %>
        </div>
        <span class="white-catalog-result-count"><%= pagination.total ? `${pagination.start}–${pagination.end} of ${pagination.total}` : '0 mockups' %></span>
      </div>

      <% if (assets.length) { %>
        <div class="white-catalog-grid">
          <% assets.forEach(function(asset, index) { %>
            <a class="white-catalog-card" href="/white-mockups/<%= asset.asset_name %>" aria-label="Open <%= cleanAssetTitle(asset) %> fashion mockup">
              <figure class="white-catalog-image">
                <img src="<%= asset.base_image_url %>" alt="<%= cleanAssetTitle(asset) %> on-model fashion mockup" loading="<%= index < 3 ? 'eager' : 'lazy' %>" <%= index === 0 ? 'fetchpriority="high"' : '' %> width="<%= asset.canvas_width %>" height="<%= asset.canvas_height %>">
              </figure>
              <div class="white-catalog-card-meta">
                <h3><%= cleanAssetTitle(asset) %></h3>
                <span><%= typeLabels[asset.fashion_category_slug] || 'Fashion mockup' %></span>
                <span class="white-catalog-open" aria-hidden="true">Open mockup ↗</span>
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <div class="white-catalog-empty">
          <h3>No fashion mockups found.</h3>
          <p>Choose another garment category or browse the full collection.</p>
          <a href="/white-mockups#white-mockup-library">View all fashion mockups <span aria-hidden="true">↗</span></a>
        </div>
      <% } %>

      <% if (pagination.pageCount > 1) { %>
        <nav class="white-catalog-pagination" aria-label="Fashion mockup pages">
          <% if (pagination.page > 1) { %>
            <a class="white-catalog-page-direction" href="<%= pageHref(pagination.page - 1) %>" rel="prev">← Previous</a>
          <% } else { %>
            <span class="white-catalog-page-direction disabled" aria-disabled="true">← Previous</span>
          <% } %>
          <div class="white-catalog-pages">
            <% pagination.pages.forEach(function(pageNumber) { %>
              <% if (pageNumber === null) { %>
                <span aria-hidden="true">…</span>
              <% } else if (pageNumber === pagination.page) { %>
                <span class="current" aria-current="page"><%= pageNumber %></span>
              <% } else { %>
                <a href="<%= pageHref(pageNumber) %>" aria-label="Page <%= pageNumber %>"><%= pageNumber %></a>
              <% } %>
            <% }); %>
          </div>
          <% if (pagination.page < pagination.pageCount) { %>
            <a class="white-catalog-page-direction" href="<%= pageHref(pagination.page + 1) %>" rel="next">Next →</a>
          <% } else { %>
            <span class="white-catalog-page-direction disabled" aria-disabled="true">Next →</span>
          <% } %>
        </nav>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<%- include('partials/header', { bodyClass: resourceType === '3d-models' ? 'category-catalog-page' : '' }) %>

<% if (resourceType === '3d-models') { %>
  <%
    const categoryModelCount = items && items.length ? items.length : 0;
    const categoryLabel = category.name || 'apparel';
    const categoryLower = categoryLabel.toLowerCase();
    const categoryCatalogSteps = [
      { title: 'Choose a model', body: 'Pick the garment that fits your idea.' },
      { title: 'Inspect & customize', body: 'Rotate, zoom, and explore details and settings.' },
      { title: 'Open in workspace', body: 'Launch the 3D mockup workspace and start designing.' }
    ];
    const categoryToolMap = {
      't-shirt-mockup': [
        ['/tools/t-shirt-mockup-generator', 'Free T-shirt mockup generator'],
        ['/tools/oversized-t-shirt-mockup-generator', 'Oversized T-shirt mockups'],
        ['/tools/front-and-back-t-shirt-mockup', 'Front and back T-shirt views'],
        ['/tools/polo-shirt-mockup-generator', 'Polo shirt mockups'],
        ['/tools/long-sleeve-shirt-mockup-generator', 'Long-sleeve shirt mockups']
      ],
      'hoodie-mockup': [
        ['/tools/hoodie-mockup-generator', 'Free hoodie mockup generator'],
        ['/tools/streetwear-hoodie-mockup-generator', 'Streetwear hoodie mockups'],
        ['/tools/print-on-demand-mockup-generator', 'POD apparel mockups']
      ],
      'dress': [
        ['/tools/dress-designer', 'Free online dress designer'],
        ['/tools/3d-clothing-mockup-generator', '3D clothing design tool'],
        ['/tools/transparent-apparel-mockup-generator', 'Transparent dress mockups']
      ],
      'jacket': [
        ['/tools/3d-clothing-mockup-generator', 'Free jacket 3D model editor'],
        ['/tools/transparent-apparel-mockup-generator', 'Transparent jacket mockups'],
        ['/mockups/coat', 'Coat and outerwear 3D models']
      ],
      'pants': [
        ['/tools/3d-clothing-mockup-generator', 'Free 3D pants design tool'],
        ['/tools/transparent-apparel-mockup-generator', 'Transparent pants mockups'],
        ['/mockups/top', 'Pair with free 3D top models']
      ],
      'shirt': [
        ['/tools/3d-clothing-mockup-generator', 'Free shirt 3D model editor'],
        ['/tools/transparent-apparel-mockup-generator', 'Transparent shirt mockups'],
        ['/tools/long-sleeve-shirt-mockup-generator', 'Long-sleeve shirt mockups']
      ]
    };
    const categoryToolLinks = categoryToolMap[category.slug] || [
      ['/tools/3d-clothing-mockup-generator', `Free ${categoryLabel} 3D mockups`],
      ['/tools/transparent-apparel-mockup-generator', 'Transparent apparel PNGs']
    ];
    const categoryGuideMap = {
      't-shirt-mockup': [
        ['/blog/how-to-make-realistic-t-shirt-mockups', 'How to make realistic T-shirt mockups'],
        ['/blog/t-shirt-print-placement-size-guide', 'T-shirt print placement and size guide'],
        ['/blog/front-and-back-t-shirt-mockup-guide', 'Front and back T-shirt mockup guide']
      ],
      'dress': [
        ['/blog/how-to-design-a-dress-online-free', 'How to design a dress online for free'],
        ['/blog/plan-a-clothing-collection-online-free', 'Plan a clothing collection online'],
        ['/blog/3d-apparel-mockup-workflow', '3D apparel mockup workflow']
      ],
      'jacket': [
        ['/blog/3d-jacket-and-trench-coat-model-guide', '3D jacket and trench coat model guide'],
        ['/blog/make-apparel-mockups-match-the-real-product', 'Make mockups match the real product'],
        ['/blog/3d-vs-ai-vs-template-vs-product-photography', '3D mockups vs product photography']
      ],
      'pants': [
        ['/blog/3d-pants-design-and-mockup-guide', '3D pants design and mockup guide'],
        ['/blog/how-to-create-a-360-clothing-mockup', 'Create a 360° clothing mockup'],
        ['/blog/apparel-ecommerce-catalog-image-guide', 'Apparel ecommerce image guide']
      ]
    };
    const categoryGuideLinks = categoryGuideMap[category.slug] || [
      ['/blog/how-to-choose-a-3d-clothing-model', 'How to choose a 3D clothing model'],
      ['/blog/3d-apparel-mockup-workflow', '3D apparel mockup workflow'],
      ['/blog/apparel-ecommerce-catalog-image-guide', 'Apparel ecommerce image guide']
    ];
  %>
  <header class="category-catalog-header">
    <div class="category-catalog-shell">
      <span class="category-catalog-kicker">3D model library</span>
      <div class="category-catalog-heading">
        <h1><%= category.name %> 3D models</h1>
        <p>Choose a garment, inspect its shape, and open the browser-based 3D mockup workspace.</p>
        <span><%= categoryModelCount %> free <%= categoryModelCount === 1 ? 'model' : 'models' %></span>
      </div>
    </div>
  </header>

  <nav class="category-catalog-family" aria-label="Garment categories">
    <div class="category-catalog-family-shell">
      <button class="category-family-control category-family-control-prev" type="button" aria-label="Scroll categories left" disabled>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m10 3-5 5 5 5"/></svg>
      </button>
      <div class="category-catalog-family-viewport" tabindex="0">
        <div class="category-catalog-family-track">
          <a href="/mockups">
            <%- include('partials/category-icon', { slug: 'all', name: t('design3d.filterAll') }) %>
            <span><%= t('design3d.filterAll') %></span>
          </a>
          <% (categories || []).forEach(function(cat) { %>
            <a href="/mockups/<%= cat.slug %>" class="<%= cat.slug === category.slug ? 'active' : '' %>" <%= cat.slug === category.slug ? 'aria-current="page"' : '' %>>
              <%- include('partials/category-icon', { slug: cat.slug, name: cat.name }) %>
              <span><%= cat.name %></span>
            </a>
          <% }); %>
        </div>
      </div>
      <button class="category-family-control category-family-control-next" type="button" aria-label="Scroll categories right">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg>
      </button>
    </div>
  </nav>

  <section class="category-catalog-workspace">
    <div class="category-catalog-shell category-catalog-results">
        <div id="free-models" class="category-models-anchor" aria-hidden="true"></div>
        <div class="models-grid">
        <% if (items && items.length > 0) { %>
          <% items.forEach(function(model) { %>
            <% const modelDisplayName = String(model.name || '').replace(/\s+(?:3D\s+)?(?:Garment\s+)?Model$/i, ''); %>
            <a href="/3d-models/<%= category.slug %>/<%= model.slug %>" class="model-card" data-category="<%= category.slug %>">
              <div class="model-preview-3d">
                <% if (model.image_url) { %>
                  <img src="<%= model.image_url %>" alt="<%= model.name %> free <%= categoryLower %> 3D model and apparel mockup" class="model-img" loading="lazy">
                <% } else { %>
                  <div class="model-placeholder">
                    <span><%= model.name.charAt(0) %></span>
                  </div>
                <% } %>
              </div>
              <div class="model-info">
                <div>
                  <h3 class="model-name"><%= modelDisplayName %></h3>
                  <span class="category-model-status">Free</span>
                </div>
                <span class="category-model-action">Open model <span aria-hidden="true">›</span></span>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <div class="empty-state model-empty-state">
            <svg class="empty-state-illustration" width="120" height="96" viewBox="0 0 120 96" fill="none" aria-hidden="true">
              <rect x="24" y="18" width="72" height="58" rx="6" fill="#f5f5f5" stroke="#d4d4d4" stroke-width="2"/>
              <path d="M43 18c2.8 9.2 31.2 9.2 34 0" stroke="#d4d4d4" stroke-width="2" stroke-linecap="round"/>
              <path d="M24 31 13 43l13 13M96 31l11 12-11 13" stroke="#d4d4d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M43 52h34M49 62h22" stroke="#b8b8b8" stroke-width="2" stroke-linecap="round"/>
              <circle cx="91" cy="74" r="12" fill="#ffffff" stroke="#111111" stroke-width="2"/>
              <path d="m99 82 8 8" stroke="#111111" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
            <h3>No <%= category.name %> models yet</h3>
            <p>There are no active 3D models in this category right now.</p>
          </div>
        <% } %>
        </div>
    </div>
  </section>

  <section class="category-field-guide" id="category-field-guide">
    <div class="category-catalog-shell">
      <div class="category-field-guide-panel">
        <div class="category-field-guide-intro">
          <h2>From model to mockup</h2>
          <p>Open any 3D model and start creating realistic apparel mockups in minutes.</p>
        </div>
        <ol class="category-field-guide-steps">
          <% categoryCatalogSteps.forEach(function(step, index) { %>
            <li>
              <span><%= index + 1 %></span>
              <div>
                <h3><%= step.title %></h3>
                <p><%= step.body %></p>
              </div>
            </li>
          <% }); %>
        </ol>
        <nav class="category-field-guide-links" aria-label="Related resources">
          <a href="<%= categoryToolLinks[0][0] %>">Tools <span aria-hidden="true">›</span></a>
          <a href="<%= categoryGuideLinks[0][0] %>">Guides <span aria-hidden="true">›</span></a>
        </nav>
      </div>
    </div>
  </section>
  <script>
    (function () {
      var viewport = document.querySelector('.category-catalog-family-viewport');
      var previous = document.querySelector('.category-family-control-prev');
      var next = document.querySelector('.category-family-control-next');
      if (!viewport || !previous || !next) return;

      function updateControls() {
        var maximum = viewport.scrollWidth - viewport.clientWidth;
        previous.disabled = viewport.scrollLeft <= 2;
        next.disabled = viewport.scrollLeft >= maximum - 2 || maximum <= 2;
      }

      function move(direction) {
        viewport.scrollBy({ left: direction * Math.max(280, viewport.clientWidth * 0.72), behavior: 'smooth' });
      }

      previous.addEventListener('click', function () { move(-1); });
      next.addEventListener('click', function () { move(1); });
      viewport.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      updateControls();
    }());
  </script>
<% } else { %>
  <section class="category-hero">
    <div class="container">
      <div class="category-breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/<%= resourceType %>"><%= resourceTypeLabel %></a>
        <span>/</span>
        <span><%= category.name %></span>
      </div>
      <h1 class="category-title"><%= category.name %></h1>
      <% if (category.description) { %>
        <p class="category-description"><%= category.description %></p>
      <% } %>
    </div>
  </section>

  <section class="category-content">
    <div class="container">
      <% if (items && items.length > 0) { %>
        <div class="resource-grid">
          <% items.forEach(item => { %>
            <div class="resource-card">
              <div class="resource-image">
                <% if (item.image_url) { %>
                  <img src="<%= item.image_url %>" alt="<%= item.name || item.title %>">
                <% } else { %>
                  <div class="resource-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                <% } %>
              </div>
              <div class="resource-info">
                <h3 class="resource-name"><%= item.name || item.title %></h3>
                <% if (item.description) { %>
                  <p class="resource-desc"><%= item.description %></p>
                <% } %>
                <% if (item.tags) { %>
                  <div class="resource-tags">
                    <% item.tags.split(',').forEach(tag => { %>
                      <span class="tag"><%= tag.trim() %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          <h3>No items yet</h3>
          <p>Check back soon for new <%= category.name.toLowerCase() %>.</p>
        </div>
      <% } %>
    </div>
  </section>
  <% if (landingContent) { %>
    <%- include('partials/generator-sections', { landingContent, categories, items, resourceType }) %>
  <% } %>
<% } %>

<style>
.model-empty-state {
  grid-column: 1 / -1;
  width: min(520px, 100%);
  margin: var(--spacing-xl) auto;
  padding: var(--spacing-3xl) var(--spacing-xl);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background-color: var(--color-white);
}

.empty-state-illustration {
  margin-bottom: var(--spacing-lg);
}

.model-empty-state h3 {
  margin-bottom: var(--spacing-sm);
  color: var(--color-primary);
  font-size: 20px;
  font-weight: 600;
}

.model-empty-state p {
  color: var(--color-secondary);
  font-size: 14px;
}

.category-hero {
  background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
  padding: 3rem 0 2rem;
  border-bottom: 1px solid var(--gray-200);
}

.category-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--gray-900);
  margin-bottom: 0.75rem;
}

.category-description {
  font-size: 1.125rem;
  color: var(--gray-600);
  max-width: 600px;
  line-height: 1.6;
}

.category-content {
  padding: 3rem 0;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
}

.resource-card {
  background: var(--white);
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--gray-200);
  transition: box-shadow 0.2s, transform 0.2s;
}

.resource-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}

.resource-image {
  aspect-ratio: 4/3;
  background: var(--gray-100);
  overflow: hidden;
}

.resource-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.resource-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400);
}

.resource-info {
  padding: 1.25rem;
}

.resource-name {
  font-size: 1rem;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 0.5rem;
}

.resource-desc {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.5;
  margin-bottom: 0.75rem;
}

.resource-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tag {
  font-size: 0.75rem;
  padding: 0.25rem 0.625rem;
  background: var(--gray-100);
  color: var(--gray-600);
  border-radius: 9999px;
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  color: var(--gray-400);
}

.empty-state h3 {
  color: var(--gray-600);
  margin: 1rem 0 0.5rem;
}

.empty-state p {
  color: var(--gray-500);
}
</style>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title"><%= t('design2d.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('design2d.pageSubtitle') %></p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <!-- Filters -->
    <div class="filters-bar">
      <div class="filter-group">
        <button class="filter-btn active" data-filter="all"><%= t('design2d.filterAll') %></button>
        <button class="filter-btn" data-filter="tops"><%= t('design2d.filterTops') %></button>
        <button class="filter-btn" data-filter="bottoms"><%= t('design2d.filterBottoms') %></button>
        <button class="filter-btn" data-filter="dresses"><%= t('design2d.filterDresses') %></button>
        <button class="filter-btn" data-filter="outerwear"><%= t('design2d.filterOuterwear') %></button>
        <button class="filter-btn" data-filter="accessories"><%= t('design2d.filterAccessories') %></button>
      </div>
      <div class="sort-group">
        <select class="sort-select">
          <option value="popular"><%= t('design2d.sortPopular') %></option>
          <option value="newest"><%= t('design2d.sortNewest') %></option>
          <option value="name"><%= t('design2d.sortName') %></option>
        </select>
      </div>
    </div>

    <!-- 2D Templates Grid -->
    <div class="models-grid">
      <!-- T-Shirt -->
      <div class="model-card" data-category="tops">
        <div class="model-preview-3d">
          <div class="model-thumbnail">
            <svg viewBox="0 0 200 200" class="model-svg">
              <rect x="40" y="40" width="120" height="120" rx="4" fill="#f5f5f5" stroke="#999" stroke-width="1"/>
              <path d="M40 70H160" stroke="#999" stroke-width="1" stroke-dasharray="4"/>
              <path d="M70 40V160" stroke="#999" stroke-width="1" stroke-dasharray="4"/>
              <text x="100" y="110" text-anchor="middle" fill="#999" font-size="12">T-Shirt</text>
              <text x="100" y="125" text-anchor="middle" fill="#bbb" font-size="10">Front View</text>
            </svg>
          </div>
          <div class="model-actions-overlay">
            <a href="/designer/2d/t-shirt" class="btn btn-primary btn-small"><%= t('design2d.designNow') %></a>
          </div>
        </div>
        <div class="model-info">
          <h3 class="model-name"><%= t('design2d.tShirt') %></h3>
          <p class="model-meta">Front & Back • AI Vector</p>
          <div class="model-tags">
            <span class="tag">Free</span>
            <span class="tag">SVG</span>
          </div>
        </div>
      </div>

      <!-- Hoodie -->

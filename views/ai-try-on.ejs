<%- include('partials/header', { pageStyles: ['/css/ai-try-on.css?v=20260926-compact-no-names-v10'] }) %>

<%
const tryOnModels = personModels;
const currentModelFile = model.preview_file_url || model.file_url || '';
const detailHref = `/3d-models/${categorySlug}/${model.slug}`;
%>

<section
  class="ai-tryon"
  id="aiTryOnApp"
  data-credit-cost="<%= tryOnCreditCost %>"
  data-model-name="<%= model.name %>"
  data-model-id="<%= model.id || '' %>"
  data-model-slug="<%= model.slug || '' %>"
  data-garment-fallback="<%= model.image_url || '' %>"
  data-texture-template-url="<%= model.texture_url || '' %>"
>
  <header class="ai-tryon__bar">
    <div class="ai-tryon__crumbs" aria-label="Breadcrumb">
      <strong>AI Try-on</strong>
    </div>

    <div class="ai-tryon__status" role="status">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
      <span>Design ready</span>
    </div>

    <div class="ai-tryon__actions">

      <a class="ai-tryon__close" href="<%= detailHref %>" aria-label="Close AI try-on">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </a>
    </div>
  </header>

  <div class="ai-tryon__workspace">
    <section class="tryon-result" aria-labelledby="tryonResultTitle">
      <h1 class="sr-only" id="tryonResultTitle">AI try-on preview</h1>
      <img
        class="tryon-result__image"
        id="tryOnResultImage"
        src="<%= tryOnModels[0].image %>"
        alt="<%= tryOnModels[0].name %>, selected model for AI try-on"
        data-fit="contain"
      >

      <div class="tryon-result__toggle" role="group" aria-label="Preview state">
        <button type="button" class="is-active" data-preview-state="before">Original</button>
        <button type="button" data-preview-state="after" data-after-result hidden>Try-on</button>
      </div>

      <span class="tryon-result__ai-label" data-after-result hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2l1.6 4.4L18 8l-4.4 1.6L12 14l-1.6-4.4L6 8l4.4-1.6L12 2Zm7 12 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14Z"/></svg>
        AI generated
      </span>

      <div class="tryon-result__loading" id="tryOnLoading" hidden>
        <span class="tryon-result__spinner" aria-hidden="true"></span>
        <strong>Creating your try-on</strong>
      </div>

      <div class="tryon-result__zoom" role="group" aria-label="Preview zoom">
        <button type="button" id="tryOnZoomOut" aria-label="Zoom out">−</button>
        <button type="button" id="tryOnZoomReset" aria-label="Reset zoom to fit image"><output id="tryOnZoomValue" aria-live="polite">100%</output></button>
        <button type="button" id="tryOnZoomIn" aria-label="Zoom in">+</button>
      </div>
      <button type="button" id="downloadTryOn" disabled aria-disabled="true" class="tryon-result__download" data-after-result hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14"/></svg>
        <span>Download</span>
      </button>
    </section>

    <aside class="tryon-flow" aria-label="AI try-on steps">
      <section class="tryon-step tryon-step--design">
        <div class="tryon-step__title">
          <div>
            <h2>Your design</h2>
            <p><%= model.name %></p>
          </div>
        </div>

        <button type="button" class="tryon-design-preview" id="openTryOnPreview" disabled><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>Preview</button>
        <div class="tryon-angles" aria-label="Garment views" aria-busy="true">
          <% ['Front', 'Side', 'Back'].forEach((angle, index) => { %>
            <button type="button" class="tryon-angle" data-garment-angle="<%= index * 90 %>" disabled>
              <span class="tryon-angle__image"><img alt="<%= angle %> view of <%= model.name %>" hidden><span class="tryon-angle__status">Loading…</span></span>
              <span><%= angle %></span>
            </button>
          <% }); %>
        </div>
        <div class="tryon-viewer" id="tryOnViewerPanel" inert aria-hidden="true">
          <button type="button" id="closeTryOnPreview" aria-label="Close garment preview">×</button>
          <% if (currentModelFile) { %>
            <model-viewer
              id="tryOnGarmentViewer"
              src="<%= currentModelFile %>"
              poster="<%= model.image_url || '' %>"
              alt="3D preview of <%= model.name %>"
              loading="eager"
              reveal="auto"
              camera-controls
              shadow-intensity="0.32"
              shadow-softness="0.9"
              exposure="0.82"
              environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
              data-camera-relative-studio-light="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
              data-studio-light-reference-azimuth="-16"
              data-studio-light-azimuth-offset="45"
              tone-mapping="commerce"
              camera-orbit="0deg 74deg 108%"
            ></model-viewer>
          <% } else { %>
            <img src="<%= model.image_url %>" alt="<%= model.name %>">
          <% } %>

          <div class="tryon-viewer__controls">
            <button type="button" id="resetTryOnViewer" aria-label="Reset 3D view">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 6v5h-5M4 18v-5h5M6.1 9A7 7 0 0 1 18.7 7.7L20 11M4 13l1.3 3.3A7 7 0 0 0 17.9 15"/></svg>
            </button>
            <button type="button" id="fullscreenTryOnViewer" aria-label="View 3D design fullscreen">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/></svg>
            </button>
          </div>

          <span class="tryon-viewer__hint">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 11V7a2 2 0 0 1 4 0v4-6a2 2 0 0 1 4 0v6-4a2 2 0 0 1 4 0v7c0 4-3 7-7 7h-1c-2 0-3.4-.8-4.6-2.3L3.8 14a2 2 0 0 1 3-2.6L8 13"/></svg>
            Drag to rotate
          </span>
        </div>
      </section>

      <section class="tryon-step tryon-step--models">
        <div class="tryon-step__heading-row">
          <div class="tryon-step__title">

            <div><h2>Choose a model</h2></div>
          </div>
          <button type="button" class="tryon-upload" id="tryOnUploadButton"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5"/></svg>Upload photo</button>
        </div>

        <div class="tryon-filters">
          <div class="tryon-filter-tabs" role="group" aria-label="Model collection">
            <button type="button" data-model-filter="" aria-pressed="true">All</button>
            <button type="button" data-model-filter="Women" aria-pressed="false">Women</button>
            <button type="button" data-model-filter="Men" aria-pressed="false">Men</button>
          </div>
          <select id="tryOnStyleFilter" aria-label="Model style"><option value="">All styles</option><% [...new Set(tryOnModels.map(person => person.style))].forEach(style => { %><option value="<%= style %>"><%= style %></option><% }); %></select>
        </div>
        <p class="tryon-model-empty" id="tryOnModelEmpty" role="status" hidden>No models match these filters. Try another style or choose All.</p>
        <div class="model-picker" role="group" aria-label="Choose a model">
          <% tryOnModels.forEach(function(person, index) { %>
            <button
              class="model-card <%= index === 0 ? 'is-selected' : '' %>"
              type="button"
              aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
              data-model-card
              data-model-id="<%= person.id %>"
              data-model-style="<%= person.style %>"
              data-model-collection="<%= person.collection %>"
              data-model-name="<%= person.name %>"
              data-model-image="<%= person.image %>"
            >
              <span class="model-card__portrait"><img src="<%= person.thumbnail %>" alt="<%= person.name %>, full-body model" loading="<%= index > 5 ? 'lazy' : 'eager' %>"></span>
              <span class="model-card__check" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-9"/></svg>
              </span>
            </button>
          <% }); %>
        </div>
      </section>

      <div class="tryon-flow__generate">
        <div class="tryon-selection" aria-live="polite"><span class="tryon-selection__avatar"><img id="tryOnSelectedAvatar" src="<%= tryOnModels[0].thumbnail %>" alt=""></span></div>
        <input type="file" id="tryOnPhoto" accept="image/png,image/jpeg,image/webp" hidden>
        <button class="ai-button ai-button--primary ai-button--wide" type="button" data-generate>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2l1.6 4.4L18 8l-4.4 1.6L12 14l-1.6-4.4L6 8l4.4-1.6L12 2Zm7 12 .9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9L19 14Z"/></svg>
          <span>Generate try-on · <%= tryOnCreditCost %> credits</span>
        </button>
        <p id="tryOnTimeHint"></p>
      </div>
    </aside>
  </div>

  <div class="tryon-toast" id="tryOnToast" role="status" aria-live="polite" hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
    Try-on ready
  </div>
</section>

<script>
  window.ModelViewerElement = window.ModelViewerElement || {};
  window.ModelViewerElement.meshoptDecoderLocation = '/vendor/model-viewer/meshopt_decoder.js?v=three-0.183.0';
</script>
<script type="module" src="/vendor/model-viewer/model-viewer.min.js?v=4.3.1"></script>
<script src="/js/ai-try-on.js?v=20260926-compact-no-names-v10" defer></script>

<%- include('partials/footer') %>

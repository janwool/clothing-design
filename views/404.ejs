<%- include('partials/header') %>

<section class="error-section">
  <div class="container">
    <div class="error-content">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Page Not Found</h2>
      <p class="error-message">The page you are looking for does not exist or has been moved.</p>
      <a href="/" class="btn btn-primary">Go Home</a>
    </div>
  </div>
</section>

<style>
.error-section {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 4rem 0;
}

.error-code {
  font-size: 6rem;
  font-weight: 800;
  color: var(--gray-200);
  line-height: 1;
  margin-bottom: 1rem;
}

.error-title {
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 0.75rem;
}

.error-message {
  color: var(--gray-600);
  margin-bottom: 2rem;
}
</style>

<%- include('partials/footer') %>

<%- include('partials/header') %>
<% const previewModelFileUrl = model.file_url; %>
<% const aiTryOnAvailable = typeof aiTryOnEnabled !== 'undefined' && Boolean(aiTryOnEnabled); %>

<section class="designer-page">
  <div class="designer-toolbar">
    <div class="designer-toolbar-left">
      <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="btn btn-ghost btn-small">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back
      </a>
      <h1 class="designer-title"><%= model.name %></h1>
    </div>
    <div class="designer-toolbar-right">
      <span id="designerSaveStatus" role="status" aria-live="polite"></span>
      <% if (aiTryOnAvailable) { %><a class="btn btn-secondary btn-small" id="designerAiTryOn" href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>/try-on">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3l1.55 4.45L18 9l-4.45 1.55L12 15l-1.55-4.45L6 9l4.45-1.55L12 3Z"/>
          <path d="M19 15l.8 2.2L22 18l-2.2.8L19 22l-.8-2.2L16 18l2.2-.8L19 15Z"/>
        </svg>
        AI Try-on
      </a><% } %>
      <button class="btn btn-secondary btn-small" id="resetBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
        Reset
      </button>
      <button class="btn btn-secondary btn-small" id="designerSaveBtn">Save Project</button>
      <button class="btn btn-primary btn-small" id="downloadBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        Download Render
      </button>
    </div>
  </div>

  <div class="designer-workspace">
    <!-- 3D Canvas -->
    <div class="designer-canvas" id="designerCanvas">
      <% if (previewModelFileUrl) { %>
        <model-viewer 
          class="model-viewer-natural"
          id="designerViewer"
          src="<%= previewModelFileUrl %>" 
          alt="<%= model.name %>"
          camera-controls
          camera-orbit="-12deg 72deg 142%"
          camera-target="auto auto auto"
          field-of-view="28deg"
          shadow-intensity="0.32"
          shadow-softness="0.9"
          exposure="0.82"
          environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
          data-camera-relative-studio-light="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
          data-studio-light-reference-azimuth="-16"
          data-studio-light-azimuth-offset="45"
          tone-mapping="commerce"
          style="width: 100%; height: 100%;"
        ></model-viewer>
        <div class="model-viewer-spinner" id="designerViewerLoading" role="status" aria-live="polite">
          <i aria-hidden="true"></i>
          <span>Loading 3D</span>
        </div>
      <% } else { %>
        <div class="designer-placeholder">
          <img src="<%= model.image_url %>" alt="<%= model.name %>">
        </div>
      <% } %>
    </div>

    <!-- Sidebar Controls -->
    <div class="designer-sidebar">
      <div class="designer-panel">
        <h3 class="panel-title">Colors</h3>
        <div class="panel-content">
          <div class="control-group">
            <label>Base Color</label>
            <div class="color-options">
              <button class="color-btn active" style="background: #ffffff;" data-color="#ffffff" data-target="base"></button>
              <button class="color-btn" style="background: #1a1a1a;" data-color="#1a1a1a" data-target="base"></button>
              <button class="color-btn" style="background: #c41e3a;" data-color="#c41e3a" data-target="base"></button>
              <button class="color-btn" style="background: #1e3a8a;" data-color="#1e3a8a" data-target="base"></button>
              <button class="color-btn" style="background: #059669;" data-color="#059669" data-target="base"></button>
              <button class="color-btn" style="background: #d97706;" data-color="#d97706" data-target="base"></button>
              <button class="color-btn" style="background: #7c3aed;" data-color="#7c3aed" data-target="base"></button>
              <button class="color-btn" style="background: #db2777;" data-color="#db2777" data-target="base"></button>
            </div>
          </div>
          
          <div class="control-group">
            <label>Accent Color</label>
            <div class="color-options">
              <button class="color-btn active" style="background: #ffffff;" data-color="#ffffff" data-target="accent"></button>
              <button class="color-btn" style="background: #1a1a1a;" data-color="#1a1a1a" data-target="accent"></button>
              <button class="color-btn" style="background: #c41e3a;" data-color="#c41e3a" data-target="accent"></button>
              <button class="color-btn" style="background: #1e3a8a;" data-color="#1e3a8a" data-target="accent"></button>
              <button class="color-btn" style="background: #059669;" data-color="#059669" data-target="accent"></button>
              <button class="color-btn" style="background: #d97706;" data-color="#d97706" data-target="accent"></button>
            </div>
          </div>
        </div>
      </div>

      <div class="designer-panel">
        <h3 class="panel-title">Patterns</h3>
        <div class="panel-content">
          <div class="control-group">
            <label>Pattern Style</label>
            <div class="pattern-options">
              <button class="pattern-btn active" data-pattern="none">None</button>
              <button class="pattern-btn" data-pattern="striped">Striped</button>
              <button class="pattern-btn" data-pattern="checkered">Checkered</button>
              <button class="pattern-btn" data-pattern="dots">Dots</button>
              <button class="pattern-btn" data-pattern="camo">Camo</button>
            </div>
          </div>
        </div>
      </div>

      <div class="designer-panel">
        <h3 class="panel-title">Material</h3>
        <div class="panel-content">
          <div class="control-group">
            <label>Roughness</label>
            <input type="range" class="range-slider" id="roughnessSlider" min="0" max="1" step="0.1" value="0.6">
          </div>
          <div class="control-group">
            <label>Metalness</label>
            <input type="range" class="range-slider" id="metalnessSlider" min="0" max="1" step="0.1" value="0">
          </div>
        </div>
      </div>

      <div class="designer-panel">
        <h3 class="panel-title">View</h3>
        <div class="panel-content">
          <div class="control-group">
            <label>Environment</label>
            <div class="pattern-options">
              <button class="pattern-btn" data-env="neutral">Neutral</button>
              <button class="pattern-btn active" data-env="studio">Studio</button>
              <button class="pattern-btn" data-env="outdoor">Outdoor</button>
            </div>
          </div>
          <div class="control-group">
            <label class="checkbox-label">
              <input type="checkbox" id="autoRotateCheck">
              <span>Auto Rotate</span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  window.ModelViewerElement = window.ModelViewerElement || {};
  window.ModelViewerElement.meshoptDecoderLocation = '/vendor/model-viewer/meshopt_decoder.js?v=three-0.183.0';
</script>
<script type="module" src="/vendor/model-viewer/model-viewer.min.js?v=4.3.1"></script>

<script>
// Designer functionality
const viewer = document.getElementById('designerViewer');
const designerViewerLoading = document.getElementById('designerViewerLoading');
const resetBtn = document.getElementById('resetBtn');
const downloadBtn = document.getElementById('downloadBtn');
const designerSaveBtn = document.getElementById('designerSaveBtn');
const designerSaveStatus = document.getElementById('designerSaveStatus');
const designerAiTryOn = document.getElementById('designerAiTryOn');
const designerProjectState = { id: '', name: '' };
const designerUserAuthenticated = <%- JSON.stringify(Boolean(user)) %>;
const tryOnDesignTransferKey = 'clozdesign_tryon_design_v1';
const commercialStudioEnvironment = '/environments/commercial-apparel-studio-v5-front-white-20260917.hdr';

function hexToRgba(hex) {
  const safe = /^#[0-9a-f]{6}$/i.test(String(hex || '')) ? hex.slice(1) : 'ffffff';
  const value = Number.parseInt(safe, 16);
  return [((value >> 16) & 255) / 255, ((value >> 8) & 255) / 255, (value & 255) / 255, 1];
}

function applyDesignerAppearance() {
  const materials = viewer?.model?.materials || [];
  if (!materials.length) return false;
  const design = getDesignerProjectData();
  materials.forEach((material, index) => {
    const pbr = material.pbrMetallicRoughness;
    pbr?.setBaseColorFactor?.(hexToRgba(index === 0 ? design.baseColor : design.accentColor));
    pbr?.setRoughnessFactor?.(design.roughness);
    pbr?.setMetallicFactor?.(design.metalness);
  });
  viewer.requestUpdate?.();
  return true;
}

function syncDesignerTryOnLink(projectId = designerProjectState.id || new URLSearchParams(window.location.search).get('project')) {
  if (!designerAiTryOn) return;
  const destination = new URL(designerAiTryOn.href, window.location.origin);
  if (/^[a-f0-9-]{36}$/i.test(String(projectId || ''))) destination.searchParams.set('project', projectId);
  else destination.searchParams.delete('project');
  designerAiTryOn.href = `${destination.pathname}${destination.search}`;
}

function persistDesignerTryOnDesign() {
  try {
    sessionStorage.setItem(tryOnDesignTransferKey, JSON.stringify({
      modelId: <%- JSON.stringify(String(model.id || '')) %>,
      modelSlug: <%- JSON.stringify(String(model.slug || '')) %>,
      projectId: designerProjectState.id,
      appearance: getDesignerProjectData(),
      createdAt: Date.now()
    }));
    if (designerAiTryOn) designerAiTryOn.dataset.designTransfer = 'ready';
  } catch (error) {
    if (designerAiTryOn) designerAiTryOn.dataset.designTransfer = 'failed';
    console.warn('Could not prepare the current 3D design for Try-on:', error);
  }
  syncDesignerTryOnLink();
}

if (viewer && designerViewerLoading) {
  const finishViewerLoading = () => {
    designerViewerLoading.hidden = true;
    applyDesignerAppearance();
    persistDesignerTryOnDesign();
  };
  if (viewer.loaded) finishViewerLoading();
  else {
    viewer.addEventListener('load', finishViewerLoading, { once: true });
    viewer.addEventListener('error', finishViewerLoading, { once: true });
  }
}

// Color picker
const colorBtns = document.querySelectorAll('.color-btn');
colorBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const target = btn.dataset.target;
    document.querySelectorAll(`.color-btn[data-target="${target}"]`).forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    
    applyDesignerAppearance();
  });
});

// Pattern picker
const patternBtns = document.querySelectorAll('.pattern-btn[data-pattern]');
patternBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pattern-btn[data-pattern]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    persistDesignerTryOnDesign();
  });
});

// Environment picker
const envBtns = document.querySelectorAll('.pattern-btn[data-env]');
envBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pattern-btn[data-env]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    if (viewer) {
      viewer.environmentImage = btn.dataset.env === 'studio'
        ? commercialStudioEnvironment
        : (btn.dataset.env === 'neutral' ? 'neutral' : '/environments/commercial-apparel-studio-v3-omnidirectional-20260829.hdr');
    }
    persistDesignerTryOnDesign();
  });
});

// Auto rotate toggle
const autoRotateCheck = document.getElementById('autoRotateCheck');
if (autoRotateCheck && viewer) {
  autoRotateCheck.addEventListener('change', () => {
    viewer.autoRotate = autoRotateCheck.checked;
    persistDesignerTryOnDesign();
  });
}

document.getElementById('roughnessSlider')?.addEventListener('input', () => {
  applyDesignerAppearance();
  persistDesignerTryOnDesign();
});
document.getElementById('metalnessSlider')?.addEventListener('input', () => {
  applyDesignerAppearance();
  persistDesignerTryOnDesign();
});
designerAiTryOn?.addEventListener('click', persistDesignerTryOnDesign);
persistDesignerTryOnDesign();

// Reset button
if (resetBtn) {
  resetBtn.addEventListener('click', () => {
    // Reset colors
    document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.color-btn[data-color="#ffffff"]').forEach(b => b.classList.add('active'));
    
    // Reset patterns
    document.querySelectorAll('.pattern-btn[data-pattern]').forEach(b => b.classList.remove('active'));
    document.querySelector('.pattern-btn[data-pattern="none"]').classList.add('active');
    
    // Reset environment
    document.querySelectorAll('.pattern-btn[data-env]').forEach(b => b.classList.remove('active'));
    document.querySelector('.pattern-btn[data-env="studio"]').classList.add('active');
    
    // Reset sliders
    document.getElementById('roughnessSlider').value = 0.6;
    document.getElementById('metalnessSlider').value = 0;
    
    // Reset viewer
    if (viewer) {
      viewer.environmentImage = commercialStudioEnvironment;
      viewer.autoRotate = false;
      viewer.cameraOrbit = '-12deg 72deg 142%';
      viewer.shadowIntensity = 0.32;
      viewer.shadowSoftness = 0.9;
      viewer.exposure = 0.7;
    }
    applyDesignerAppearance();
    persistDesignerTryOnDesign();
  });
}

function getDesignerProjectData() {
  return {
    baseColor: document.querySelector('.color-btn[data-target="base"].active')?.dataset.color || '#ffffff',
    accentColor: document.querySelector('.color-btn[data-target="accent"].active')?.dataset.color || '#ffffff',
    pattern: document.querySelector('.pattern-btn[data-pattern].active')?.dataset.pattern || 'none',
    environment: document.querySelector('.pattern-btn[data-env].active')?.dataset.env || 'studio',
    roughness: Number(document.getElementById('roughnessSlider').value),
    metalness: Number(document.getElementById('metalnessSlider').value),
    autoRotate: Boolean(autoRotateCheck?.checked)
  };
}

async function saveDesignerProject() {
  if (!designerUserAuthenticated) {
    window.UserProjects?.goToSignIn();
    return;
  }
  if (!viewer || !window.UserProjects) return;
  designerSaveBtn.disabled = true;
  designerSaveStatus.textContent = 'Saving…';
  try {
    const projectData = {
      projectType: '3d',
      name: designerProjectState.name || <%- JSON.stringify(`${model.name || 'Garment'} Design`) %>,
      sourceId: <%- JSON.stringify(String(model.id || model.slug || '')) %>,
      sourceUrl: window.location.pathname,
      designData: getDesignerProjectData()
    };
    if (!designerProjectState.id) {
      const reservedProject = await window.UserProjects.saveProject({ ...projectData, previewImageUrl: '' });
      designerProjectState.id = reservedProject.id;
      designerProjectState.name = reservedProject.name;
      const reservedUrl = new URL(window.location.href);
      reservedUrl.searchParams.set('project', reservedProject.id);
      window.history.replaceState({}, '', reservedUrl);
    }
    const previewDataUrl = viewer.toDataURL('image/jpeg', 0.86);
    const preview = await window.UserProjects.uploadImage(previewDataUrl, '<%= model.slug %>-preview.jpg', 'project-preview', designerProjectState.id);
    const project = await window.UserProjects.saveProject({
      ...projectData,
      id: designerProjectState.id,
      previewImageUrl: preview.url
    });
    designerProjectState.id = project.id;
    designerProjectState.name = project.name;
    const url = new URL(window.location.href);
    url.searchParams.set('project', project.id);
    window.history.replaceState({}, '', url);
    persistDesignerTryOnDesign();
    syncDesignerTryOnLink(project.id);
    designerSaveStatus.textContent = 'Saved';
  } catch (error) {
    console.error(error);
    if (error.status === 401) window.UserProjects.goToSignIn();
    else designerSaveStatus.textContent = error.message || 'Save failed';
  } finally {
    designerSaveBtn.disabled = false;
  }
}

async function loadDesignerProject() {
  if (!window.UserProjects) return;
  try {
    const project = await window.UserProjects.loadProjectFromUrl('3d');
    if (!project) return;
    const saved = project.designData || {};
    const activate = (selector) => document.querySelector(selector)?.click();
    activate(`.color-btn[data-target="base"][data-color="${saved.baseColor}"]`);
    activate(`.color-btn[data-target="accent"][data-color="${saved.accentColor}"]`);
    activate(`.pattern-btn[data-pattern="${saved.pattern}"]`);
    activate(`.pattern-btn[data-env="${saved.environment}"]`);
    document.getElementById('roughnessSlider').value = Number(saved.roughness) || 0;
    document.getElementById('metalnessSlider').value = Number(saved.metalness) || 0;
    autoRotateCheck.checked = saved.autoRotate === true;
    if (viewer) viewer.autoRotate = autoRotateCheck.checked;
    designerProjectState.id = project.id;
    designerProjectState.name = project.name;
    applyDesignerAppearance();
    persistDesignerTryOnDesign();
    syncDesignerTryOnLink(project.id);
    designerSaveStatus.textContent = 'Saved project loaded';
  } catch (error) {
    console.error(error);
    designerSaveStatus.textContent = error.status === 401 ? 'Sign in to open this project' : 'Project could not be loaded';
  }
}

designerSaveBtn?.addEventListener('click', saveDesignerProject);
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadDesignerProject, { once: true });
else loadDesignerProject();

// Download render
if (downloadBtn) {
  downloadBtn.addEventListener('click', async () => {
    if (viewer && viewer.toDataURL) {
      downloadBtn.disabled = true;
      try {
        const source = viewer.toDataURL('image/png');
        const exportUrl = window.ExportEntitlements
          ? await window.ExportEntitlements.prepareExport(source)
          : source;
        const link = document.createElement('a');
        link.download = '<%= model.slug %>-design.png';
        link.href = exportUrl;
        link.click();
      } catch (error) {
        console.error(error);
        alert('Render download could not be prepared.');
      } finally {
        downloadBtn.disabled = false;
      }
    } else {
      alert('Render download is not available for this model.');
    }
  });
}
</script>

<%- include('partials/footer') %>

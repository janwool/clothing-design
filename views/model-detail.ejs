          <path d="M20 6L9 17l-5-5"/>
        </svg>
        <span id="designSaveStatusText">Ready</span>
      </div>
      <div class="design-view-switcher" id="designViewSwitcher" role="group" aria-label="Editor view">
        <button type="button" class="active" data-design-view="2d" aria-pressed="true">2D</button>
        <button type="button" data-design-view="3d" aria-pressed="false">3D</button>
        <button type="button" data-design-view="split" aria-pressed="false">Split</button>
      </div>
      <div class="design-modal-actions">
        <button class="btn btn-primary btn-small" id="saveDesignModal" type="button">
          <span class="apply-label-desktop">Apply design</span>
          <span class="apply-label-mobile">Apply</span>
        </button>
        <button class="design-modal-close" id="designModalClose" type="button" aria-label="Close Design Studio">

              </svg>
              <span>Shape</span>
            </button>
          </div>
        </div>

        <!-- Contextual artwork library -->
        <section class="image-asset-tray" id="imageAssetTray" aria-label="Image assets" hidden>
          <div class="image-asset-header">
            <h3>Images</h3>
          </div>
          <button class="image-asset-card image-asset-upload" id="imageAssetUpload" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 16V4m0 0L8 8m4-4 4 4"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/>
            </svg>
            <span>Upload image</span>
          </button>
          <strong class="image-asset-library-title">Library</strong>
          <div class="image-asset-viewport" id="imageAssetViewport" tabindex="0">
            <div class="image-asset-track" id="imageAssetTrack">
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/botanical-line.svg" aria-label="Add botanical line art"><img src="/editor-assets/botanical-line.svg" alt="Botanical line art"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/butterfly.svg" aria-label="Add butterfly"><img src="/editor-assets/butterfly.svg" alt="Purple butterfly"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/mountain-wash.svg" aria-label="Add watercolor mountains"><img src="/editor-assets/mountain-wash.svg" alt="Blue watercolor mountains"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/lavender-cloud.svg" aria-label="Add watercolor cloud"><img src="/editor-assets/lavender-cloud.svg" alt="Lavender watercolor cloud"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/ocean-wave.svg" aria-label="Add ocean wave"><img src="/editor-assets/ocean-wave.svg" alt="Blue ocean wave"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/soft-gradient.svg" aria-label="Add gradient texture"><img src="/editor-assets/soft-gradient.svg" alt="Blue and purple gradient"></button>
              <button class="image-asset-card" type="button" data-asset-url="/editor-assets/delicate-branch.svg" aria-label="Add delicate branch"><img src="/editor-assets/delicate-branch.svg" alt="Blue delicate branch"></button>
            </div>
          </div>
          <div class="image-asset-actions">
            <button id="imageAssetFilter" type="button" aria-label="Filter images" aria-pressed="false">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16l-6 7v5l-4 2v-7Z"/></svg>
            </button>
            <button id="imageAssetClose" type="button" aria-label="Close image list">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="image-asset-progress" aria-hidden="true"><span id="imageAssetProgress"></span></div>
          <input id="imageAssetUploadInput" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" multiple hidden>
        </section>

        <!-- Main Texture Design Area -->
        <div class="texture-canvas-area">
          <div class="texture-canvas-frame" id="textureCanvasFrame">
            <svg id="textureSvg" xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">
              <defs>
                <pattern id="patternStriped" patternUnits="userSpaceOnUse" width="20" height="20">
                  <rect width="20" height="10" fill="currentColor" opacity="0.3"/>
                </pattern>
                <pattern id="patternCheckered" patternUnits="userSpaceOnUse" width="20" height="20">
                  <rect width="10" height="10" fill="currentColor" opacity="0.3"/>
                  <rect x="10" y="10" width="10" height="10" fill="currentColor" opacity="0.3"/>
                </pattern>
                <pattern id="patternDots" patternUnits="userSpaceOnUse" width="20" height="20">
                  <circle cx="10" cy="10" r="3" fill="currentColor" opacity="0.3"/>
                </pattern>
              </defs>
                  <rect id="textureWhiteBase" fill="transparent" width="1024" height="1024"/>
              <!-- Model SVG Texture Background -->
              <% if (model.texture_url) { %>
                <image id="textureBg" href="<%= model.texture_url %>" width="1024" height="1024" preserveAspectRatio="none"/>
                <g id="textureTemplateLayer"></g>
              <% } else { %>
                <rect id="textureBg" width="1024" height="1024" fill="transparent"/>
                <text id="textureBgText" text-anchor="middle" fill="#adb5bd" font-size="18" font-family="Arial, sans-serif">No texture available for this model</text>
              <% } %>
              <rect id="texturePattern" width="1024" height="1024" fill="none"/>
              <g id="textureElements"></g>
              <g id="selectionLayer" class="editor-ui"></g>
            </svg>
          </div>
          <div class="canvas-zoom-controls" aria-label="Canvas view controls">
            <button id="canvasRotate" type="button" aria-label="Rotate canvas clockwise. Current rotation: 0 degrees" title="Rotate canvas 90° clockwise">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 11a8 8 0 1 0-2.34 5.66"/>
                <path d="M20 4v7h-7"/>
              </svg>
            </button>
            <span class="canvas-zoom-divider" aria-hidden="true"></span>
            <button id="canvasZoomOut" type="button" aria-label="Zoom out">−</button>
            <span id="canvasZoomLabel">100%</span>
            <button id="canvasZoomIn" type="button" aria-label="Zoom in">+</button>
            <span class="canvas-zoom-divider" aria-hidden="true"></span>
            <button id="canvasZoomFit" type="button" aria-label="Fit canvas">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Live 3D preview -->
        <div class="preview-3d-panel">
          <section class="design-inspector-card design-preview-card">
            <div class="preview-model-stage">
              <% if (previewModelFileUrl) { %>
                <model-viewer
                  class="model-viewer-natural"
                  id="designerViewer"
                  data-model-src="<%= previewModelFileUrl %>"
                  poster="<%= model.image_url %>"
                  alt="<%= model.name %>"
                  loading="lazy"
                  camera-controls
                  disable-tap
                  camera-orbit="0deg 72deg 158%"
                  camera-target="auto auto auto"
                  field-of-view="28deg"
                  shadow-intensity="0.32"
                  shadow-softness="0.9"
                  exposure="2"
                  environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
                  data-camera-relative-studio-light="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
                  data-studio-light-reference-azimuth="-16"
                  data-studio-light-azimuth-offset="45"
                  tone-mapping="commerce"
                  data-entitlement-texture-watermark
                  style="width: 100%; height: 100%;"
                  hidden
                ></model-viewer>
                <div class="model-viewer-spinner" id="designPreviewLoading" role="status" aria-live="polite" hidden>
                  <i aria-hidden="true"></i>
                  <span>Loading 3D</span>
                </div>
              <% } else { %>
                <div class="designer-placeholder">
                  <img src="<%= model.image_url %>" alt="<%= model.name %>">
                </div>
              <% } %>
            </div>
            <p class="preview-rotate-hint">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M20 7v5h-5"/>
                <path d="M4 17v-5h5"/>
                <path d="M6.1 9A7 7 0 0118 6l2 1M17.9 15A7 7 0 016 18l-2-1"/>
              </svg>
              Drag to rotate
            </p>
          </section>
        </div>

        <!-- Garment appearance and material inspector -->
        <aside class="design-appearance-panel" id="designAppearancePanel" aria-label="Garment appearance">
          <section class="design-appearance-card">
            <div class="appearance-panel-header">
              <h3>Appearance</h3>
              <button id="appearancePanelCollapse" type="button" aria-label="Collapse appearance panel">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              </button>
            </div>
            <div class="appearance-scope-switch" role="group" aria-label="Color scope">
              <button type="button" class="active" data-fill-scope="whole" aria-pressed="true">Whole garment</button>
              <button type="button" data-fill-scope="panel" aria-pressed="false">Panel</button>
            </div>
            <div class="appearance-section">
              <strong>Fill</strong>
              <div class="appearance-fill-switch" role="group" aria-label="Fill type">
                <button type="button" data-fill-mode="solid" aria-pressed="false">Solid</button>
                <button type="button" class="active" data-fill-mode="gradient" aria-pressed="true">Gradient</button>
              </div>
              <div class="appearance-gradient-preview" id="appearanceGradientPreview"></div>
              <div class="appearance-color-stops">
                <label><span>Start</span><input id="appearanceColorStart" type="color" value="#5f89f4"></label>
                <label><span>End</span><input id="appearanceColorEnd" type="color" value="#c39bea"></label>
              </div>
              <label class="appearance-angle-control">
                <span>Angle</span>
                <input id="appearanceGradientAngle" type="range" min="0" max="360" value="135">
                <output id="appearanceGradientAngleOutput">135°</output>
              </label>
            </div>
          </section>
          <section class="material-panel" aria-label="Material presets">
            <div class="material-panel-header">
              <div>
                <h3>Material</h3>
              </div>
              <span class="material-panel-count" id="materialCount">0</span>
            </div>
            <div class="material-swatch-grid" id="materialSwatchGrid"></div>
          </section>
        </aside>
      </div>
    </div>
  </div>
</div>

<script>
// Viewer controls
const rotateBtn = document.getElementById('rotateBtn');
const fabricMotionBtn = document.getElementById('fabricMotionBtn');
const zoomBtn = document.getElementById('zoomBtn');
const viewer = document.querySelector('#model3dViewer model-viewer');
const modelViewerStage = document.getElementById('model3dViewer');
const modelInfoSection = document.querySelector('.model-info-section');
const modelViewerSection = document.querySelector('.model-viewer-section');
const heroSection = document.querySelector('.model-detail-hero');
const backgroundBtn = document.getElementById('backgroundBtn');
const heroBackgroundPopover = document.getElementById('heroBackgroundPopover');
const heroBackgroundPresets = [...document.querySelectorAll('[data-hero-background]')];
const heroGradientFrom = document.getElementById('heroGradientFrom');
const heroGradientTo = document.getElementById('heroGradientTo');
const heroGradientAngle = document.getElementById('heroGradientAngle');
const heroGradientAngleValue = document.getElementById('heroGradientAngleValue');
const applyHeroGradient = document.getElementById('applyHeroGradient');
const quickLightExposure = document.getElementById('quickLightExposure');
const quickLightExposureOutput = document.getElementById('quickLightExposureOutput');
const quickLightSoftness = document.getElementById('quickLightSoftness');
const quickLightSoftnessOutput = document.getElementById('quickLightSoftnessOutput');
const quickLightPresetButtons = [...document.querySelectorAll('[data-light-angle]')];
const modelViewerPromises = new WeakMap();
const defaultDetailRenderStandard = {
  version: 'commercial-studio-stage-v3',
  camera: {
    webOrbit: '0deg 72deg 142%',
    webEditorOrbit: '0deg 72deg 158%',
    webFieldOfView: '28deg',
    webTarget: 'auto auto auto'
  },
  material: {
    neutralizeBaseColor: false,
    baseColor: [0.96, 0.96, 0.95],
    roughness: 0.68,
    specularIorLevel: 0.32,
    sheenWeight: 0.32,
    normalStrengthMultiplier: 2.8,
    normalStrengthMax: 0.45
  },
  web: {
    environmentImage: '/environments/commercial-apparel-studio-v5-front-white-20260917.hdr',
    lightingMode: 'camera-relative-45deg-white-softbox',
    sourceEnvironment: '/environments/commercial-apparel-studio-v2-20260829.hdr',
    balanceMethod: 'camera-relative-azimuth',
    cameraRelativeLighting: true,
    lightReferenceAzimuthDeg: -16,
    lightAzimuthOffsetDeg: 45,
    lightColor: '#ffffff',
    environmentNeutralization: 'luminance-preserving-monochrome',
    shadowIntensity: 0.32,
    shadowSoftness: 0.9,
    exportShadowIntensity: 0.46,
    exportShadowSoftness: 0.88,
    exposure: 2,
    toneMapping: 'commerce',
    material: {
      neutralizeBaseColor: false,
      baseColor: [0.82, 0.82, 0.8],
      roughness: 0.62,
      specularIorLevel: 0.28,
      sheenWeight: 0.12
    }
  }
};
const detailLightState = {
  azimuthOffsetDeg: 45,
  exposure: 2,
  shadowSoftness: 0.9
};
window.ModelDetailLightingSettings = detailLightState;
let detailSceneStandard = defaultDetailRenderStandard;
const detailRenderStandardPromise = fetch('/config/design3d-render-standard.json?v=20260925-zero-azimuth-v1')
  .then((response) => response.ok ? response.json() : defaultDetailRenderStandard)
  .then((standard) => {
    detailSceneStandard = {
      ...defaultDetailRenderStandard,
      ...standard,
      camera: { ...defaultDetailRenderStandard.camera, ...(standard.camera || {}) },
      material: { ...defaultDetailRenderStandard.material, ...(standard.material || {}) },
      web: { ...defaultDetailRenderStandard.web, ...(standard.web || {}) }
    };
    const modelOverride = standard.modelOverrides?.[<%- JSON.stringify(String(model.id)) %>];
    if (modelOverride) {
      detailSceneStandard = {
        ...detailSceneStandard,
        ...modelOverride,
        camera: { ...detailSceneStandard.camera, ...(modelOverride.camera || {}) },
        web: { ...detailSceneStandard.web, ...(modelOverride.web || {}) }
      };
    }
    // Detail pages always start at 200%, including models with lighting overrides.
    detailSceneStandard.web.exposure = 2;
    Object.assign(detailLightState, {
      azimuthOffsetDeg: detailSceneStandard.web.lightAzimuthOffsetDeg,
      exposure: detailSceneStandard.web.exposure,
      shadowSoftness: detailSceneStandard.web.shadowSoftness
    });
    renderDetailLightingControls();
    return detailSceneStandard;
  })
  .catch(() => defaultDetailRenderStandard);
window.ModelDetailRenderStandardPromise = detailRenderStandardPromise;
let modelViewerModulePromise = null;
let fabricMotionEnabled = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
let fabricMotionResumeTimer = null;

function catalogOrbitForAzimuth(standard, azimuth) {
  const orbitParts = String(standard.camera?.webOrbit || defaultDetailRenderStandard.camera.webOrbit)
    .trim()
    .split(/\s+/);
  return `${azimuth} ${orbitParts[1] || '72deg'} ${orbitParts[2] || '142%'}`;
}

function applyCatalogRenderAttributes(element, standard = detailSceneStandard) {
  if (!element?.dataset.catalogRenderStandard) return;
  const webStandard = standard.web || defaultDetailRenderStandard.web;
  const isSideView = element.dataset.catalogRenderStandard === 'side';
  element.setAttribute('environment-image', webStandard.environmentImage || defaultDetailRenderStandard.web.environmentImage);
  if (webStandard.cameraRelativeLighting !== false) {
    element.dataset.cameraRelativeStudioLight = webStandard.environmentImage || defaultDetailRenderStandard.web.environmentImage;
    element.dataset.studioLightReferenceAzimuth = String(webStandard.lightReferenceAzimuthDeg ?? -16);
    element.dataset.studioLightAzimuthOffset = String(detailLightState.azimuthOffsetDeg ?? webStandard.lightAzimuthOffsetDeg ?? 0);
    window.CameraRelativeStudioLight?.install(element, {
      environmentImage: element.dataset.cameraRelativeStudioLight,
      referenceAzimuthDeg: Number(element.dataset.studioLightReferenceAzimuth),
      azimuthOffsetDeg: Number(element.dataset.studioLightAzimuthOffset)
    });
  }
  element.setAttribute('shadow-intensity', String(webStandard.shadowIntensity ?? 0.32));
  element.setAttribute('shadow-softness', String(detailLightState.shadowSoftness ?? webStandard.shadowSoftness ?? 0.9));
  element.setAttribute('exposure', String((detailLightState.exposure ?? webStandard.exposure ?? 2) * (Number(element.dataset.designExposureRatio) || 1)));
  element.setAttribute('tone-mapping', webStandard.toneMapping || 'commerce');
  element.setAttribute('camera-target', standard.camera?.webTarget || 'auto auto auto');
  element.setAttribute('field-of-view', standard.camera?.webFieldOfView || '28deg');
  element.setAttribute(
    'camera-orbit',
    isSideView
      ? catalogOrbitForAzimuth(standard, '90deg')
      : standard.camera?.webOrbit || defaultDetailRenderStandard.camera.webOrbit
  );
  element.autoRotate = false;
  element.removeAttribute('auto-rotate');
  element.dataset.catalogRenderVersion = standard.version || defaultDetailRenderStandard.version;
}

function applyCatalogMaterialResponse(element, standard = detailSceneStandard) {
  if (!element?.dataset.catalogRenderStandard || !element.model) return;
  if (standard.web?.preserveNativeMaterials) return;
  const materialStandard = standard.web?.material || standard.material || defaultDetailRenderStandard.web.material;
  const baseColor = Array.isArray(materialStandard.baseColor)
    ? materialStandard.baseColor.slice(0, 3).map((value) => Number(value))
    : defaultDetailRenderStandard.material.baseColor;
  const neutralFactor = [...baseColor, 1];

  (element.model.materials || []).forEach((material) => {
    const pbr = material.pbrMetallicRoughness;
    if (materialStandard.neutralizeBaseColor) pbr?.setBaseColorFactor?.(neutralFactor);
    pbr?.setMetallicFactor?.(0);
    if (!pbr?.metallicRoughnessTexture?.texture) {
      pbr?.setRoughnessFactor?.(Number(materialStandard.roughness ?? 0.68));
    }
    const sheenWeight = Number(materialStandard.sheenWeight ?? 0.32);
    try {
      material.setSheenColorFactor?.([sheenWeight, sheenWeight, sheenWeight]);
    } catch (error) {
      // Some GLBs do not declare the optional sheen extension.
    }
    try {
      material.setSpecularFactor?.(Number(materialStandard.specularIorLevel ?? 0.32));
    } catch (error) {
      // Some GLBs do not declare the optional specular extension.
    }
  });
}

detailRenderStandardPromise.then((standard) => {
  document.querySelectorAll('[data-catalog-render-standard]').forEach((element) => {
    applyCatalogRenderAttributes(element, standard);
    applyCatalogMaterialResponse(element, standard);
  });
});

function renderDetailLightingControls() {
  const angle = Math.max(-90, Math.min(90, Number(detailLightState.azimuthOffsetDeg) || 0));
  const exposurePercent = Math.round(Math.max(0.55, Math.min(3, Number(detailLightState.exposure) || 2)) * 100);
  const softnessPercent = Math.round(Math.max(0.5, Math.min(1, Number(detailLightState.shadowSoftness) || 0.9)) * 100);
  if (quickLightExposure) quickLightExposure.value = String(exposurePercent);
  if (quickLightSoftness) quickLightSoftness.value = String(softnessPercent);
  if (quickLightExposureOutput) quickLightExposureOutput.textContent = `${exposurePercent}%`;
  if (quickLightSoftnessOutput) quickLightSoftnessOutput.textContent = `${softnessPercent}%`;
  quickLightPresetButtons.forEach((button) => {
    const isActive = Number(button.dataset.lightAngle) === angle;
    button.classList.toggle('active', isActive);
    button.setAttribute('aria-pressed', String(isActive));
  });
}

function applyDetailLightingSettings() {
  document.querySelectorAll('[data-catalog-render-standard]').forEach((element) => {
    element.dataset.studioLightAzimuthOffset = String(detailLightState.azimuthOffsetDeg);
    element.setAttribute('exposure', String(detailLightState.exposure * (Number(element.dataset.designExposureRatio) || 1)));
    element.setAttribute('shadow-softness', String(detailLightState.shadowSoftness));
    window.CameraRelativeStudioLight?.install(element, {
      environmentImage: element.dataset.cameraRelativeStudioLight,
      referenceAzimuthDeg: Number(element.dataset.studioLightReferenceAzimuth || -16),
      azimuthOffsetDeg: detailLightState.azimuthOffsetDeg
    });
  });
  renderDetailLightingControls();
}

quickLightPresetButtons.forEach((button) => button.addEventListener('click', () => {
  detailLightState.azimuthOffsetDeg = Number(button.dataset.lightAngle);
  applyDetailLightingSettings();
}));
quickLightExposure?.addEventListener('input', () => {
  detailLightState.exposure = Number(quickLightExposure.value) / 100;
  applyDetailLightingSettings();
});
quickLightSoftness?.addEventListener('input', () => {
  detailLightState.shadowSoftness = Number(quickLightSoftness.value) / 100;
  applyDetailLightingSettings();
});
renderDetailLightingControls();

function syncHeroColumnHeights() {
  if (!modelInfoSection || !modelViewerSection) return;
  if (window.matchMedia('(max-width: 820px)').matches) {
    modelViewerSection.style.removeProperty('--model-viewer-height');
    return;
  }
  modelViewerSection.style.setProperty('--model-viewer-height', `${Math.ceil(modelInfoSection.getBoundingClientRect().height)}px`);
}

requestAnimationFrame(syncHeroColumnHeights);
window.addEventListener('resize', syncHeroColumnHeights, { passive: true });
if ('ResizeObserver' in window && modelInfoSection) {
  new ResizeObserver(syncHeroColumnHeights).observe(modelInfoSection);
}

function setHeroBackground(value, activePreset = null) {
  if (!heroSection || !value) return;
  heroSection.style.setProperty('--hero-background', value);
  backgroundBtn?.style.setProperty('--control-background', value);
  heroBackgroundPresets.forEach((button) => {
    const isActive = button === activePreset;
    button.classList.toggle('active', isActive);
    button.setAttribute('aria-pressed', String(isActive));
  });
}

function customHeroGradient() {
  return `linear-gradient(${heroGradientAngle?.value || 135}deg, ${heroGradientFrom?.value || '#f8eee1'} 0%, ${heroGradientTo?.value || '#dbc4ae'} 100%)`;
}

function closeHeroBackgroundPopover({ restoreFocus = false } = {}) {
  if (!heroBackgroundPopover || heroBackgroundPopover.hidden) return;
  heroBackgroundPopover.hidden = true;
  backgroundBtn?.setAttribute('aria-expanded', 'false');
  if (restoreFocus) backgroundBtn?.focus({ preventScroll: true });
}

backgroundBtn?.addEventListener('click', () => {
  const shouldOpen = heroBackgroundPopover?.hidden;
  if (!heroBackgroundPopover) return;
  heroBackgroundPopover.hidden = !shouldOpen;
  backgroundBtn.setAttribute('aria-expanded', String(shouldOpen));
  if (shouldOpen) heroBackgroundPopover.querySelector('button')?.focus({ preventScroll: true });
});

heroBackgroundPresets.forEach((button) => button.addEventListener('click', () => {
  setHeroBackground(button.dataset.heroBackground, button);
}));

[heroGradientFrom, heroGradientTo, heroGradientAngle].filter(Boolean).forEach((input) => input.addEventListener('input', () => {
  if (heroGradientAngleValue) heroGradientAngleValue.value = `${heroGradientAngle.value}°`;
  setHeroBackground(customHeroGradient());
}));

applyHeroGradient?.addEventListener('click', () => {
  setHeroBackground(customHeroGradient());
  closeHeroBackgroundPopover({ restoreFocus: true });
});

document.addEventListener('pointerdown', (event) => {
  if (heroBackgroundPopover?.hidden || heroBackgroundPopover?.contains(event.target) || backgroundBtn?.contains(event.target)) return;
  closeHeroBackgroundPopover();
});

document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape' && heroBackgroundPopover && !heroBackgroundPopover.hidden) {
    event.preventDefault();
    closeHeroBackgroundPopover({ restoreFocus: true });
  }
});

function setFabricMotionState(element, shouldPlay) {
  if (!element?.availableAnimations?.length) return false;
  const preferredAnimation = element.availableAnimations.find((name) => /fabric|breeze|soft/i.test(name))
    || element.availableAnimations[0];
  element.animationName = preferredAnimation;
  element.timeScale = 0.72;
  if (shouldPlay && !document.hidden) {
    element.play?.({ repetitions: Infinity });
  } else {
    element.pause?.();
  }
  fabricMotionBtn?.classList.toggle('active', shouldPlay);
  fabricMotionBtn?.setAttribute('aria-pressed', String(shouldPlay));
  return true;
}

function configureGarmentSoftnessAnimation(element) {
  if (!element || element.dataset.softnessAnimationReady === 'true') return;
  if (!element.availableAnimations?.length) return;
  element.dataset.softnessAnimationReady = 'true';
  if (fabricMotionBtn) fabricMotionBtn.hidden = false;
  setFabricMotionState(element, fabricMotionEnabled);

  const pauseDuringInteraction = () => {
    window.clearTimeout(fabricMotionResumeTimer);
    element.pause?.();
  };
  const resumeAfterInteraction = () => {
    window.clearTimeout(fabricMotionResumeTimer);
    fabricMotionResumeTimer = window.setTimeout(() => {
      setFabricMotionState(element, fabricMotionEnabled);
    }, 650);
  };
  element.addEventListener('pointerdown', pauseDuringInteraction);
  window.addEventListener('pointerup', resumeAfterInteraction);
  element.addEventListener('pointercancel', resumeAfterInteraction);
}

function withModelViewerTimeout(promise, milliseconds, message) {
  return Promise.race([
    promise,
    new Promise((_, reject) => window.setTimeout(() => reject(new Error(message)), milliseconds))
  ]);
}

function loadModelViewerModule() {
  window.ModelViewerElement = window.ModelViewerElement || {};
  window.ModelViewerElement.meshoptDecoderLocation = '/vendor/model-viewer/meshopt_decoder.js?v=three-0.183.0';
  if (customElements.get('model-viewer')) return Promise.resolve();
  if (modelViewerModulePromise) return modelViewerModulePromise;

  modelViewerModulePromise = new Promise((resolve, reject) => {
    const script = document.createElement('script');
    script.type = 'module';
    script.src = '/vendor/model-viewer/model-viewer.min.js?v=4.3.1';
    script.dataset.detailModelViewer = 'true';
    script.addEventListener('load', resolve, { once: true });
    script.addEventListener('error', () => reject(new Error('3D viewer failed to load')), { once: true });
    document.head.appendChild(script);
  }).then(() => withModelViewerTimeout(customElements.whenDefined('model-viewer'), 5000, '3D viewer unavailable'));

  return modelViewerModulePromise;
}

function loadModelViewerElement(element) {
  if (!element) return Promise.reject(new Error('3D viewer unavailable'));
  if (modelViewerPromises.has(element)) return modelViewerPromises.get(element);

  const renderStandardReady = element.dataset.catalogRenderStandard
    ? detailRenderStandardPromise
    : Promise.resolve(null);
  const promise = Promise.all([loadModelViewerModule(), renderStandardReady]).then(([, renderStandard]) => {
    if (renderStandard) applyCatalogRenderAttributes(element, renderStandard);
    element.hidden = false;
    element.setAttribute('loading', 'eager');
    element.setAttribute('reveal', 'auto');
    const modelSource = element.getAttribute('src') || element.dataset.modelSrc;
    if (!modelSource) throw new Error('3D model source unavailable');
    if (element.getAttribute('src') && element.loaded && element.model) return element;
    return new Promise((resolve, reject) => {
      element.addEventListener('load', () => resolve(element), { once: true });
      element.addEventListener('error', () => reject(new Error('3D model failed to load')), { once: true });
      if (!element.getAttribute('src')) element.setAttribute('src', modelSource);
    });
  }).then(async (readyViewer) => {
    readyViewer.dismissPoster?.();
    readyViewer.removeAttribute('poster');
    applyCatalogMaterialResponse(readyViewer, detailSceneStandard);
    configureGarmentSoftnessAnimation(readyViewer);
    if (readyViewer.hasAttribute('data-entitlement-texture-watermark')) {
      await window.ExportEntitlements?.applyModelViewerWatermark?.(readyViewer);
    }
    return readyViewer;
  }).catch((error) => {
    modelViewerPromises.delete(element);
    throw error;
  });

  modelViewerPromises.set(element, promise);
  return promise;
}

window.loadClothingModelViewer = loadModelViewerElement;
window.loadClothingModelViewerModule = loadModelViewerModule;

async function ensureDetailViewer() {
  if (!viewer || !modelViewerStage) return null;
  modelViewerStage.classList.remove('is-error');
  modelViewerStage.classList.add('is-loading');
  modelViewerStage.setAttribute('aria-busy', 'true');
  try {
    const readyViewer = await loadModelViewerElement(viewer);
    modelViewerStage.classList.remove('is-loading');
    modelViewerStage.classList.add('is-ready');
    modelViewerStage.setAttribute('aria-busy', 'false');
    delete modelViewerStage.dataset.loadError;
    return readyViewer;
  } catch (error) {
    modelViewerStage.classList.remove('is-loading');
    modelViewerStage.setAttribute('aria-busy', 'false');
    modelViewerStage.dataset.loadError = error?.message || '3D viewer unavailable';
    throw error;
  }
}

ensureDetailViewer().catch(() => {});

if (rotateBtn && viewer) {
  rotateBtn.addEventListener('click', async () => {
    const readyViewer = await ensureDetailViewer().catch(() => null);
    if (!readyViewer) return;
    readyViewer.autoRotate = !readyViewer.autoRotate;
    rotateBtn.classList.toggle('active', readyViewer.autoRotate);
    rotateBtn.setAttribute('aria-pressed', String(readyViewer.autoRotate));
  });
}

document.querySelectorAll('.model-view-angle').forEach((button) => {
  button.addEventListener('click', async () => {
    const readyViewer = await ensureDetailViewer().catch(() => null);
    if (!readyViewer) return;
    readyViewer.autoRotate = false;
    rotateBtn?.classList.remove('active');
    rotateBtn?.setAttribute('aria-pressed', 'false');
    readyViewer.cameraOrbit = catalogOrbitForAzimuth(detailSceneStandard, button.dataset.orbit);
    readyViewer.jumpCameraToGoal?.();
    document.querySelectorAll('.model-view-angle').forEach((item) => {
      const isActive = item === button;
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-pressed', String(isActive));
    });
  });
});

if (fabricMotionBtn && viewer) {
  fabricMotionBtn.addEventListener('click', async () => {
    const readyViewer = await ensureDetailViewer().catch(() => null);
    if (!readyViewer) return;
    fabricMotionEnabled = !fabricMotionEnabled;
    setFabricMotionState(readyViewer, fabricMotionEnabled);
    window.trackEvent?.(fabricMotionEnabled
      ? 'model_detail_fabric_motion_enable'
      : 'model_detail_fabric_motion_disable', {
      interaction_type: fabricMotionEnabled ? 'enable_fabric_motion' : 'disable_fabric_motion',
      item_id: <%- JSON.stringify(model.slug || '') %>
    });
  });
}

document.addEventListener('visibilitychange', () => {
  if (!viewer?.availableAnimations?.length) return;
  setFabricMotionState(viewer, fabricMotionEnabled && !document.hidden);
});

if (zoomBtn && viewer) {
  let viewerZoomed = false;
  let viewerBaseRadius = null;
  zoomBtn.addEventListener('click', async () => {
    const readyViewer = await ensureDetailViewer().catch(() => null);
    const orbit = readyViewer?.getCameraOrbit?.();
    if (!orbit) return;
    if (!viewerBaseRadius) viewerBaseRadius = orbit.radius;
    viewerZoomed = !viewerZoomed;
    const radius = viewerZoomed ? viewerBaseRadius * 0.8 : viewerBaseRadius;
    readyViewer.cameraOrbit = `${orbit.theta}rad ${orbit.phi}rad ${radius}m`;
    readyViewer.jumpCameraToGoal?.();
    zoomBtn.classList.toggle('active', viewerZoomed);
    zoomBtn.setAttribute('aria-pressed', String(viewerZoomed));
  });
}

// Demo color picker
const colorBtns = document.querySelectorAll('.color-btn');
colorBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    colorBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

// Demo pattern picker
const patternBtns = document.querySelectorAll('.pattern-btn');
patternBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    patternBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

</script>
<script>
window.ModelDesignerConfig = Object.freeze({
  defaultTextContent: <%- JSON.stringify(t('designStudio.defaultText')) %>,
  currentModelCategory: <%- JSON.stringify(model.category || model.category_label || model.category_slug || '') %>,
  categorySlug: <%- JSON.stringify(model.category_slug || '') %>,
  categoryLabel: <%- JSON.stringify(model.category_label || '') %>,
  textureUrl: <%- JSON.stringify(model.texture_url || '') %>,
  previewModelFileUrl: <%- JSON.stringify(previewModelFileUrl || '') %>,
  modelId: <%- JSON.stringify(model.id || null) %>,
  modelSlug: <%- JSON.stringify(model.slug || '') %>,
  modelName: <%- JSON.stringify(model.name || '') %>,
  previewImageUrl: <%- JSON.stringify(model.image_url || '') %>,
  aiTryOnAvailable: <%- JSON.stringify(aiTryOnAvailable) %>,
  aiTryOnPath: <%- JSON.stringify(aiTryOnPath) %>,
  userAuthenticated: <%- JSON.stringify(Boolean(user)) %>
});

(() => {
  const entryButtons = [
    document.getElementById('designNowBtn'),
    document.getElementById('customizeFeatureBtn'),
    document.getElementById('designCtaBtn'),
    document.getElementById('renderCurrentModelBtn'),
    document.getElementById('customizationInquiryBtn'),
    document.getElementById('productionFeatureBtn')
  ].filter(Boolean);
  const aiTryOnLinks = [...document.querySelectorAll('[data-ai-try-on-link]')];

  function syncModelTryOnLinks(projectId = new URLSearchParams(window.location.search).get('project')) {
    const safeProjectId = /^[a-f0-9-]{36}$/i.test(String(projectId || '')) ? String(projectId) : '';
    aiTryOnLinks.forEach((link) => {
      const destination = new URL(link.href, window.location.origin);
      if (safeProjectId) destination.searchParams.set('project', safeProjectId);
      else destination.searchParams.delete('project');
      link.href = `${destination.pathname}${destination.search}`;
    });
  }

  window.syncModelTryOnLinks = syncModelTryOnLinks;
  syncModelTryOnLinks();
  let runtimePromise = null;
  let runtimeReady = false;
  const loginModal = document.getElementById('modelLoginModal');
  const loginBackdrop = document.getElementById('modelLoginBackdrop');
  const loginClose = document.getElementById('modelLoginClose');
  const loginForm = document.getElementById('modelLoginForm');
  const loginEmail = document.getElementById('modelLoginEmail');
  const loginError = document.getElementById('modelLoginError');
  const loginSubmit = document.getElementById('modelLoginSubmit');
  const googleLogin = document.getElementById('modelGoogleLogin');
  const registerLink = loginModal?.querySelector('.model-login-register a');
  const resumeCustomizeKey = 'clozdesign_resume_customize';
  let loginReturnFocus = null;

  function openLoginModal() {
    if (!loginModal) return;
    loginReturnFocus = document.activeElement;
    loginError.hidden = true;
    loginError.textContent = '';
    if (!loginModal.open) loginModal.showModal();
    loginModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('model-login-open');
    requestAnimationFrame(() => loginEmail?.focus({ preventScroll: true }));
  }

  function closeLoginModal() {
    if (!loginModal || !loginModal.open) return;
    loginModal.close();
    loginModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('model-login-open');
    loginReturnFocus?.focus?.({ preventScroll: true });
  }

  loginModal?.addEventListener('cancel', (event) => { event.preventDefault(); closeLoginModal(); });
  loginBackdrop?.addEventListener('click', closeLoginModal);
  loginClose?.addEventListener('click', closeLoginModal);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && loginModal && loginModal.open) {
      event.preventDefault();
      closeLoginModal();
    }
  });

  function rememberCustomizeIntent() {
    sessionStorage.setItem(resumeCustomizeKey, JSON.stringify({ path: window.location.pathname, createdAt: Date.now() }));
  }

  googleLogin?.addEventListener('click', rememberCustomizeIntent);
  registerLink?.addEventListener('click', rememberCustomizeIntent);

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!loginForm.reportValidity() || loginSubmit.disabled) return;
    const data = new FormData(loginForm);
    loginSubmit.disabled = true;
    loginSubmit.setAttribute('aria-busy', 'true');
    loginSubmit.querySelector('span').textContent = 'Signing in…';
    loginError.hidden = true;
    try {
      const response = await fetch('/auth/login', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: data.get('email'),
          password: data.get('password'),
          next: window.location.pathname + window.location.search
        })
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Unable to sign in. Please try again.');
      }
      sessionStorage.setItem(resumeCustomizeKey, JSON.stringify({ path: window.location.pathname, createdAt: Date.now() }));
      window.location.reload();
    } catch (error) {
      loginError.textContent = error.message || 'Unable to sign in. Please try again.';
      loginError.hidden = false;
      loginSubmit.disabled = false;
      loginSubmit.removeAttribute('aria-busy');
      loginSubmit.querySelector('span').textContent = 'Sign in and customize';
    }
  });

  function loadDesignerMaterials() {
    if (window.Design3DMaterials) return Promise.resolve();
    const existing = document.querySelector('script[data-design-materials]');
    if (existing) {
      return new Promise((resolve, reject) => {
        existing.addEventListener('load', resolve, { once: true });
        existing.addEventListener('error', reject, { once: true });
      });
    }
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/js/design3d-materials.js?v=20260819-fabric-softness-v2';
      script.dataset.designMaterials = 'true';
      script.addEventListener('load', resolve, { once: true });
      script.addEventListener('error', () => reject(new Error('Design materials failed to load')), { once: true });
      document.body.appendChild(script);
    });
  }

  function loadDesignerRuntimeFile() {
    if (typeof window.initializeModelDesigner === 'function') return Promise.resolve();
    const loadScript = ({ selector, src, dataset, ready, errorMessage }) => {
      if (ready()) return Promise.resolve();
      const existing = document.querySelector(selector);
      if (existing) {
        return new Promise((resolve, reject) => {
          existing.addEventListener('load', resolve, { once: true });
          existing.addEventListener('error', reject, { once: true });
        });
      }
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.dataset[dataset] = 'true';
        script.addEventListener('load', resolve, { once: true });
        script.addEventListener('error', () => reject(new Error(errorMessage)), { once: true });
        document.body.appendChild(script);
      });
    };
    return loadScript({
      selector: 'script[data-editor-transform-runtime]',
      src: '/js/editor-transform.js?v=20260815-text-selection-v4',
      dataset: 'editorTransformRuntime',
      ready: () => Boolean(window.ModelDesignerTransforms),
      errorMessage: 'Editor transform helpers failed to load'
    }).then(() => loadScript({
      selector: 'script[data-model-designer-runtime]',
      src: '/js/model-designer.js?v=20260926-paid-v1',
      dataset: 'modelDesignerRuntime',
      ready: () => typeof window.initializeModelDesigner === 'function',
      errorMessage: 'Design Studio runtime failed to load'
    }));
  }

  function loadModelDesignerRuntime() {
    if (runtimeReady) return Promise.resolve();
    if (runtimePromise) return runtimePromise;
    runtimePromise = Promise.all([loadDesignerMaterials(), loadDesignerRuntimeFile()]).then(() => {
      if (typeof window.initializeModelDesigner !== 'function') {
        throw new Error('Design Studio runtime unavailable');
      }
      window.initializeModelDesigner();
      runtimeReady = true;
      entryButtons.forEach((button) => button.removeEventListener('click', handleDesignerEntry));
    }).catch((error) => {
      runtimePromise = null;
      throw error;
    });
    return runtimePromise;
  }

  const quickFabricToggle = document.getElementById('quickFabricToggle');
  const quickFabricMenu = document.getElementById('quickFabricMenu');
  const quickFabricName = document.getElementById('quickFabricName');
  const quickFabricPreview = document.getElementById('quickFabricPreview');
  const quickMaterialButtons = [...document.querySelectorAll('[data-quick-material]')];
  const quickColorButtons = [...document.querySelectorAll('[data-quick-color]')];

  function closeQuickFabricMenu({ restoreFocus = false } = {}) {
    if (!quickFabricMenu || quickFabricMenu.hidden) return;
    quickFabricMenu.hidden = true;
    quickFabricToggle?.setAttribute('aria-expanded', 'false');
    if (restoreFocus) quickFabricToggle?.focus({ preventScroll: true });
  }

  quickFabricToggle?.addEventListener('click', () => {
    const shouldOpen = quickFabricMenu?.hidden;
    if (!quickFabricMenu) return;
    quickFabricMenu.hidden = !shouldOpen;
    quickFabricToggle.setAttribute('aria-expanded', String(shouldOpen));
    if (shouldOpen) quickFabricMenu.querySelector('button')?.focus({ preventScroll: true });
  });

  quickMaterialButtons.forEach((button) => button.addEventListener('click', async () => {
    if (button.getAttribute('aria-busy') === 'true') return;
    button.setAttribute('aria-busy', 'true');
    try {
      await loadModelDesignerRuntime();
      await window.applyModelQuickMaterial?.(button.dataset.quickMaterial);
      quickMaterialButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      if (quickFabricName) quickFabricName.textContent = button.dataset.materialName || 'Fabric';
      if (quickFabricPreview) quickFabricPreview.style.backgroundImage = `url("${button.dataset.materialPreview || ''}")`;
      closeQuickFabricMenu({ restoreFocus: true });
    } catch (error) {
      console.error('Failed to apply quick material:', error);
    } finally {
      button.removeAttribute('aria-busy');
    }
  }));

  quickColorButtons.forEach((button) => button.addEventListener('click', async () => {
    if (button.getAttribute('aria-busy') === 'true') return;
    button.setAttribute('aria-busy', 'true');
    try {
      await loadModelDesignerRuntime();
      await window.applyModelQuickColor?.(button.dataset.quickColor);
      quickColorButtons.forEach((item) => {
        const isActive = item === button;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
    } catch (error) {
      console.error('Failed to apply quick color:', error);
    } finally {
      button.removeAttribute('aria-busy');
    }
  }));

  document.addEventListener('pointerdown', (event) => {
    if (quickFabricMenu?.hidden || quickFabricMenu?.contains(event.target) || quickFabricToggle?.contains(event.target)) return;
    closeQuickFabricMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && quickFabricMenu && !quickFabricMenu.hidden) {
      event.preventDefault();
      closeQuickFabricMenu({ restoreFocus: true });
    }
  });

  async function handleDesignerEntry(event) {
    const entryId = event.currentTarget.id;
    if (!window.ModelDesignerConfig.userAuthenticated && entryId === 'designNowBtn') {
      openLoginModal();
      return;
    }
    entryButtons.forEach((button) => {
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
    });
    try {
      await loadModelDesignerRuntime();
      entryButtons.forEach((button) => button.removeEventListener('click', handleDesignerEntry));
      if (entryId === 'renderCurrentModelBtn') {
        window.ModelExportModal?.open();
      } else if (entryId === 'customizationInquiryBtn' || entryId === 'productionFeatureBtn') {
        window.openModelCustomizationInquiry?.();
      } else {
        window.openModelDesigner?.();
      }
    } catch (error) {
      console.error(error);
    } finally {
      entryButtons.forEach((button) => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      });
    }
  }

  entryButtons.forEach((button) => button.addEventListener('click', handleDesignerEntry));
  window.loadModelDesignerRuntime = loadModelDesignerRuntime;

  if (window.ModelDesignerConfig.userAuthenticated) {
    try {
      const resume = JSON.parse(sessionStorage.getItem(resumeCustomizeKey) || 'null');
      const isFresh = resume?.path === window.location.pathname && Date.now() - resume.createdAt < 5 * 60 * 1000;
      sessionStorage.removeItem(resumeCustomizeKey);
      if (isFresh && window.location.hash !== '#design') requestAnimationFrame(() => document.getElementById('designNowBtn')?.click());
    } catch (error) {
      sessionStorage.removeItem(resumeCustomizeKey);
    }
  }

  // Tool landing pages link directly to the editor using #design.
  if (window.location.hash === '#design') {
    const enterDesigner = () => requestAnimationFrame(() => document.getElementById('designNowBtn')?.click());
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enterDesigner, { once: true });
    else enterDesigner();
  }

  const exportProxies = [
    'exportDesignedModelCover',
    'exportDesignedModelCoverFormats',
    'prepareDesignedModelCoverCapture',
    'cleanupDesignedModelCoverCapture'
  ];
  exportProxies.forEach((methodName) => {
    window[methodName] = async (...args) => {
      await loadModelDesignerRuntime();
      return window[methodName](...args);
    };
  });

  let hasPendingArtwork = false;
  try {
    hasPendingArtwork = Boolean(JSON.parse(sessionStorage.getItem('clothingdesign_pending_artwork') || 'null')?.dataUrl);
  } catch (error) {
    hasPendingArtwork = false;
  }
  const projectParams = new URLSearchParams(window.location.search);
  const hasSavedProject = projectParams.has('project') || projectParams.has('adminProject');
  if (hasPendingArtwork || hasSavedProject) {
    const loadSavedDesign = () => loadModelDesignerRuntime().catch((error) => console.error(error));
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadSavedDesign, { once: true });
    } else {
      loadSavedDesign();
    }
  }
})();
</script>
<% if (supportsOnModelMockup) { %>
  <script>
  (() => {
    const modal = document.getElementById('modelMockupModal');
    const launchButtons = [
      document.getElementById('modelMockupBtn'),
      document.getElementById('designModelMockupBtn')
    ].filter(Boolean);
    let studioPromise = null;

    function loadStylesheet() {
      const existing = document.querySelector('link[data-on-model-studio]');
      if (existing?.sheet) return Promise.resolve();
      if (existing) {
        return new Promise((resolve, reject) => {
          existing.addEventListener('load', resolve, { once: true });
          existing.addEventListener('error', reject, { once: true });
        });
      }
      return new Promise((resolve, reject) => {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/css/on-model-mockup.css?v=20260821';
        link.dataset.onModelStudio = 'true';
        link.addEventListener('load', resolve, { once: true });
        link.addEventListener('error', () => reject(new Error('Mockup studio styles failed to load')), { once: true });
        document.head.appendChild(link);
      });
    }

    function loadStudioScript() {
      if (window.ModelMockupStudio) return Promise.resolve();
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = '/js/on-model-mockup.js?v=20260926-paid-v1';
        script.dataset.onModelStudio = 'true';
        script.addEventListener('load', resolve, { once: true });
        script.addEventListener('error', () => reject(new Error('Mockup studio failed to load')), { once: true });
        document.body.appendChild(script);
      });
    }

    function loadStudio() {
      if (window.ModelMockupStudio) return Promise.resolve(window.ModelMockupStudio);
      if (!studioPromise) {
        studioPromise = Promise.all([loadStylesheet(), loadStudioScript()])
          .then(() => {
            if (!window.ModelMockupStudio) throw new Error('Mockup studio unavailable');
            modal.hidden = false;
            return window.ModelMockupStudio;
          })
          .catch((error) => {
            studioPromise = null;
            throw error;
          });
      }
      return studioPromise;
    }

    async function openStudio() {
      launchButtons.forEach((button) => {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
      });
      try {
        const studio = await loadStudio();
        launchButtons.forEach((button) => button.removeEventListener('click', openStudio));
        studio.open();
      } catch (error) {
        console.error(error);
      } finally {
        launchButtons.forEach((button) => {
          button.disabled = false;
          button.removeAttribute('aria-busy');
        });
      }
    }

    launchButtons.forEach((button) => button.addEventListener('click', openStudio));
  })();
  </script>
<% } %>


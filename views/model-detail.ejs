<!-- Customization Inquiry Modal -->
<div class="customization-modal" id="customizationInquiryModal" role="dialog" aria-modal="true" aria-labelledby="customizationInquiryTitle" aria-hidden="true">
  <button class="customization-modal-overlay" id="customizationInquiryOverlay" type="button" aria-label="Close customization request"></button>
  <div class="customization-modal-content">
    <header class="customization-modal-header">
      <div>
        <span>Production inquiry</span>
        <h2 id="customizationInquiryTitle">Request customization</h2>
        <p>Tell us how to reach you, where the order is going, and the quantity you need. Your current design will be attached automatically.</p>
      </div>
      <button class="customization-modal-close" id="customizationInquiryClose" type="button" aria-label="Close customization request">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="customization-modal-body">
      <form class="customization-form" id="customizationInquiryForm">
        <div class="customization-form-grid">
          <label class="customization-field">
            <span>Contact name <b>*</b></span>
            <input type="text" name="name" autocomplete="name" maxlength="100" required placeholder="Your name">
          </label>
          <label class="customization-field">
            <span>Email <b>*</b></span>
            <input type="email" name="email" autocomplete="email" maxlength="180" required placeholder="you@example.com">
          </label>
          <label class="customization-field customization-field-wide">
            <span>Delivery address <b>*</b></span>
            <input type="text" name="address" autocomplete="street-address" maxlength="300" required placeholder="Street, city, state/province, postal code, country">
          </label>
          <label class="customization-field customization-field-quantity">
            <span>Customization quantity <b>*</b></span>
            <input type="number" name="quantity" min="1" max="1000000" step="1" inputmode="numeric" required placeholder="e.g. 500">
          </label>
          <label class="customization-field customization-field-wide">
            <span>Requirements</span>
            <textarea name="notes" maxlength="3000" rows="4" placeholder="Tell us about fabric, colors, sizes, delivery market, timeline, or other production requirements."></textarea>
          </label>
          <label class="customization-honeypot" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </label>
        </div>

        <section class="customization-attachments" aria-labelledby="customizationAttachmentsTitle">
          <div class="customization-section-heading">
            <div>
              <span>Design attachments</span>
              <h3 id="customizationAttachmentsTitle">Current 3D and 2D design</h3>
            </div>
            <button type="button" class="customization-refresh" id="customizationRefreshSnapshots">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 11a8 8 0 10-2.34 5.66M20 4v7h-7"/>
              </svg>
              Refresh
            </button>
          </div>
          <div class="customization-preview-grid">
            <figure class="customization-preview-card">
              <div class="customization-preview-media">
                <img id="customizationPreview3d" alt="Current 3D clothing design screenshot">
                <div class="customization-preview-loading" id="customizationPreview3dLoading">
                  <span class="customization-spinner" aria-hidden="true"></span>
                  <span>Rendering 3D view…</span>
                </div>
              </div>
              <figcaption><strong>3D design</strong><span>High-resolution garment view</span></figcaption>
            </figure>
            <figure class="customization-preview-card">
              <div class="customization-preview-media">
                <img id="customizationPreview2d" alt="Current 2D texture layout screenshot">
                <div class="customization-preview-loading" id="customizationPreview2dLoading">
                  <span class="customization-spinner" aria-hidden="true"></span>
                  <span>Capturing 2D layout…</span>
                </div>
              </div>
              <figcaption><strong>2D design</strong><span>Artwork and panel layout</span></figcaption>
            </figure>
          </div>
        </section>

        <p class="customization-form-status" id="customizationInquiryStatus" role="alert" aria-live="polite"></p>
        <footer class="customization-form-actions">
          <p>We use these details only to respond to this customization request.</p>
          <div>
            <button type="button" class="btn btn-secondary" id="customizationInquiryCancel">Cancel</button>
            <button type="submit" class="btn btn-primary" id="customizationInquirySubmit" disabled>
              <span>Submit request</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </button>
          </div>
        </footer>
      </form>

      <section class="customization-success" id="customizationInquirySuccess" hidden>
        <div class="customization-success-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </div>
        <span>Request received</span>
        <h3>Thank you — we’ll be in touch.</h3>
        <p>Our team will reply within <strong>3 business days</strong>. Please watch your email messages.</p>
        <div class="customization-reference">
          <span>Reference</span>
          <strong id="customizationInquiryReference">—</strong>
        </div>
        <button type="button" class="btn btn-primary" id="customizationInquiryDone">Done</button>
      </section>
    </div>
  </div>
</div>

<% if (supportsOnModelMockup) { %>
<!-- On-model Garment Mockup Studio -->
<div
  class="model-mockup-modal"
  id="modelMockupModal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="modelMockupTitle"
  aria-hidden="true"
  data-base-image="<%= modelMockupProfile.base_image_url %>"
  data-mask-image="<%= modelMockupProfile.live_mask_url %>"
  data-mask-fallback="<%= modelMockupProfile.mask_image_url %><%= modelMockupProfile.mask_image_url.includes('?') ? '&' : '?' %>v=commercial-refine-v4"
  data-depth-image="<%= modelMockupProfile.depth_image_url %>?v=commercial-refine-v4"
  data-garment-type="<%= modelMockupProfile.garment_type %>"
  data-export-slug="<%= modelMockupProfile.export_slug %>"
  data-canvas-width="<%= modelMockupProfile.canvas_width %>"
  data-canvas-height="<%= modelMockupProfile.canvas_height %>"
  data-artwork-center-x="<%= modelMockupProfile.artwork_center_x %>"
  data-artwork-center-y="<%= modelMockupProfile.artwork_center_y %>"
  data-artwork-base-width="<%= modelMockupProfile.artwork_base_width %>"
  data-artwork-max-height="<%= modelMockupProfile.artwork_max_height %>"
  data-render-left="<%= modelMockupProfile.render_left %>"
  data-render-top="<%= modelMockupProfile.render_top %>"
  data-render-right="<%= modelMockupProfile.render_right %>"
  data-render-bottom="<%= modelMockupProfile.render_bottom %>"
  data-default-scale="<%= modelMockupProfile.default_scale %>"
  data-default-warp="<%= modelMockupProfile.default_warp %>"
>
  <div class="model-mockup-shell">
    <header class="model-mockup-header">
      <div class="model-mockup-heading">
        <span class="model-mockup-mark" aria-hidden="true">M</span>
        <div>
          <span>On-model studio</span>
          <h2 id="modelMockupTitle"><%= modelMockupProfile.title %></h2>
        </div>
      </div>
      <div class="model-mockup-pipeline" aria-label="Mockup rendering pipeline">
        <span><i></i> Garment mask</span>
        <span><i></i> Fold depth</span>
        <span><i></i> Live composite</span>
      </div>
      <div class="model-mockup-header-actions">
        <button type="button" class="model-mockup-quiet-button" id="modelMockupReset">Reset</button>
        <button type="button" class="btn btn-primary" id="modelMockupDownload" disabled>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"/>
          </svg>
          Download mockup
        </button>
        <button type="button" class="model-mockup-close" id="modelMockupClose" aria-label="Close on-model mockup studio">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </header>

    <div class="model-mockup-body">
      <aside class="model-mockup-controls">
        <div class="model-mockup-intro">
          <span>01 / Artwork</span>
          <h3>Place your design</h3>
          <p>Upload a PNG, JPG, or WebP. Transparent PNG artwork gives the cleanest result.</p>
        </div>

        <label class="model-mockup-upload" id="modelMockupUploadZone">
          <input type="file" id="modelMockupArtworkInput" accept="image/png,image/jpeg,image/webp">
          <span class="model-mockup-upload-icon">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/>
            </svg>
          </span>
          <span>
            <strong id="modelMockupUploadLabel">Upload artwork</strong>
            <small>or drop an image here · max 10 MB</small>
          </span>
        </label>

        <div class="model-mockup-control-section">
          <div class="model-mockup-section-label">
            <span>02 / Placement</span>
            <button type="button" id="modelMockupCenter">Center</button>
          </div>
          <label class="model-mockup-range">
            <span><b>Scale</b><output for="modelMockupScale"><%= modelMockupProfile.default_scale %>%</output></span>
            <input type="range" id="modelMockupScale" min="20" max="105" value="<%= modelMockupProfile.default_scale %>">
          </label>
          <label class="model-mockup-range">
            <span><b>Horizontal</b><output for="modelMockupX">0</output></span>
            <input type="range" id="modelMockupX" min="-100" max="100" value="0">
          </label>
          <label class="model-mockup-range">
            <span><b>Vertical</b><output for="modelMockupY">0</output></span>
            <input type="range" id="modelMockupY" min="-100" max="100" value="0">
          </label>
          <label class="model-mockup-range">
            <span><b>Rotation</b><output for="modelMockupRotation">0°</output></span>
            <input type="range" id="modelMockupRotation" min="-25" max="25" value="0">
          </label>
        </div>

        <div class="model-mockup-control-section">
          <div class="model-mockup-section-label">
            <span>03 / Fabric response</span>
            <em>Depth mapped</em>
          </div>
          <label class="model-mockup-range">
            <span><b>Fold warp</b><output for="modelMockupWarp"><%= modelMockupProfile.default_warp %>%</output></span>
            <input type="range" id="modelMockupWarp" min="0" max="100" value="<%= modelMockupProfile.default_warp %>">
          </label>
          <label class="model-mockup-range">
            <span><b>Print opacity</b><output for="modelMockupOpacity">96%</output></span>
            <input type="range" id="modelMockupOpacity" min="20" max="100" value="96">
          </label>
        </div>

        <div class="model-mockup-map-switcher" role="group" aria-label="Preview technical maps">
          <button type="button" class="active" data-map-view="result">Result</button>
          <button type="button" data-map-view="mask">Mask</button>
          <button type="button" data-map-view="depth">Depth</button>
        </div>

        <p class="model-mockup-status" id="modelMockupStatus" role="status" aria-live="polite">Preparing garment maps…</p>
      </aside>

      <main class="model-mockup-preview">
        <div class="model-mockup-preview-meta">
          <div>
            <span>Live preview</span>
            <strong><%= model.name %></strong>
          </div>
          <div class="model-mockup-render-badges">
            <span><%= modelMockupProfile.canvas_width %> × <%= modelMockupProfile.canvas_height %></span>
            <span>Client-side render</span>
          </div>
        </div>
        <div class="model-mockup-stage" id="modelMockupStage">
          <canvas id="modelMockupCanvas" width="<%= modelMockupProfile.canvas_width %>" height="<%= modelMockupProfile.canvas_height %>" aria-label="<%= modelMockupProfile.title %> preview"></canvas>
          <div class="model-mockup-empty" id="modelMockupEmpty">
            <span>Blank <%= modelMockupProfile.garment_type.replace(/-/g, ' ') %> ready</span>
            <strong>Upload artwork to build the mockup</strong>
            <button type="button" id="modelMockupEmptyUpload">Choose image</button>
          </div>
          <div class="model-mockup-loading" id="modelMockupLoading">
            <i aria-hidden="true"></i>
            <span>Loading mask and depth data</span>
          </div>
        </div>
        <div class="model-mockup-preview-note">
          <span><i></i> Artwork is clipped to the detected garment silhouette.</span>
          <span>Depth gradients bend the print around folds and torso curvature.</span>
        </div>
      </main>
    </div>
  </div>
</div>
<% } %>

<!-- Design Modal -->
<div class="design-modal" id="designModal" role="dialog" aria-modal="true" aria-labelledby="designModalTitle" aria-hidden="true">
  <div class="design-modal-overlay" id="designModalOverlay"></div>
  <div class="design-modal-content">
    <div class="design-modal-header">
      <div class="design-modal-heading">
        <h2 id="designModalTitle">Design Studio</h2>
        <span class="design-modal-title-divider" aria-hidden="true">/</span>
        <p><%= model.name %></p>
      </div>
      <div class="design-header-history" role="group" aria-label="Design history">

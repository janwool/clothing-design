<%- include('partials/header') %>
<% const detailContent = modelDetailContent || {}; %>
<% const previewModelFileUrl = model.file_url; %>
<% const howToSteps = detailContent.howToSteps || []; %>
<% const applications = detailContent.applications || []; %>
<% const faqItems = detailContent.faqItems || []; %>
<% const relatedLinks = detailContent.relatedLinks || []; %>
<% const detailCta = detailContent.cta || {}; %>
<% const howToIcons = ['open', 'inspect', 'simulate', 'download']; %>
<% const modelMockupProfiles = {
  'classic-crew-neck-t-shirt-3d-model': {
    assetBase: '/images/mockups/on-model/tshirt-vneck-male-front'
  }
}; %>
<% const modelMockupProfile = modelMockupProfiles[model.slug] || null; %>
<% const supportsOnModelMockup = Boolean(modelMockupProfile); %>

<section class="model-detail-hero">
  <div class="container">
    <div class="model-detail-grid">
      <!-- Left: 3D Viewer -->
      <div class="model-viewer-section">
        <div class="model-3d-viewer<%= previewModelFileUrl ? ' is-loading' : '' %>" id="model3dViewer" aria-busy="<%= previewModelFileUrl ? 'true' : 'false' %>">
          <% if (previewModelFileUrl) { %>
            <img
              class="model-detail-poster"
              src="<%= model.image_url %>"
              alt="<%= model.name %> 3D apparel mockup preview"
              width="1200"
              height="1500"
              fetchpriority="high"
              decoding="async"
            >
            <model-viewer 
              class="model-viewer-natural"
              data-model-src="<%= previewModelFileUrl %>"
              poster="<%= model.image_url %>"
              alt="<%= model.name %> interactive 3D clothing model and apparel mockup"
              loading="eager"
              reveal="auto"
              camera-controls
              shadow-intensity="1.55"
              shadow-softness="0.52"
              exposure="0.66"
              environment-image="neutral"
              style="width: 100%; height: 100%;"
              hidden
            ></model-viewer>
            <button type="button" class="btn btn-secondary model-viewer-load" id="modelViewerLoad" hidden>
              <span>Retry interactive 3D</span>
            </button>
            <p class="model-viewer-load-status" id="modelViewerLoadStatus" aria-live="polite">Loading interactive 3D…</p>
          <% } else { %>
            <div class="model-viewer-placeholder">
              <img src="<%= model.image_url %>" alt="<%= model.name %>" class="model-preview-img">
            </div>
          <% } %>
        </div>
        <div class="model-viewer-controls">
          <button class="viewer-btn" id="rotateBtn" type="button" aria-pressed="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 11-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
              <path d="M21 3v5h-5"/>
            </svg>
            Auto Rotate
          </button>
          <button class="viewer-btn" id="fabricMotionBtn" type="button" aria-pressed="false" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 8c2.2-2.4 4.4-2.4 6.6 0s4.4 2.4 6.6 0S21.6 5.6 23 7"/>
              <path d="M1 13c2.2-2.4 4.4-2.4 6.6 0s4.4 2.4 6.6 0 4.4-2.4 6.6 0"/>
              <path d="M4 18c2.2-2.4 4.4-2.4 6.6 0s4.4 2.4 6.6 0"/>
            </svg>
            Fabric Motion
          </button>
          <button class="viewer-btn" id="fullscreenBtn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/>
            </svg>
            Fullscreen
          </button>
        </div>
      </div>

      <!-- Right: Model Info -->
      <div class="model-info-section">
        <div class="model-breadcrumb">
          <a href="/mockups">3D Models</a>
          <span>/</span>
          <a href="/mockups/<%= model.category_slug || model.category %>"><%= model.category_label || model.category %></a>
          <span>/</span>
          <span><%= model.name %></span>
        </div>
        
        <h1 class="model-detail-title"><%= model.name %></h1>
        
        <div class="model-detail-meta">
          <span class="tag tag-free">Free</span>
          <% if (model.poly_count) { %>
            <span class="meta-item"><%= model.poly_count %></span>
          <% } %>
        </div>

        <div class="model-actions">
          <button class="btn btn-primary btn-large" id="designNowBtn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            Customize this model
          </button>
          <div class="model-secondary-actions">
          <% if (previewModelFileUrl) { %>
            <button type="button" class="btn btn-secondary btn-large" id="downloadRenderBtn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
              </svg>
              Export transparent PNG
            </button>
          <% } %>
          <% if (supportsOnModelMockup) { %>
            <button type="button" class="btn btn-secondary btn-large" id="modelMockupBtn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M9 4.5 6.5 7 3 8.5l2 5 2.5-1V21h9v-8.5l2.5 1 2-5L17.5 7 15 4.5"/>
                <path d="M9 4.5a3.7 3.7 0 0 0 6 0M10 11h4M10 14h4"/>
              </svg>
              Preview on a model
            </button>
          <% } %>
          </div>
          <button type="button" class="model-consult-link" id="customizationInquiryBtn">
            Need a custom garment or production quantity? <strong>Request customization →</strong>
          </button>
          <span class="download-render-status" id="downloadRenderStatus" aria-live="polite"></span>
          <p class="model-action-note">Free during public beta · PNG export · no payment details required</p>
        </div>

        <div class="model-description">
          <h2>Description</h2>
          <p><%= model.description || 'No description available.' %></p>
        </div>

        <% if (detailContent.searchIntentSummary) { %>
          <div class="model-description model-search-summary">
            <h2>Mockup workflow</h2>
            <p><%= detailContent.searchIntentSummary %></p>
          </div>
        <% } %>

        <div class="model-specs">
          <h2>Specifications</h2>
          <div class="specs-grid">
            <% (detailContent.formatNotes || []).forEach(function(note) { %>
              <div class="spec-item">
                <span class="spec-label"><%= note.label %></span>
                <span class="spec-value"><%= note.value %></span>
              </div>
            <% }); %>
            <% if (model.file_size) { %>
              <div class="spec-item">
                <span class="spec-label">File Size</span>
                <span class="spec-value"><%= model.file_size %></span>
              </div>
            <% } %>
          </div>
        </div>

        <% if (detailContent.tagList && detailContent.tagList.length) { %>
          <div class="model-keyword-list" aria-label="Related model topics">
            <% detailContent.tagList.forEach(function(tag) { %>
              <span><%= tag %></span>
            <% }); %>
          </div>
        <% } %>

        <% if (relatedLinks.length) { %>
          <nav class="model-intent-links" aria-label="Related 3D clothing resources">
            <% relatedLinks.forEach(function(link) { %>
              <a href="<%= link.href %>"><%= link.label %></a>
            <% }); %>
          </nav>
        <% } %>

      </div>
    </div>
  </div>
</section>

<!-- Searchable model assets -->
<section class="model-showcase-section">
  <div class="container">
    <h2 class="section-title"><%= model.name %> model views</h2>
    <p class="section-subtitle">Inspect the garment preview, UV artwork layout, and side silhouette before customizing the model.</p>
    
    <div class="showcase-grid">
      <% if (model.image_url) { %>
        <div class="showcase-item">
          <div class="showcase-image">
            <img src="<%= model.image_url %>" alt="<%= model.name %> front 3D apparel mockup preview" loading="lazy">
          </div>
          <span class="showcase-label">Garment preview</span>
        </div>
      <% } %>
      <% if (model.texture_url) { %>
        <div class="showcase-item showcase-texture-item">
          <div class="showcase-image">
            <img src="<%= model.texture_url %>" alt="<%= model.name %> UV texture and artwork placement layout" loading="lazy">
          </div>
          <span class="showcase-label">UV artwork layout</span>
        </div>
      <% } %>
      <div class="showcase-item">
          <div class="showcase-image model-side-stage">
            <% if (previewModelFileUrl) { %>
              <img class="model-side-poster" src="<%= model.image_url %>" alt="<%= model.name %> side-view loading preview" loading="lazy" decoding="async">
              <model-viewer
                class="model-viewer-natural showcase-side-viewer"
                data-model-src="<%= previewModelFileUrl %>"
                poster="<%= model.image_url %>"
                alt="<%= model.name %> side silhouette 3D view"
              loading="lazy"
              reveal="interaction"
              camera-controls
              camera-orbit="90deg 75deg 112%"
              shadow-intensity="1.2"
                exposure="0.72"
                environment-image="neutral"
                hidden
              ></model-viewer>
          <% } %>
        </div>
        <span class="showcase-label">Side silhouette</span>
      </div>
    </div>
  </div>
</section>

<% if (howToSteps.length || applications.length || faqItems.length || detailContent.geoSummary) { %>
<section class="model-seo-section generator-section">
  <div class="container">
    <% if (howToSteps.length) { %>
      <div class="model-seo-block model-howto-section">
        <div class="generator-section-header">
          <span class="generator-eyebrow">Design workflow</span>
          <h2>How to design <%= model.name %></h2>
          <p>Use the browser-based Design3D studio to customize the model, review the garment preview, and export a high-resolution render.</p>
        </div>
        <div class="pattern-step-card-grid">
          <% howToSteps.forEach(function(step, index) { %>
            <% const icon = howToIcons[index] || 'inspect'; %>
            <% const stepTitle = step.name || step.title; %>
            <% const stepText = step.text || step.body; %>
            <article class="pattern-step-card">
              <div class="pattern-step-media pattern-step-media-<%= icon %>">
                <span><%= String(index + 1).padStart(2, '0') %></span>
                <% if (icon === 'download') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <rect x="16" y="14" width="52" height="56" rx="6"/>
                    <path d="M40 22v25"/>
                    <path d="m29 38 11 11 11-11"/>
                    <path d="M27 59h26"/>
                  </svg>
                <% } else if (icon === 'open') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <rect x="12" y="18" width="56" height="44" rx="6"/>
                    <path d="M12 31h56"/>
                    <path d="M27 49h16"/>
                    <path d="M47 41l10 8-10 8"/>
                  </svg>
                <% } else if (icon === 'simulate') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <path d="M19 55c8-22 20-31 37-31"/>
                    <path d="M51 19h11v11"/>
                    <circle cx="24" cy="56" r="6"/>
                    <circle cx="55" cy="25" r="6"/>
                    <path d="M35 56h22"/>
                  </svg>
                <% } else { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <path d="M18 18h20v20H18z"/>
                    <path d="M42 18h20v20H42z"/>
                    <path d="M18 42h20v20H18z"/>
                    <path d="M42 42h20v20H42z"/>
                    <path d="M25 28h6M49 28h6M25 52h6M49 52h6"/>
                  </svg>
                <% } %>
              </div>
              <div class="pattern-step-copy">
                <h3><%= stepTitle %></h3>
                <p><%= stepText %></p>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (detailContent.geoSummary) { %>
      <div class="model-seo-block model-geo-summary">
        <div class="generator-section-header">
          <span class="generator-eyebrow">AI overview</span>
          <h2><%= model.name %> summary</h2>
          <p><%= detailContent.geoSummary %></p>
        </div>
      </div>
    <% } %>

    <% if (applications.length) { %>
      <div class="model-seo-block">
        <div class="generator-section-header">
          <span class="generator-eyebrow">Applications</span>
          <h2>Where this model works best</h2>
        </div>
        <div class="generator-output-grid model-application-grid">
          <% applications.forEach(function(application) { %>
            <article class="generator-output-card">
              <h3><%= application.title %></h3>
              <p><%= application.text || application.body %></p>
            </article>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (faqItems.length) { %>
      <div class="model-seo-block model-faq-section generator-faq-section">
        <div class="generator-section-header">
          <span class="generator-eyebrow">FAQ</span>
          <h2><%= model.name %> questions</h2>
        </div>
        <div class="generator-faq-list">
          <% faqItems.forEach(function(item, index) { %>
            <details class="generator-faq-item" <%= index === 0 ? 'open' : '' %>>
              <summary><%= item.question %></summary>
              <p><%= item.answer %></p>
            </details>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- Related Models -->
<% if (related && related.length > 0) { %>
<section class="related-models-section">
  <div class="container">
    <h2 class="section-title">Related <%= model.category_label || model.category %> 3D Models</h2>
    
    <div class="models-grid">
      <% related.forEach(function(item) { %>
        <a href="/3d-models/<%= item.category_slug || item.category %>/<%= item.slug %>" class="model-card">
          <div class="model-preview-3d">
            <% if (item.image_url) { %>
              <img src="<%= item.image_url %>" alt="Free <%= item.name %> 3D model and apparel mockup" class="model-img" loading="lazy">
            <% } else { %>
              <div class="model-placeholder">
                <span><%= item.name.charAt(0) %></span>
              </div>
            <% } %>
          </div>
          <div class="model-info">
            <h3 class="model-name"><%= item.name %></h3>
            <div class="model-tags">
              <span class="tag tag-free">Free</span>
            </div>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (detailCta.title || detailCta.text) { %>
<section class="model-detail-cta">
  <div class="container">
    <div class="pattern-design-cta-inner">
      <div>
        <span class="generator-eyebrow">Design 3D</span>
        <h2><%= detailCta.title || ('Customize ' + model.name) %></h2>
        <p><%= detailCta.text || 'Open the 3D design studio, apply artwork, and export a review-ready transparent PNG.' %></p>
      </div>
      <button class="btn btn-primary btn-large" id="designCtaBtn">Start Designing</button>
    </div>
  </div>
</section>
<% } %>

<!-- Customization Inquiry Modal -->
<div class="customization-modal" id="customizationInquiryModal" role="dialog" aria-modal="true" aria-labelledby="customizationInquiryTitle" aria-hidden="true">
  <button class="customization-modal-overlay" id="customizationInquiryOverlay" type="button" aria-label="Close customization request"></button>
  <div class="customization-modal-content">
    <header class="customization-modal-header">
      <div>
        <span>Production inquiry</span>
        <h2 id="customizationInquiryTitle">Request customization</h2>
        <p>Tell us how to reach you and the quantity you need. Your current design will be attached automatically.</p>
      </div>
      <button class="customization-modal-close" id="customizationInquiryClose" type="button" aria-label="Close customization request">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="customization-modal-body">
      <form class="customization-form" id="customizationInquiryForm">
        <div class="customization-form-grid">
          <label class="customization-field">
            <span>Contact name <b>*</b></span>
            <input type="text" name="name" autocomplete="name" maxlength="100" required placeholder="Your name">
          </label>
          <label class="customization-field">
            <span>Email <b>*</b></span>
            <input type="email" name="email" autocomplete="email" maxlength="180" required placeholder="you@example.com">
          </label>
          <label class="customization-field customization-field-quantity">
            <span>Customization quantity <b>*</b></span>
            <input type="number" name="quantity" min="1" max="1000000" step="1" inputmode="numeric" required placeholder="e.g. 500">
          </label>
          <label class="customization-field customization-field-wide">
            <span>Requirements</span>
            <textarea name="notes" maxlength="3000" rows="4" placeholder="Tell us about fabric, colors, sizes, delivery market, timeline, or other production requirements."></textarea>
          </label>
          <label class="customization-honeypot" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </label>
        </div>

        <section class="customization-attachments" aria-labelledby="customizationAttachmentsTitle">
          <div class="customization-section-heading">
            <div>
              <span>Design attachments</span>
              <h3 id="customizationAttachmentsTitle">Current 3D and 2D design</h3>
            </div>
            <button type="button" class="customization-refresh" id="customizationRefreshSnapshots">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 11a8 8 0 10-2.34 5.66M20 4v7h-7"/>
              </svg>
              Refresh
            </button>
          </div>
          <div class="customization-preview-grid">
            <figure class="customization-preview-card">
              <div class="customization-preview-media">
                <img id="customizationPreview3d" alt="Current 3D clothing design screenshot">
                <div class="customization-preview-loading" id="customizationPreview3dLoading">
                  <span class="customization-spinner" aria-hidden="true"></span>
                  <span>Rendering 3D view…</span>
                </div>
              </div>
              <figcaption><strong>3D design</strong><span>High-resolution garment view</span></figcaption>
            </figure>
            <figure class="customization-preview-card">
              <div class="customization-preview-media">
                <img id="customizationPreview2d" alt="Current 2D texture layout screenshot">
                <div class="customization-preview-loading" id="customizationPreview2dLoading">
                  <span class="customization-spinner" aria-hidden="true"></span>
                  <span>Capturing 2D layout…</span>
                </div>
              </div>
              <figcaption><strong>2D design</strong><span>Artwork and panel layout</span></figcaption>
            </figure>
          </div>
        </section>

        <p class="customization-form-status" id="customizationInquiryStatus" role="alert" aria-live="polite"></p>
        <footer class="customization-form-actions">
          <p>We use these details only to respond to this customization request.</p>
          <div>
            <button type="button" class="btn btn-secondary" id="customizationInquiryCancel">Cancel</button>
            <button type="submit" class="btn btn-primary" id="customizationInquirySubmit" disabled>
              <span>Submit request</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </button>
          </div>
        </footer>
      </form>

      <section class="customization-success" id="customizationInquirySuccess" hidden>
        <div class="customization-success-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </div>
        <span>Request received</span>
        <h3>Thank you — we’ll be in touch.</h3>
        <p>Our team will reply within <strong>3 business days</strong>. Please watch your email messages.</p>
        <div class="customization-reference">
          <span>Reference</span>
          <strong id="customizationInquiryReference">—</strong>
        </div>
        <button type="button" class="btn btn-primary" id="customizationInquiryDone">Done</button>
      </section>
    </div>
  </div>
</div>

<% if (supportsOnModelMockup) { %>
<!-- On-model T-shirt Mockup Studio -->
<div
  class="model-mockup-modal"
  id="modelMockupModal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="modelMockupTitle"
  aria-hidden="true"
  data-base-image="<%= modelMockupProfile.assetBase %>-base.png"
  data-mask-image="<%= modelMockupProfile.assetBase %>-mask.png"
  data-depth-image="<%= modelMockupProfile.assetBase %>-depth.png"
>
  <div class="model-mockup-shell">
    <header class="model-mockup-header">
      <div class="model-mockup-heading">
        <span class="model-mockup-mark" aria-hidden="true">M</span>
        <div>
          <span>On-model studio</span>
          <h2 id="modelMockupTitle">T-shirt depth mockup</h2>
        </div>
      </div>
      <div class="model-mockup-pipeline" aria-label="Mockup rendering pipeline">
        <span><i></i> Garment mask</span>
        <span><i></i> Fold depth</span>
        <span><i></i> Live composite</span>
      </div>
      <div class="model-mockup-header-actions">
        <button type="button" class="model-mockup-quiet-button" id="modelMockupReset">Reset</button>
        <button type="button" class="btn btn-primary" id="modelMockupDownload" disabled>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"/>
          </svg>
          Download mockup
        </button>
        <button type="button" class="model-mockup-close" id="modelMockupClose" aria-label="Close on-model mockup studio">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </header>

    <div class="model-mockup-body">
      <aside class="model-mockup-controls">
        <div class="model-mockup-intro">
          <span>01 / Artwork</span>
          <h3>Place your design</h3>
          <p>Upload a PNG, JPG, or WebP. Transparent PNG artwork gives the cleanest result.</p>
        </div>

        <label class="model-mockup-upload" id="modelMockupUploadZone">
          <input type="file" id="modelMockupArtworkInput" accept="image/png,image/jpeg,image/webp">
          <span class="model-mockup-upload-icon">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/>
            </svg>
          </span>
          <span>
            <strong id="modelMockupUploadLabel">Upload artwork</strong>
            <small>or drop an image here · max 10 MB</small>
          </span>
        </label>

        <div class="model-mockup-control-section">
          <div class="model-mockup-section-label">
            <span>02 / Placement</span>
            <button type="button" id="modelMockupCenter">Center</button>
          </div>
          <label class="model-mockup-range">

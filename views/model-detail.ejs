<%- include('partials/header', {
  bodyClass: 'category-catalog-page model-product-page',
  pageStyles: ['/css/model-detail-v2.css?v=20260922-shared-login-v42', '/css/cloz-dropdown.css?v=20260924-v1', '/css/model-export-modal.css?v=20260925-share-create-v17']
}) %>
<% const detailContent = modelDetailContent || {}; %>
<% const previewModelFileUrl = model.preview_file_url || model.file_url; %>
<% const howToSteps = detailContent.howToSteps || []; %>
<% const applications = detailContent.applications || []; %>
<% const faqItems = detailContent.faqItems || []; %>
<% const relatedLinks = detailContent.relatedLinks || []; %>
<% const detailCta = detailContent.cta || {}; %>
<% const howToIcons = ['open', 'inspect', 'simulate', 'download']; %>
<% const modelMockupProfile = typeof onModelMockupProfile !== 'undefined' ? onModelMockupProfile : null; %>
<% const supportsOnModelMockup = Boolean(modelMockupProfile); %>
<% const tryOnModels = typeof aiTryOnModels !== 'undefined' && Array.isArray(aiTryOnModels) ? aiTryOnModels : []; %>
<% const aiTryOnAvailable = typeof aiTryOnEnabled !== 'undefined' && Boolean(aiTryOnEnabled); %>
<% const modelDisplayName = String(model.name || '').replace(/\s+(?:3D\s+)?(?:Garment\s+)?Model$/i, ''); %>
<% const modelCategoryName = model.category_label || model.category || 'Apparel'; %>
<% const modelDetailPath = `/3d-models/${model.category_slug || model.category}/${model.slug}`; %>
<% const aiTryOnPath = `${modelDetailPath}/try-on`; %>

<section class="model-detail-hero">
  <div class="container">
    <nav class="model-breadcrumb" aria-label="Breadcrumb">
      <a href="/mockups">3D Models</a><span>/</span>
      <a href="/mockups/<%= model.category_slug || model.category %>"><%= model.category_label || model.category %></a><span>/</span>
      <span><%= modelDisplayName %></span>
    </nav>
    <div class="model-detail-grid">
      <div class="model-info-section" role="region" aria-label="Model overview">
        <span class="model-product-kicker">Digital atelier / <%= modelCategoryName %></span>
        <h1 class="model-detail-title"><%= modelDisplayName %></h1>
        <div class="model-detail-meta" aria-label="Model capabilities">
          <span class="tag tag-free">Free 3D model</span>
        </div>
        <div class="model-actions model-action-grid">
          <button class="detail-action detail-action-primary" id="designNowBtn" type="button">
            <span>Edit in 3D</span>
            <svg class="detail-action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
          </button>
          <% if (previewModelFileUrl) { %>
            <button class="detail-action" id="renderCurrentModelBtn" type="button">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><circle cx="9" cy="10" r="2"/><path d="m5 17 4-4 3 3 2-2 5 3"/></svg>
              <span>Export</span>
            </button>
          <% } %>
          <% if (aiTryOnAvailable && previewModelFileUrl) { %>
            <a class="detail-action" id="detailAiTryOnBtn" href="<%= aiTryOnPath %>" data-ai-try-on-link>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/></svg>
              <span>AI Try-on</span>
            </a>
          <% } %>
          <button class="detail-action" id="customizationInquiryBtn" type="button">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 20V8l4-3v4l5-4v4l7-4v15H4Z"/><path d="M8 14h2m3 0h2m3 0h2"/></svg>
            <span>Production</span>
          </button>
        </div>
        <span class="download-render-status" id="downloadRenderStatus" aria-live="polite"></span>
      </div>

      <div class="model-viewer-section">
        <div class="model-3d-viewer<%= previewModelFileUrl ? ' is-loading' : '' %>" id="model3dViewer" aria-busy="<%= previewModelFileUrl ? 'true' : 'false' %>">
          <% if (previewModelFileUrl) { %>
            <model-viewer 
              class="model-viewer-natural"
              data-entitlement-texture-watermark
              src="<%= previewModelFileUrl %>"
              poster="<%= model.image_url %>"
              alt="<%= model.name %> interactive 3D clothing model and apparel mockup"
              loading="eager"
              reveal="auto"
              camera-controls
              disable-tap
              disable-zoom
              camera-orbit="0deg 72deg 142%"
              camera-target="auto auto auto"
              field-of-view="28deg"
              shadow-intensity="0.32"
              shadow-softness="0.9"
              exposure="2"
              environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
              data-camera-relative-studio-light="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
              data-studio-light-reference-azimuth="-16"
              data-studio-light-azimuth-offset="45"
              tone-mapping="commerce"
              data-catalog-render-standard="main"
              style="width: 100%; height: 100%;"
            ></model-viewer>
            <span class="model-contact-shadow" aria-hidden="true"></span>
            <div class="model-viewer-spinner" role="status" aria-live="polite">
              <i aria-hidden="true"></i>
              <span>Loading 3D</span>
            </div>
          <% } else { %>
            <div class="model-viewer-placeholder">
              <img src="<%= model.image_url %>" alt="<%= model.name %>" class="model-preview-img">
            </div>
          <% } %>
        </div>
        <aside class="viewer-lighting-panel" id="quickLightingPanel" aria-label="Studio lighting">
          <div class="quick-light-panel-header">
            <strong>Lighting</strong>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
          </div>
          <div class="quick-light-color"><i aria-hidden="true"></i><span><strong>Neutral White</strong><small>Pure white · no color cast</small></span></div>
          <div class="quick-light-presets" role="group" aria-label="Light direction presets">
            <button type="button" data-light-angle="-45" aria-pressed="false"><i aria-hidden="true"></i><span>−45°</span></button>
            <button type="button" data-light-angle="0" aria-pressed="false"><i aria-hidden="true"></i><span>Front</span></button>
            <button type="button" class="active" data-light-angle="45" aria-pressed="true"><i aria-hidden="true"></i><span>+45°</span></button>
          </div>
          <label class="quick-light-range">
            <span>Brightness <output id="quickLightExposureOutput">200%</output></span>
            <input id="quickLightExposure" type="range" min="55" max="300" step="1" value="200">
          </label>
          <label class="quick-light-range">
            <span>Softness <output id="quickLightSoftnessOutput">90%</output></span>
            <input id="quickLightSoftness" type="range" min="50" max="100" step="1" value="90">
          </label>
        </aside>
        <div class="model-quick-style" aria-label="Quick garment styling">
          <div class="quick-style-shelf">
            <div class="quick-style-fabric">
              <button class="quick-style-fabric-toggle" id="quickFabricToggle" type="button" aria-expanded="false" aria-controls="quickFabricMenu">
                <span class="quick-style-label">Fabric</span>
                <span class="quick-style-value"><i id="quickFabricPreview" aria-hidden="true"></i><strong id="quickFabricName">Cotton</strong><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3"/></svg></span>
              </button>
              <div class="quick-fabric-menu" id="quickFabricMenu" hidden>
                <% [
                  ['cotton-jersey', 'Cotton', '/images/material-previews/cotton.webp'],
                  ['rib-knit', 'Jersey', '/images/material-previews/jersey.webp'],
                  ['linen', 'Linen', '/images/material-previews/linen.webp'],
                  ['fleece', 'Fleece', '/images/material-previews/fleece.webp'],
                  ['denim', 'Denim', '/images/material-previews/denim.webp'],
                  ['satin-silk', 'Satin', '/images/material-previews/satin.webp']
                ].forEach(function(material, index) { %>
                  <button type="button" class="<%= index === 0 ? 'active' : '' %>" data-quick-material="<%= material[0] %>" data-material-name="<%= material[1] %>" data-material-preview="<%= material[2] %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>">
                    <i style="--material-preview:url('<%= material[2] %>')" aria-hidden="true"></i><span><%= material[1] %></span>
                  </button>
                <% }); %>
              </div>
            </div>
            <div class="quick-style-control quick-style-color" role="group" aria-label="Garment color">
              <span class="quick-style-label">Color</span>
              <div class="quick-color-swatches">
                <% [
                  ['#d8c5b1', 'Warm beige'],
                  ['#f5f4ef', 'Ivory'],
                  ['#c9cbca', 'Silver gray'],
                  ['#252625', 'Black'],
                  ['#667054', 'Olive']
                ].forEach(function(color, index) { %>
                  <button type="button" class="<%= index === 0 ? 'active' : '' %>" data-quick-color="<%= color[0] %>" style="--quick-color:<%= color[0] %>" aria-label="<%= color[1] %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>"></button>
                <% }); %>
              </div>
            </div>
            <div class="quick-style-control quick-style-background" role="group" aria-label="Scene background">
              <span class="quick-style-label">Background</span>
              <div class="quick-background-swatches">
                <button type="button" class="active" data-hero-background="#f5f3ef" style="--swatch:#f5f3ef" aria-label="Warm studio" aria-pressed="true"></button>
                <button type="button" data-hero-background="#ffffff" style="--swatch:#ffffff" aria-label="White studio" aria-pressed="false"></button>
                <button type="button" data-hero-background="#d8d9d7" style="--swatch:#d8d9d7" aria-label="Soft gray" aria-pressed="false"></button>
                <button type="button" data-hero-background="#a8aaa8" style="--swatch:#a8aaa8" aria-label="Slate gray" aria-pressed="false"></button>
              </div>
            </div>
          </div>
          <a
            class="quick-style-upgrade"
            id="removeWatermarkBtn"
            data-upgrade-resource="watermark"
            href="/pricing?source=model-detail&amp;intent=remove-watermark&amp;model=<%= encodeURIComponent(model.slug) %>"
            data-analytics-event="remove_watermark_upgrade_click"
            data-analytics-item="Watermark-free exports"
            data-analytics-category="upgrade"
            data-id="<%= model.slug %>"
          >
            <svg class="detail-action-upgrade-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 9.8 8.8 4 11l5.8 2.2L12 19l2.2-5.8L20 11l-5.8-2.2L12 3Z"/><path d="m18.5 3 .7 1.8L21 5.5l-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8Z"/></svg>
            <span><strong>No Watermark</strong><small>Pro &amp; Max</small></span>
            <svg class="detail-action-upgrade-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
          </a>
        </div>
        <button class="viewer-internal-control" id="rotateBtn" type="button" aria-pressed="false" aria-hidden="true" tabindex="-1" hidden>Rotate</button>
        <button class="viewer-internal-control" id="fabricMotionBtn" type="button" aria-pressed="false" aria-hidden="true" tabindex="-1" hidden>Fabric Motion</button>
      </div>
    </div>
    <% if (supportsOnModelMockup) { %><button type="button" id="modelMockupBtn" hidden aria-hidden="true" tabindex="-1">Open model preview</button><% } %>
  </div>
</section>

<section class="experience-flow" aria-labelledby="experienceFlowTitle">
  <div class="container">
    <h2 id="experienceFlowTitle">From a blank garment to a worn campaign</h2>
    <div class="experience-flow-steps">
      <article>
        <span>01</span>
        <svg class="flow-icon flow-icon-edit" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 5.5 18.5.5l5 5-5 5M13.5 5.5 3 16l-1.5 6.5L8 21l10.5-10.5M12 3H3a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-9"/></svg>
        <h3>Customize</h3><p>Edit every surface. Add materials, artwork, and details.</p>
      </article>
      <article>
        <span>02</span>
        <svg class="flow-icon flow-icon-person" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="6.5" r="4.5"/><path d="M3 22c.7-5.2 3.7-8 9-8s8.3 2.8 9 8H3Z"/></svg>
        <% if (aiTryOnAvailable) { %>
          <h3>Try on</h3><p>See your design on real models with AI try-on.</p>
        <% } else { %>
          <h3>Render</h3><p>Create a studio-quality product image from the angle you choose.</p>
        <% } %>
      </article>
      <article>
        <span>03</span>
        <svg class="flow-icon flow-icon-eye" viewBox="0 0 28 20" aria-hidden="true"><path d="M1 10S5.6 2.5 14 2.5 27 10 27 10s-4.6 7.5-13 7.5S1 10 1 10Z"/><circle cx="14" cy="10" r="3.5"/></svg>
        <h3>Review</h3><p>Refine the look, fit, and story before production.</p>
      </article>
      <article>
        <span>04</span>
        <svg class="flow-icon flow-icon-factory" viewBox="0 0 26 24" aria-hidden="true"><path d="M1 23V8l7 5V8l7 5V2h5v11l5-3v13H1Z"/><path d="M6 18h3M13 18h3M20 18h2"/></svg>
        <h3>Produce</h3><p>Connect with our team to bring it to life.</p>
      </article>
    </div>
  </div>
</section>

<section class="detail-customize-feature" aria-labelledby="customizeFeatureTitle">
  <div class="container detail-feature-grid">
    <div class="detail-feature-copy">
      <h2 id="customizeFeatureTitle">Every surface<br>is a decision</h2>
      <p>Use our 3D studio to customize every detail of the garment. Fabrics, colors, prints, type, and trims—your vision, precisely where you want it.</p>
      <button class="feature-cta" id="customizeFeatureBtn" type="button">Open 3D studio</button>
    </div>
    <div class="studio-concept-card" aria-label="3D design studio preview">
      <div class="studio-concept-toolbar"><span>← Back to library</span><strong><%= modelDisplayName %></strong><span><i></i> All changes saved</span></div>
      <div class="studio-concept-body">
        <div class="studio-tool-list"><span class="active">Select</span><span>Surface</span><span>Material</span><span>Color</span><span>Artwork</span><span>Text</span><span>Details</span><span>Layers</span><span>Export</span></div>
        <div class="studio-garment-preview"><img src="<%= model.image_url %>" alt="<%= modelDisplayName %> design preview" loading="lazy"><span class="studio-selection-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span></div>
        <div class="studio-property-panel">
          <span>Surface</span><strong>Front panel</strong>
          <span>Material</span><strong>Linen blend</strong>
          <div class="studio-material-row"><i></i><i></i><i></i><i></i><i></i></div>
          <span>Color</span><div class="studio-color-row"><i></i><i></i><i></i><i></i><i></i><i></i></div>
          <span>Artwork</span><strong>Brush stroke 02.png</strong>
          <span>Type</span><strong>ClozDesign Atelier</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (aiTryOnAvailable && supportsOnModelMockup && tryOnModels.length) { %>
<section class="ai-tryon-feature" aria-labelledby="aiTryOnFeatureTitle">
  <div class="container ai-tryon-feature-grid">
    <div class="ai-tryon-copy">
      <h2 id="aiTryOnFeatureTitle">See the design<br>on someone</h2>
      <p>AI try-on shows how your design looks on real people with realistic fit, drape, and light. Choose a model, pose, and scene that matches your story.</p>
      <span class="ai-fitted-badge"><i></i> AI fitted</span>
      <a class="feature-cta feature-cta-light" href="<%= aiTryOnPath %>" data-ai-try-on-link>Choose a model</a>
    </div>
    <div class="ai-model-panel">
      <div class="ai-model-tabs"><span class="active">Models</span><span>Poses</span><span>Scenes</span></div>
      <p>Select a model</p>
      <div class="ai-avatar-grid">
        <% tryOnModels.slice(0, 6).forEach(function(tryOnModel, index) { %>
          <% const displayModelName = String(tryOnModel.title || 'Model').replace(/^Model\s+\d+\s+/i, '').split(/\s+(?:Female|Male|Front|Walking|From3d)/i)[0]; %>
          <button type="button" class="<%= index === 0 ? 'active' : '' %>" disabled aria-disabled="true"><img src="<%= tryOnModel.base_image_url %>" alt="<%= displayModelName %>" loading="lazy"><span><%= displayModelName %></span></button>
        <% }); %>
      </div>
      <dl><div><dt>Height</dt><dd>178 cm</dd></div><div><dt>Size</dt><dd>S</dd></div><div><dt>Body type</dt><dd>Athletic</dd></div></dl>
    </div>
    <div class="ai-model-stage">
      <img id="aiFeaturePreview" src="<%= tryOnModels[0].base_image_url %>" alt="AI try-on model preview" loading="lazy">
      <div class="ai-stage-thumbnails">
        <% tryOnModels.slice(0, 4).forEach(function(tryOnModel, index) { %><button type="button" class="<%= index === 0 ? 'active' : '' %>" disabled aria-disabled="true"><img src="<%= tryOnModel.base_image_url %>" alt="View <%= index + 1 %>" loading="lazy"></button><% }); %>
      </div>
    </div>
  </div>
</section>
<% } %>

<section class="production-feature" aria-labelledby="productionFeatureTitle">
  <div class="container production-feature-grid">
    <div class="production-title-wrap"><span class="production-icon" aria-hidden="true">⌁</span><h2 id="productionFeatureTitle">When the design is ready,<br>talk to people who can make it</h2></div>
    <div class="production-copy"><p>Our production experts will review your design and recommend the best materials, techniques, and factories for your goals.</p><button class="feature-cta production-cta" id="productionFeatureBtn" type="button">Request custom production</button></div>
    <div class="production-promises"><span>Your design file and notes will be attached automatically.</span><span>We’ll reply within 3 business days.</span><span>Confidential, professional, and global.</span></div>
  </div>
</section>

<section class="model-technical-section" aria-labelledby="modelTechnicalTitle">
  <div class="container model-technical-grid">
    <div>
      <span class="detail-eyebrow">Garment details</span>
      <h2 id="modelTechnicalTitle">Built to inspect.<br>Ready to render.</h2>
      <% if (detailContent.searchIntentSummary) { %><p><%= detailContent.searchIntentSummary %></p><% } %>
    </div>
    <div class="model-specs">
      <h3>Technical specifications</h3>
      <div class="specs-grid">
        <% (detailContent.formatNotes || []).forEach(function(note) { %><div class="spec-item"><span class="spec-label"><%= note.label %></span><span class="spec-value"><%= note.value %></span></div><% }); %>
        <% if (model.poly_count) { %><div class="spec-item"><span class="spec-label">Geometry</span><span class="spec-value"><%= model.poly_count %></span></div><% } %>
        <% if (model.file_size) { %><div class="spec-item"><span class="spec-label">File size</span><span class="spec-value"><%= model.file_size %></span></div><% } %>
      </div>
      <% if (relatedLinks.length) { %><nav class="model-intent-links" aria-label="Related 3D clothing resources"><% relatedLinks.forEach(function(link) { %><a href="<%= link.href %>"><%= link.label %></a><% }); %></nav><% } %>
    </div>
  </div>
</section>

<% if (howToSteps.length || applications.length || faqItems.length || detailContent.geoSummary) { %>
<section class="model-seo-section generator-section">
  <div class="container">
    <% if (howToSteps.length) { %>
      <div class="model-seo-block model-howto-section">
        <div class="generator-section-header">
          <span class="generator-eyebrow">Design workflow</span>
          <h2>From model to finished mockup</h2>
          <p>Customize the garment, inspect every angle, and export a presentation-ready visual.</p>
        </div>
        <div class="pattern-step-card-grid">
          <% howToSteps.forEach(function(step, index) { %>
            <% const icon = howToIcons[index] || 'inspect'; %>
            <% const stepTitle = step.name || step.title; %>
            <% const stepText = step.text || step.body; %>
            <article class="pattern-step-card">
              <div class="pattern-step-media pattern-step-media-<%= icon %>">
                <span><%= String(index + 1).padStart(2, '0') %></span>
                <% if (icon === 'download') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <rect x="16" y="14" width="52" height="56" rx="6"/>
                    <path d="M40 22v25"/>
                    <path d="m29 38 11 11 11-11"/>
                    <path d="M27 59h26"/>
                  </svg>
                <% } else if (icon === 'open') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <rect x="12" y="18" width="56" height="44" rx="6"/>
                    <path d="M12 31h56"/>
                    <path d="M27 49h16"/>
                    <path d="M47 41l10 8-10 8"/>
                  </svg>
                <% } else if (icon === 'simulate') { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <path d="M19 55c8-22 20-31 37-31"/>
                    <path d="M51 19h11v11"/>
                    <circle cx="24" cy="56" r="6"/>
                    <circle cx="55" cy="25" r="6"/>
                    <path d="M35 56h22"/>
                  </svg>
                <% } else { %>
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <path d="M18 18h20v20H18z"/>
                    <path d="M42 18h20v20H42z"/>
                    <path d="M18 42h20v20H18z"/>
                    <path d="M42 42h20v20H42z"/>
                    <path d="M25 28h6M49 28h6M25 52h6M49 52h6"/>
                  </svg>
                <% } %>
              </div>
              <div class="pattern-step-copy">
                <h3><%= stepTitle %></h3>
                <p><%= stepText %></p>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (detailContent.geoSummary) { %>
      <div class="model-seo-block model-geo-summary">
        <div class="generator-section-header">
          <span class="generator-eyebrow">AI overview</span>
          <h2><%= model.name %> summary</h2>
          <p><%= detailContent.geoSummary %></p>
        </div>
      </div>
    <% } %>

    <% if (applications.length) { %>
      <div class="model-seo-block model-applications-section">
        <div class="generator-section-header">
          <span class="generator-eyebrow">Applications</span>
          <h2>Built for real apparel decisions</h2>
        </div>
        <div class="generator-output-grid model-application-grid">
          <% applications.forEach(function(application) { %>
            <article class="generator-output-card">
              <h3><%= application.title %></h3>
              <p><%= application.text || application.body %></p>
            </article>
          <% }); %>
        </div>
      </div>
    <% } %>

    <% if (faqItems.length) { %>
      <div class="model-seo-block model-faq-section generator-faq-section">
        <div class="generator-section-header">
          <span class="generator-eyebrow">FAQ</span>
          <h2>Questions about this model</h2>
        </div>
        <div class="generator-faq-list">
          <% faqItems.forEach(function(item, index) { %>
            <details class="generator-faq-item" <%= index === 0 ? 'open' : '' %>>
              <summary><%= item.question %></summary>
              <p><%= item.answer %></p>
            </details>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- Related Models -->
<% if (related && related.length > 0) { %>
<section class="related-models-section">
  <div class="container">
    <h2 class="section-title">Related <%= modelCategoryName %> models</h2>
    
    <div class="models-grid">
      <% related.forEach(function(item) { %>
        <% const relatedDisplayName = String(item.name || '').replace(/\s+(?:3D\s+)?(?:Garment\s+)?Model$/i, ''); %>
        <a href="/3d-models/<%= item.category_slug || item.category %>/<%= item.slug %>" class="model-card">
          <div class="model-preview-3d">
            <% if (item.image_url) { %>
              <img src="<%= item.cover_image_url || item.image_url %>" alt="Free <%= item.name %> 3D model and apparel mockup" class="model-img" loading="lazy">
            <% } else { %>
              <div class="model-placeholder">
                <span><%= item.name.charAt(0) %></span>
              </div>
            <% } %>
          </div>
          <div class="model-info">
            <div>
              <h3 class="model-name"><%= relatedDisplayName %></h3>
              <span class="category-model-status">Free</span>
            </div>
            <span class="category-model-action">Open model <span aria-hidden="true">›</span></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (detailCta.title || detailCta.text) { %>

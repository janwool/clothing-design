      <i aria-hidden="true"></i>
      <span id="imageUploadToastText"></span>
    </div>
    <div class="design-modal-body">
      <div class="texture-designer">
        <!-- Editor Tool Rail -->
        <div class="designer-toolbar" aria-label="Design tools">
          <div class="toolbar-group">
            <button class="toolbar-btn active" id="toolAppearance" title="Appearance" type="button" aria-controls="designAppearancePanel" aria-pressed="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M8 4.5 10 3h4l2 1.5 4 1.8-2.2 4.2-2.3-1.1V21h-7V9.4l-2.3 1.1L4 6.3 8 4.5Z"/>
                <path d="M16.5 14.5h4M18.5 12.5v4"/>
              </svg>
              <span>Appearance</span>
            </button>
            <button class="toolbar-btn" id="toolImage" title="Add Image" type="button" aria-controls="imageAssetTray" aria-pressed="false">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Image</span>
            </button>
            <button class="toolbar-btn" id="toolText" title="Add Text" type="button">

        </div>
        <div class="model-mockup-stage" id="modelMockupStage">
          <canvas id="modelMockupCanvas" width="1024" height="1536" aria-label="T-shirt model mockup preview"></canvas>
          <div class="model-mockup-empty" id="modelMockupEmpty">

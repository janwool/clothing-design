<%- include('partials/header', { bodyClass: 'tmg-page', pageStyles: ['/css/tshirt-generator-landing.css?nav=20261011&v=20261011-black-photos-v20'] }) %>
<%
  const studio = toolPage.tshirtStudio;
  const tshirtModels = toolPage.modelStarters || [];
  const firstModel = tshirtModels[0];
  const blankModels = toolPage.blankModels || tshirtModels;
  const fitLabel = model => /ruffle/i.test(model.title) ? 'Ruffle trim' : /crop/i.test(model.title) ? (/three[- ]quarter/i.test(model.title) ? '¾ sleeve crop' : 'Fitted crop') : /fitted/i.test(model.title) ? 'Fitted' : /polo/i.test(model.title) ? 'Polo' : /long[- ]sleeve/i.test(model.title) ? 'Long sleeve' : /oversized|drop[- ]shoulder/i.test(model.title) ? 'Relaxed' : 'Regular';
  const isHub = toolPage.slug === 't-shirt-mockup-generator';
%>
<div class="tmg-landing" data-tmg-carousel data-color="<%= studio.color %>">
  <section class="tmg-hero tmg-section" aria-labelledby="tmg-title">
    <div class="tmg-shell tmg-hero-grid">
      <div class="tmg-hero-copy">
        <nav class="tmg-breadcrumb" aria-label="Breadcrumb"><a href="/tools">Tools</a><span aria-hidden="true">/</span><% if (!isHub) { %><a href="/tools/t-shirt-mockup-generator">T-shirt mockups</a><span aria-hidden="true">/</span><% } %><span><%= isHub ? 'T-shirt mockups' : studio.label %></span></nav>
        <h1 id="tmg-title"><% studio.heading.split('\n').forEach((line, index) => { %><% if (index) { %><br><% } %><%= line %><% }); %></h1>
        <p class="tmg-hero-lede"><%= studio.lede || toolPage.subtitle %></p>
        <div class="tmg-actions">
          <% if (firstModel) { %><a class="tmg-button tmg-button-dark tmg-editor-link" href="<%= firstModel.href %>#design">Customize this T-shirt <span aria-hidden="true">↗</span></a><% } %>
          <a class="tmg-text-link" href="/mockups">Explore the fits <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <% if (firstModel) { %>
      <div class="tmg-model-panel" aria-label="T-shirt garment preview">
        <div class="tmg-model-stage" aria-busy="true">
          <div class="tmg-model-track">
            <% tshirtModels.forEach((model, index) => { %>
            <div class="tmg-model-slide<%= index === 0 ? ' is-active' : '' %>" data-tmg-slide data-index="<%= index %>" data-position="<%= index === 0 ? 'active' : 'hidden-next' %>" aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
              <model-viewer class="tmg-model-viewer" src="<%= index === 0 ? model.modelSrc : '' %>" data-model-src="<%= model.modelSrc %>" alt="<%= model.title %> interactive preview" loading="<%= index === 0 ? 'eager' : 'lazy' %>" reveal="auto" camera-controls interaction-prompt="none" shadow-intensity="0.32" shadow-softness="0.9" exposure="0.82" environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr" data-camera-relative-studio-light="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr" data-studio-light-reference-azimuth="-16" data-studio-light-azimuth-offset="45" tone-mapping="commerce" camera-orbit="0deg 76deg 108%" min-camera-orbit="auto 55deg 85%" max-camera-orbit="auto 105deg 140%" tabindex="<%= index === 0 ? '0' : '-1' %>"></model-viewer>
            </div>
            <% }); %>
          </div>
          <div class="tmg-view-controls" role="group" aria-label="Garment view">
            <% [{name:'Front',orbit:'0deg 76deg 108%'},{name:'Back',orbit:'180deg 76deg 108%'},{name:'Side',orbit:'90deg 76deg 108%'}].forEach((view,index) => { %><button type="button" data-tmg-angle="<%= view.orbit %>" aria-pressed="<%= index === 0 %>"><%= view.name %></button><% }); %>
          </div>
          <div class="tmg-color-controls" role="group" aria-label="Preview garment color">
            <% [{name:'White',hex:'#f5f3ed'},{name:'Black',hex:'#171717'}].forEach(color => { %><button type="button" data-tmg-color="<%= color.hex %>" data-color-name="<%= color.name %>" aria-label="<%= color.name %> garment preview" aria-pressed="<%= studio.color === color.hex %>" style="--swatch:<%= color.hex %>"></button><% }); %>
          </div>
          <div class="tmg-model-loading" data-tmg-loading role="status" aria-label="Loading T-shirt"><span aria-hidden="true"></span></div>
          <div class="tmg-model-error" data-tmg-error hidden><p>Preview unavailable. You can still open the editor.</p><button type="button" data-tmg-retry>Retry preview</button></div>
        </div>
        <div class="tmg-model-controls">
          <div class="tmg-model-tabs" role="group" aria-label="Choose a T-shirt fit">
            <% tshirtModels.forEach((model,index) => { %><button type="button" class="tmg-model-tab<%= index === 0 ? ' is-active' : '' %>" aria-pressed="<%= index === 0 %>" data-tmg-model data-index="<%= index %>" data-title="<%= model.title %>" data-href="<%= model.href %>#design"><%= fitLabel(model) %></button><% }); %>
          </div>
          <p class="tmg-preview-caption" data-tmg-caption><%= firstModel.title %></p>
          <p class="tmg-drag-hint" data-tmg-status aria-live="polite" hidden></p>
        </div>
      </div>
      <% } else { %>
      <div class="tmg-empty"><img src="/images/mockups/generated/tshirt-pod-listing.webp" alt="Illustrative T-shirt artwork preview" width="640" height="800"><h2>No garment preview available.</h2><p>Browse the T-shirt library to choose another blank.</p><a class="tmg-text-link" href="/mockups/t-shirt-mockup">Browse T-shirts →</a></div>
      <% } %>
    </div>
  </section>

  <% if (isHub) { %>
  <section class="tmg-fit-section tmg-section" id="tshirt-fits" aria-labelledby="tmg-fit-title">
    <div class="tmg-shell">
      <div class="tmg-section-heading"><div><h2 id="tmg-fit-title">T-shirt styles</h2></div></div>
      <% if (blankModels.length) { %>
      <%- include('partials/tshirt-blank-gallery', { toolPage }) %>
      <% } else { %><p class="tmg-note">No previews available right now. <a href="/mockups/t-shirt-mockup">Browse the T-shirt library.</a></p><% } %>
    </div>
  </section>
  <% } else { %>
  <%- include('partials/tshirt-workflow-showcase', { toolPage }) %>
  <% } %>

  <%- include('partials/tshirt-fashion-gallery', { toolPage }) %>

  <section class="tmg-related tmg-section" aria-labelledby="tmg-related-title"><div class="tmg-shell"><div class="tmg-section-heading"><div><h2 id="tmg-related-title">T-shirt mockup options</h2></div></div><div class="tmg-related-grid"><% toolPage.tshirtWorkflows.filter(item => item.slug !== toolPage.slug).forEach(item => { %><a href="/tools/<%= item.slug %>"><div><h3><%= item.label %></h3><p><%= item.summary %></p></div><span aria-hidden="true">→</span></a><% }); %></div><div class="tmg-existing-links"><a href="/tools/oversized-t-shirt-mockup-generator">Oversized fits ↗</a><a href="/tools/front-and-back-t-shirt-mockup">Front &amp; back views ↗</a><a href="/tools/bulk-t-shirt-mockup-generator">Colorway sets ↗</a><a href="/tools/print-on-demand-mockup-generator">Print-on-demand ↗</a><% if (!isHub) { %><a href="/tools/t-shirt-mockup-generator">All T-shirt mockups ↗</a><% } %></div></div></section>

  <section class="tmg-faq tmg-section" aria-labelledby="tmg-faq-title"><div class="tmg-shell tmg-faq-grid"><div><h2 id="tmg-faq-title">Frequently asked questions</h2><a class="tmg-text-link" href="/pricing">View plans →</a></div><div class="tmg-faq-list"><% toolPage.faq.forEach((item,index) => { %><details><summary><%= item.question %><span aria-hidden="true">+</span></summary><p><%= item.answer %></p></details><% }); %></div></div></section>

</div>
<script>window.ModelViewerElement = window.ModelViewerElement || {}; window.ModelViewerElement.meshoptDecoderLocation = '/vendor/model-viewer/meshopt_decoder.js?v=three-0.183.0';</script>
<script src="/js/tshirt-generator-landing.js?v=20261011-black-photos-v20" defer></script>
<script type="module" data-tmg-runtime src="/vendor/model-viewer/model-viewer.min.js?v=4.3.1"></script>
<%- include('partials/footer') %>

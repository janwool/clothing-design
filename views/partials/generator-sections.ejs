<% const content = landingContent || {}; %>
<% const sectionCategories = categories || []; %>
<% const sectionModels = (typeof models !== 'undefined' ? models : (typeof items !== 'undefined' ? items : [])); %>
<% const sectionResourceType = typeof resourceType !== 'undefined' ? resourceType : '3d-models'; %>
<% const skipOutputSection = typeof skipOutput !== 'undefined' ? skipOutput : false; %>
<% const categoryHrefPrefix = sectionResourceType === 'patterns' ? '/patterns' : '/3d-models'; %>
<% const categoryItemLabel = sectionResourceType === 'patterns' ? 'patterns' : 'models'; %>
<% const fallbackMeta = sectionResourceType === 'patterns' ? 'ZPRJ patterns' : '3D models'; %>

<section class="generator-section generator-section-muted">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow"><%= content.workflow.eyebrow %></span>
      <h2><%= content.workflow.title %></h2>
      <% if (content.workflow.description) { %>
        <p><%= content.workflow.description %></p>
      <% } %>
    </div>

    <div class="generator-steps">
      <% content.workflow.steps.forEach(function(step, index) { %>
        <div class="generator-step">
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <h3><%= step.title %></h3>
          <p><%= step.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-section">
  <div class="container">
    <div class="generator-section-header generator-section-header-row">
      <div>
        <span class="generator-eyebrow"><%= content.categories.eyebrow %></span>
        <h2><%= content.categories.title %></h2>
      </div>
      <% if (content.categories.description) { %>
        <p><%= content.categories.description %></p>
      <% } %>
      <% if (content.categories.buttonLabel && content.categories.buttonHref) { %>
        <a href="<%= content.categories.buttonHref %>" class="btn btn-secondary"><%= content.categories.buttonLabel %></a>
      <% } %>
    </div>

    <div class="generator-category-grid">
      <% if (sectionCategories.length > 0) { %>
        <% sectionCategories.slice(0, 6).forEach(function(cat) { %>
          <% const categoryCount = sectionModels.filter(function(model) { return (model.category_slugs || []).includes(cat.slug) || (model.category_slug || model.category) === cat.slug || model.category === cat.name; }).length; %>
          <a href="<%= categoryHrefPrefix %>/<%= cat.slug %>" class="generator-category-card">
            <small><%= categoryCount || fallbackMeta %> <%= categoryCount ? categoryItemLabel : '' %></small>
            <strong><%= cat.name %></strong>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        <% }); %>
      <% } else { %>
        <% (content.categories.cards || []).forEach(function(card) { %>
          <a href="<%= card.href || content.categories.buttonHref || '#' %>" class="generator-category-card">
            <small><%= card.meta || fallbackMeta %></small>
            <strong><%= card.title %></strong>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<% if (!skipOutputSection) { %>
  <section class="generator-section generator-section-muted">
    <div class="container">
      <div class="generator-section-header">
        <span class="generator-eyebrow"><%= content.output.eyebrow %></span>
        <h2><%= content.output.title %></h2>
      </div>

      <div class="generator-output-grid">
        <% content.output.cards.forEach(function(card) { %>
          <div class="generator-output-card">
            <h3><%= card.title %></h3>
            <p><%= card.body %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<section class="generator-library-cta">
  <div class="container">
    <span class="generator-eyebrow"><%= content.library.eyebrow %></span>
    <h2><%= content.library.title %></h2>
    <% if (content.library.buttonLabel && content.library.buttonHref) { %>
      <a href="<%= content.library.buttonHref %>" class="btn btn-secondary"><%= content.library.buttonLabel %></a>
    <% } %>
  </div>
</section>

<section class="generator-section generator-faq-section">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow"><%= content.faq.eyebrow %></span>
      <h2><%= content.faq.title %></h2>
    </div>

    <div class="generator-faq-list">
      <% content.faq.items.forEach(function(item) { %>
        <details class="generator-faq-item">
          <summary><%= item.question %></summary>
          <p><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-final-cta">
  <div class="container">
    <div class="generator-final-cta-inner">
      <div>
        <span class="generator-eyebrow"><%= content.cta.eyebrow %></span>
        <h2><%= content.cta.title %></h2>
        <% if (content.cta.description) { %>
          <p><%= content.cta.description %></p>
        <% } %>
      </div>
      <div class="generator-final-actions">
        <% if (content.cta.primaryLabel && content.cta.primaryHref) { %>
          <a href="<%= content.cta.primaryHref %>" class="btn btn-primary"><%= content.cta.primaryLabel %></a>
        <% } %>
        <% if (content.cta.secondaryLabel && content.cta.secondaryHref) { %>
          <a href="<%= content.cta.secondaryHref %>" class="btn btn-secondary"><%= content.cta.secondaryLabel %></a>
        <% } %>
      </div>
    </div>
  </div>
</section>

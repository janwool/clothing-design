<% const content = landingContent || {}; %>
<% const workflow = content.workflow || { eyebrow: 'Workflow', title: 'Create apparel mockups from editable 3D clothing models', description: '', steps: [] }; %>
<% const categorySection = content.categories || { eyebrow: 'Categories', title: 'Browse related 3D model categories', description: '', cards: [] }; %>
<% const output = content.output || { eyebrow: 'Use cases', title: '3D models for apparel mockups', cards: [] }; %>
<% const library = content.library || { eyebrow: 'Library', title: 'Start from editable 3D garment models.', buttonLabel: 'Browse 3D Models', buttonHref: '/mockups' }; %>
<% const faq = content.faq || { eyebrow: 'FAQ', title: '3D clothing model questions', items: [] }; %>
<% const cta = content.cta || { eyebrow: 'Start creating', title: 'Open a model and create your next apparel mockup.', description: '', primaryLabel: 'Browse 3D Models', primaryHref: '/mockups' }; %>
<% const sectionCategories = categories || []; %>
<% const sectionModels = (typeof models !== 'undefined' ? models : (typeof items !== 'undefined' ? items : [])); %>
<% const sectionResourceType = typeof resourceType !== 'undefined' ? resourceType : '3d-models'; %>
<% const skipOutputSection = typeof skipOutput !== 'undefined' ? skipOutput : false; %>
<% const categoryHrefPrefix = sectionResourceType === 'patterns' ? '/patterns' : '/mockups'; %>
<% const categoryItemLabel = sectionResourceType === 'patterns' ? 'patterns' : 'models'; %>
<% const fallbackMeta = sectionResourceType === 'patterns' ? 'ZPRJ patterns' : '3D models'; %>

<section class="generator-section generator-section-muted">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow"><%= workflow.eyebrow %></span>
      <h2><%= workflow.title %></h2>
      <% if (workflow.description) { %>
        <p><%= workflow.description %></p>
      <% } %>
    </div>

    <div class="generator-steps">
      <% (workflow.steps || []).forEach(function(step, index) { %>
        <div class="generator-step <%= step.image_url ? 'generator-step-with-media' : '' %>">
          <% if (step.image_url) { %>
            <div class="generator-step-media">
              <img src="<%= step.image_url %>" alt="<%= step.title %> apparel mockup workflow step" loading="lazy">
            </div>
          <% } %>
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <h3><%= step.title %></h3>
          <p><%= step.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-section">
  <div class="container">
    <div class="generator-section-header generator-section-header-row">
      <div>
        <span class="generator-eyebrow"><%= categorySection.eyebrow %></span>
        <h2><%= categorySection.title %></h2>
      </div>
      <% if (categorySection.description) { %>
        <p><%= categorySection.description %></p>
      <% } %>
      <% if (categorySection.buttonLabel && categorySection.buttonHref) { %>
        <a href="<%= categorySection.buttonHref %>" class="btn btn-secondary"><%= categorySection.buttonLabel %></a>
      <% } %>
    </div>

    <div class="generator-category-grid">
      <% if (sectionCategories.length > 0) { %>
        <% sectionCategories.slice(0, 6).forEach(function(cat) { %>
          <% const categoryCount = sectionModels.filter(function(model) { return (model.category_slugs || []).includes(cat.slug) || (model.category_slug || model.category) === cat.slug || model.category === cat.name; }).length; %>
          <a href="<%= categoryHrefPrefix %>/<%= cat.slug %>" class="generator-category-card">
            <small><%= categoryCount || fallbackMeta %> <%= categoryCount ? categoryItemLabel : '' %></small>
            <strong><%= cat.name %></strong>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        <% }); %>
      <% } else { %>
        <% (categorySection.cards || []).forEach(function(card) { %>
          <a href="<%= card.href || categorySection.buttonHref || '#' %>" class="generator-category-card">
            <small><%= card.meta || fallbackMeta %></small>
            <strong><%= card.title %></strong>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<% if (!skipOutputSection) { %>
  <section class="generator-section generator-section-muted">
    <div class="container">
      <div class="generator-section-header">
        <span class="generator-eyebrow"><%= output.eyebrow %></span>
        <h2><%= output.title %></h2>
      </div>

      <div class="generator-output-grid">
        <% (output.cards || []).forEach(function(card) { %>
          <div class="generator-output-card <%= card.image_url ? 'generator-output-card-with-media' : '' %>">
            <% if (card.image_url) { %>
              <div class="generator-output-media">
                <img src="<%= card.image_url %>" alt="<%= card.title %> apparel mockup use case" loading="lazy">
              </div>
            <% } %>
            <h3><%= card.title %></h3>
            <p><%= card.body %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<section class="generator-library-cta">
  <div class="container">
    <span class="generator-eyebrow"><%= library.eyebrow %></span>
    <h2><%= library.title %></h2>
    <% if (library.buttonLabel && library.buttonHref) { %>
      <a href="<%= library.buttonHref %>" class="btn btn-secondary"><%= library.buttonLabel %></a>
    <% } %>
  </div>
</section>

<section class="generator-section generator-faq-section">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow"><%= faq.eyebrow %></span>
      <h2><%= faq.title %></h2>
    </div>

    <div class="generator-faq-list">
      <% (faq.items || []).forEach(function(item) { %>
        <details class="generator-faq-item">
          <summary><%= item.question %></summary>
          <p><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-final-cta">
  <div class="container">
    <div class="generator-final-cta-inner">
      <div>
        <span class="generator-eyebrow"><%= cta.eyebrow %></span>
        <h2><%= cta.title %></h2>
        <% if (cta.description) { %>
          <p><%= cta.description %></p>
        <% } %>
      </div>
      <div class="generator-final-actions">
        <% if (cta.primaryLabel && cta.primaryHref) { %>
          <a href="<%= cta.primaryHref %>" class="btn btn-primary"><%= cta.primaryLabel %></a>
        <% } %>
        <% if (cta.secondaryLabel && cta.secondaryHref) { %>
          <a href="<%= cta.secondaryHref %>" class="btn btn-secondary"><%= cta.secondaryLabel %></a>
        <% } %>
      </div>
    </div>
  </div>
</section>

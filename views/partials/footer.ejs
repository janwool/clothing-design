  <% const isHoodieFooter = typeof footerVariant !== 'undefined' && footerVariant === 'hoodie'; %>
  </main>

  <footer class="footer<%= isHoodieFooter ? ' footer-hoodie' : '' %>">
    <div class="footer-container">
      <div class="footer-grid">
        <!-- Brand -->
        <div class="footer-brand">
          <a href="/" class="footer-logo">ClozDesign</a>
          <p class="footer-desc">Professional clothing design tools and resources for designers worldwide.</p>
          <% if (isHoodieFooter) { %>
            <p class="footer-manifesto">Design. Visualize. Create. Repeat.</p>
          <% } %>
        </div>

        <!-- Product -->
        <div class="footer-column">
          <p class="footer-title">Product</p>
          <a href="/mockups" class="footer-link">3D Models</a>
          <a href="/white-mockups" class="footer-link">Fashion Mockups</a>
          <% if (isHoodieFooter) { %>
            <a href="/tools/hoodie-mockup-generator" class="footer-link">Hoodie Generator</a>
            <a href="/tools" class="footer-link">Apparel Tools</a>
          <% } %>
          <a href="/pricing" class="footer-link">Pricing</a>
        </div>

        <!-- Resources -->
        <div class="footer-column">
          <p class="footer-title">Resources</p>
          <a href="/tools" class="footer-link">Design Tools</a>
          <a href="/blog" class="footer-link">Blog</a>
          <a href="/feed.xml" class="footer-link">RSS Feed</a>
          <a href="/mockups" class="footer-link">Free 3D Models</a>
        </div>

        <!-- Company and trust -->
        <div class="footer-column">
          <p class="footer-title">Company</p>
          <a href="mailto:support@cloz-design.com" class="footer-link">Contact</a>
          <a href="/privacy" class="footer-link">Privacy</a>
          <a href="/terms" class="footer-link">Terms</a>
        </div>

        <% if (isHoodieFooter) { %>
          <div class="footer-column footer-newsletter">
            <p class="footer-title">Stay in the loop</p>
            <p>Get updates, new features, and design tips.</p>
            <form action="mailto:support@cloz-design.com" method="post" enctype="text/plain">
              <label class="sr-only" for="hoodie-footer-email">Your email address</label>
              <input id="hoodie-footer-email" type="email" name="email" autocomplete="email" placeholder="Your email address" required>
              <button type="submit" aria-label="Join ClozDesign updates">→</button>
            </form>
            <small>No spam. Unsubscribe anytime.</small>
          </div>
        <% } %>
      </div>

      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> ClozDesign. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <aside class="feedback-widget" data-feedback-widget>
    <div class="feedback-panel" id="feedbackPanel" data-feedback-panel role="dialog" aria-modal="true" aria-label="Feedback" hidden>
      <button class="feedback-close" type="button" data-feedback-close aria-label="Close feedback form">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 4 12 12M16 4 4 16"/></svg>
      </button>
      <form class="feedback-form" data-feedback-form novalidate>
        <label class="feedback-sr-only" for="feedbackEmail">Email</label>
        <input id="feedbackEmail" type="email" name="email" value="<%= user && user.email ? user.email : '' %>" placeholder="Email" autocomplete="email" maxlength="180" required>
        <label class="feedback-sr-only" for="feedbackMessage">Feedback</label>
        <textarea id="feedbackMessage" name="message" placeholder="Tell us what you think…" minlength="3" maxlength="2000" required></textarea>
        <label class="feedback-honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
        <input type="hidden" name="sourceUrl" value="">
        <p class="feedback-status" data-feedback-status role="status" aria-live="polite"></p>
        <button class="feedback-submit" type="submit">
          <span>Send feedback</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5"/></svg>
        </button>
      </form>
    </div>
    <button class="feedback-launcher" type="button" data-feedback-launcher aria-label="Feedback" aria-controls="feedbackPanel" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14v10H9l-4 3v-13Z"/><path d="M9 9h6M9 12h4"/></svg>
    </button>
  </aside>

  <script src="/js/main.js?v=20260805-overlay-fix"></script>
  <script src="/js/camera-relative-studio-light.js?v=20260917-front-white-v5" defer></script>
  <script src="/js/share.js?v=20260915-direct-events-v3" defer></script>
  <script src="/js/feedback-widget.js?v=20260917-global-v1" defer></script>
</body>
</html>

      eyebrow: 'Drop-shoulder T-shirt',
      summary: 'Check front and back artwork on a relaxed fit before you commit to a print.',
      placementTitle: 'Made for real designs.',
      placementBody: 'A wider body and dropped shoulder change how a design reads. Review the chest area, then turn the garment to check the back at the same scale.',
      placementImage: '/images/tool-editorial/oversized-tee-views-v1.webp',
      mobilePlacementImage: '/images/tool-editorial/oversized-tee-views-mobile-v1.webp',
      exampleImage: '/images/tool-editorial/oversized-tee-example-v1.webp',
      placementAlt: 'Oversized white T-shirt shown from the front and back',
      placements: [
        ['01', 'Front', 'Check the artwork against the wider chest and sleeve line.'],

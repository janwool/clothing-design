<!DOCTYPE html>
<html lang="<%= i18next && i18next.language ? i18next.language : 'en' %>">
<head>
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="preconnect" href="https://cdn.cloz-design.com" crossorigin>
  <!-- Google tag: queue events immediately, fetch the library after critical content. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-PZGFTE8C6B', { 'send_page_view': false });

    (function loadGoogleTagAfterPage() {
      var loaded = false;
      function load() {
        if (loaded) return;
        loaded = true;
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-PZGFTE8C6B';
        document.head.appendChild(script);
      }
      function schedule() {
        if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 1500 });
        else window.setTimeout(load, 0);
      }
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    })();
  </script>
  <script src="/js/analytics.js?v=20260805-stable-events" defer></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } %>
  <% const headMetaRobots = typeof metaRobots !== 'undefined' && metaRobots
    ? (String(metaRobots).includes('max-image-preview:') ? metaRobots : `${metaRobots}, max-image-preview:large`)
    : (typeof defaultMetaRobots !== 'undefined' && defaultMetaRobots ? defaultMetaRobots : 'max-image-preview:large'); %>
  <meta name="robots" content="<%= headMetaRobots %>">
  <% const headCanonicalUrl = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ''; %>
  <% const headMetaImage = typeof metaImage !== 'undefined' && metaImage ? metaImage : (typeof defaultMetaImage !== 'undefined' ? defaultMetaImage : 'https://cdn.cloz-design.com/site/icon.png'); %>
  <% if (headCanonicalUrl) { %>
    <link rel="canonical" href="<%= headCanonicalUrl %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta property="og:description" content="<%= metaDescription %>">
  <% } %>
  <% if (headCanonicalUrl) { %>
    <meta property="og:url" content="<%= headCanonicalUrl %>">
  <% } %>
  <meta property="og:image" content="<%= headMetaImage %>">
  <meta property="og:image:alt" content="<%= title %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="twitter:description" content="<%= metaDescription %>">
  <% } %>
  <meta name="twitter:image" content="<%= headMetaImage %>">
  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>
  <% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
  <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="48x48">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="https://cdn.cloz-design.com/site/icon.png?v=20260719">
  <link rel="alternate" type="application/rss+xml" title="ClothingDesign apparel mockup guides" href="/feed.xml">
  <link rel="stylesheet" href="/css/style.css?v=20260815-text-selection-v4">
  <% const headPageStyles = typeof pageStyles !== 'undefined' && Array.isArray(pageStyles) ? pageStyles : []; %>
  <% headPageStyles.forEach(function(stylesheet) { %>
    <link rel="stylesheet" href="<%= stylesheet %>">
  <% }); %>
  <link rel="stylesheet" href="/css/growth.css?v=20260806-auto-3d">
  <link rel="stylesheet" href="/css/product-refresh.css?v=20260815-product-loop-v2">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <nav class="navbar">
    <div class="navbar-container">
      <!-- Logo -->
      <a href="/" class="navbar-logo">
        <span class="logo-text">ClothingDesign</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="navbar-menu">
        <a href="/mockups" class="nav-link <%= typeof page !== 'undefined' && page === 'design-3d' ? 'active' : '' %>">
          3D Models
        </a>
        <a href="/blog" class="nav-link <%= typeof page !== 'undefined' && page === 'blog' ? 'active' : '' %>">
          Guides
        </a>
        <!-- Tools Dropdown -->
        <div class="nav-dropdown">
          <button class="nav-link dropdown-toggle <%= typeof page !== 'undefined' && page === 'tools' ? 'active' : '' %>" type="button" aria-expanded="false">
            <%= t('nav.tools') %>
            <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="dropdown-menu tools-mega-menu">
            <div class="tools-mega-inner">
              <div class="tools-mega-intro">
                <span class="tools-mega-eyebrow">Free clothing design tools</span>
                <strong>Pick a mockup workflow</strong>
                <p>Browser-based tools for apparel mockups, print placement, colorways, and product listing visuals.</p>
              </div>
              <div class="tools-mega-grid">
                <div class="dropdown-section">
                  <span class="dropdown-label">Mockup generators</span>
                  <a href="/tools/t-shirt-mockup-generator" class="dropdown-item">
                    <span>T-Shirt Mockup Generator</span>
                    <small>Free front, back, and colorway mockups.</small>
                  </a>
                  <a href="/tools/hoodie-mockup-generator" class="dropdown-item">
                    <span>Hoodie Mockup Generator</span>
                    <small>Build hoodie previews for print tests.</small>
                  </a>
                  <a href="/tools/dress-designer" class="dropdown-item">
                    <span>Online Dress Designer</span>
                    <small>Design a dress on a live 3D garment model.</small>
                  </a>
                  <a href="/tools/3d-clothing-mockup-generator" class="dropdown-item">
                    <span>3D Clothing Design & Mockup Generator</span>
                    <small>Use 3D models for apparel mockups.</small>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label">Production previews</span>
                  <a href="/tools/bulk-t-shirt-mockup-generator" class="dropdown-item">
                    <span>Bulk T-Shirt Mockup Generator</span>
                    <small>Create many colorways faster.</small>
                  </a>
                  <a href="/tools/print-on-demand-mockup-generator" class="dropdown-item">
                    <span>POD Mockup Generator</span>
                    <small>Prepare marketplace listing images.</small>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label"><%= t('tools.designTools') %></span>
                  <a href="/tools/oversized-t-shirt-mockup-generator" class="dropdown-item">
                    <span>Oversized T-Shirt Mockups</span>
                    <small>Design on a relaxed drop-shoulder fit.</small>
                  </a>
                  <a href="/tools/polo-shirt-mockup-generator" class="dropdown-item">
                    <span>Polo Shirt Mockups</span>
                    <small>Preview uniforms and chest logos.</small>
                  </a>
                  <a href="/tools/dress-designer" class="dropdown-item">
                    <span><%= t('tools.dressDesigner') %></span>
                    <small>Explore dress design directions.</small>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label">Free resources</span>
                  <a href="/mockups" class="dropdown-item">
                    <span>Free 3D Models</span>
                    <small>Browse editable garment models.</small>
                  </a>
                  <a href="/tools/2d-mockup" class="dropdown-item">
                    <span><%= t('tools.mockup2d') %></span>
                    <small>Make flat apparel mockup concepts.</small>
                  </a>
                  <a href="/tools/3d-clothing-mockup-generator" class="dropdown-item">
                    <span>3D Clothing Mockups</span>
                    <small>Design across garment categories.</small>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side -->
      <div class="navbar-actions">
        <% if (user) { %>
          <!-- User Menu -->
          <div class="user-dropdown">
            <button class="user-toggle">
              <div class="user-avatar">
                <%= user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase() %>
              </div>
            </button>
            <div class="user-menu">
              <a href="/tools/t-shirt-mockup-generator" class="user-item">Start a new mockup</a>
              <a href="/mockups" class="user-item">Browse garment models</a>
              <div class="user-divider"></div>
              <a href="/auth/logout" class="user-item"><%= t('nav.signOut') %></a>
            </div>
          </div>
        <% } else { %>
          <!-- Auth Buttons -->
          <a href="/auth/login" class="btn btn-ghost"><%= t('nav.signIn') %></a>
          <a href="/tools/t-shirt-mockup-generator" class="btn btn-primary">Start designing</a>
        <% } %>

        <!-- Mobile Menu Toggle -->
        <button class="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNavigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileNavigation">
      <a href="/mockups" class="mobile-link">3D Models</a>
      <a href="/blog" class="mobile-link">Guides</a>
      <a href="/tools" class="mobile-link"><%= t('nav.tools') %></a>
      <div class="mobile-divider"></div>
      <% if (user) { %>
        <a href="/tools/t-shirt-mockup-generator" class="mobile-link">Start a new mockup</a>
        <a href="/mockups" class="mobile-link">Browse garment models</a>
        <a href="/auth/logout" class="mobile-link"><%= t('nav.signOut') %></a>
      <% } else { %>
        <a href="/auth/login" class="mobile-link"><%= t('nav.signIn') %></a>
        <a href="/tools/t-shirt-mockup-generator" class="mobile-link btn btn-primary">Start designing</a>
      <% } %>
    </div>
  </nav>

  <main id="main-content">

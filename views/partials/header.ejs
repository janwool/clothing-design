<!DOCTYPE html>
<html lang="<%= i18next && i18next.language ? i18next.language : 'en' %>">
<head>
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="preconnect" href="https://cdn.cloz-design.com" crossorigin>
  <!-- Google tag: queue events immediately, fetch the library after critical content. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-PZGFTE8C6B', { 'send_page_view': false });

    (function loadGoogleTagAfterPage() {
      var loaded = false;
      function load() {
        if (loaded) return;
        loaded = true;
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-PZGFTE8C6B';
        document.head.appendChild(script);
      }
      function schedule() {
        if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 1500 });
        else window.setTimeout(load, 0);
      }
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    })();
  </script>
  <script src="/js/analytics.js?v=20260917-white-detail-events-v2" defer></script>
  <link rel="stylesheet" href="/css/model-login.css?v=20260922-v1">
  <link rel="stylesheet" href="/css/upgrade-modal.css?v=20260923-free-card-v7">
  <script src="/js/login-dialog.js?v=20260921-v1" data-google-auth="<%= typeof googleAuthEnabled !== 'undefined' && googleAuthEnabled ? 'true' : 'false' %>" defer></script>
  <script src="/js/upgrade-modal.js?v=20260926-3d-sharing-v1" defer></script>
  <script src="/js/user-projects.js?v=20260923-cover-project-v7" defer></script>
  <link rel="stylesheet" href="/css/export-access.css?v=20260926-paid-v1">
  <script src="/js/export-entitlements.js?v=20260927-watermark-contrast-v2" defer></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } %>
  <% const headMetaRobots = typeof metaRobots !== 'undefined' && metaRobots
    ? (String(metaRobots).includes('max-image-preview:') ? metaRobots : `${metaRobots}, max-image-preview:large`)
    : (typeof defaultMetaRobots !== 'undefined' && defaultMetaRobots ? defaultMetaRobots : 'max-image-preview:large'); %>
  <meta name="robots" content="<%= headMetaRobots %>">
  <% const headCanonicalUrl = typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : ''; %>
  <% const headMetaImage = typeof metaImage !== 'undefined' && metaImage ? metaImage : (typeof defaultMetaImage !== 'undefined' ? defaultMetaImage : 'https://cdn.cloz-design.com/site/icon.png'); %>
  <% if (headCanonicalUrl) { %>
    <link rel="canonical" href="<%= headCanonicalUrl %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %>">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta property="og:description" content="<%= metaDescription %>">
  <% } %>
  <% if (headCanonicalUrl) { %>
    <meta property="og:url" content="<%= headCanonicalUrl %>">
  <% } %>
  <meta property="og:image" content="<%= headMetaImage %>">
  <meta property="og:image:alt" content="<%= title %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="twitter:description" content="<%= metaDescription %>">
  <% } %>
  <meta name="twitter:image" content="<%= headMetaImage %>">
  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
    <script type="application/ld+json"><%- JSON.stringify(structuredData).replace(/</g, '\\u003c') %></script>
  <% } %>
  <link rel="icon" href="/images/brand/clozdesign-icon.png?v=20260925-round" type="image/png" sizes="400x400">
  <link rel="icon" href="/favicon.ico?v=20260925-round" type="image/x-icon" sizes="48x48">
  <link rel="shortcut icon" href="/favicon.ico?v=20260925-round">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20260925-round" sizes="180x180">
  <link rel="alternate" type="application/rss+xml" title="ClozDesign apparel mockup guides" href="/feed.xml">
  <link rel="stylesheet" href="/css/style.css?v=20260926-tools-labels-700-14-v9">
  <link rel="stylesheet" href="/css/growth.css?v=20260913-loading-spinner-v2">
  <link rel="stylesheet" href="/css/product-refresh.css?v=20260925-round-image">
  <link rel="stylesheet" href="/css/feedback-widget.css?v=20260917-global-v1">
  <% const headPageStyles = typeof pageStyles !== 'undefined' && Array.isArray(pageStyles) ? pageStyles : []; %>
  <% headPageStyles.forEach(function(stylesheet) { %>
    <link rel="stylesheet" href="<%= stylesheet %>">
  <% }); %>
  <% if (typeof toolPage !== 'undefined' && ['oversized-t-shirt-mockup-generator', 'front-and-back-t-shirt-mockup', 'polo-shirt-mockup-generator', 'long-sleeve-shirt-mockup-generator', 'streetwear-hoodie-mockup-generator'].includes(toolPage.slug)) { %>
    <link rel="stylesheet" href="/css/tool-editorial-detail.css?v=12">
  <% } %>
  <% if (typeof page !== 'undefined' && page === 'home') { %>
    <link rel="stylesheet" href="/css/home-v2.css?v=20260916-imagegen-build-v5">
  <% } %>
  <link rel="stylesheet" href="/css/opening-offer.css?v=20260922-v2">
  <script src="/js/opening-offer.js?v=20260922-v1" defer></script>
</head>
<% const activeOpeningOffer = typeof openingOffer !== 'undefined' ? openingOffer : null; %>
<body class="<%= typeof bodyClass !== 'undefined' && bodyClass ? bodyClass : '' %><%= activeOpeningOffer ? ' has-opening-offer' : '' %>">
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <nav class="navbar">
    <% if (activeOpeningOffer) { %>
      <a class="opening-offer-banner" href="/pricing" data-offer-expires="<%= activeOpeningOffer.expiresAt %>" aria-label="Opening offer: 50% off your first Pro or Max payment with OPEN50. Ends November 30, 2026 at 23:59 UTC+8.">
        <span class="opening-offer-label">Opening offer</span><strong>50% off your first payment</strong><span class="opening-offer-code">OPEN50</span><span class="opening-offer-deadline">Ends Nov 30<span class="opening-offer-timezone"> · 23:59 UTC+8</span></span><span aria-hidden="true">↗</span>
      </a>
    <% } %>
    <div class="navbar-container">
      <!-- Logo -->
      <a href="/" class="navbar-logo">
        <img class="navbar-brand-icon" src="/images/brand/clozdesign-icon.png?v=20260925-round" alt="" width="40" height="40" decoding="async">
        <span class="logo-text">ClozDesign</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="navbar-menu">
        <a href="/mockups" class="nav-link <%= typeof page !== 'undefined' && page === 'design-3d' ? 'active' : '' %>">
          3D Models
        </a>
        <a href="/white-mockups" class="nav-link <%= typeof page !== 'undefined' && page === 'white-mockups' ? 'active' : '' %>">
          Fashion Mockups
        </a>
        <a href="/pricing" class="nav-link <%= typeof page !== 'undefined' && page === 'pricing' ? 'active' : '' %>">
          Pricing
        </a>
        <!-- Tools Dropdown -->
        <div class="nav-dropdown">
          <button class="nav-link dropdown-toggle <%= typeof page !== 'undefined' && page === 'tools' ? 'active' : '' %>" type="button" aria-expanded="false">
            <%= t('nav.tools') %>
            <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="dropdown-menu tools-mega-menu">
            <div class="tools-mega-inner">
              <div class="tools-mega-grid">
                <div class="dropdown-section">
                  <span class="dropdown-label">Mockup generators</span>
                  <a href="/tools/t-shirt-mockup-generator" class="dropdown-item">
                    <span>T-Shirt Mockups</span>
                  </a>
                  <a href="/tools/hoodie-mockup-generator" class="dropdown-item">
                    <span>Hoodie Mockups</span>
                  </a>
                  <a href="/tools/3d-pants-generator" class="dropdown-item"><span>3D Pants Generator</span></a>
                  <a href="/tools/dress-designer" class="dropdown-item">
                    <span>Dress Designer</span>
                  </a>
                  <a href="/tools/3d-clothing-mockup-generator" class="dropdown-item">
                    <span>3D Clothing Designer</span>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label">Production previews</span>
                  <a href="/tools/bulk-t-shirt-mockup-generator" class="dropdown-item">
                    <span>Bulk T-Shirt Mockups</span>
                  </a>
                  <a href="/tools/print-on-demand-mockup-generator" class="dropdown-item">
                    <span>Print-on-Demand Mockups</span>
                  </a>
                  <a href="/tools/transparent-apparel-mockup-generator" class="dropdown-item">
                    <span>Transparent Mockups</span>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label"><%= t('tools.designTools') %></span>
                  <a href="/tools/oversized-t-shirt-mockup-generator" class="dropdown-item">
                    <span>Oversized T-Shirts</span>
                  </a>
                  <a href="/tools/polo-shirt-mockup-generator" class="dropdown-item">
                    <span>Polo Shirts</span>
                  </a>
                  <a href="/tools/front-and-back-t-shirt-mockup" class="dropdown-item">
                    <span>Front &amp; Back Views</span>
                  </a>
                  <a href="/tools/long-sleeve-shirt-mockup-generator" class="dropdown-item">
                    <span>Long-Sleeve Shirts</span>
                  </a>
                  <a href="/tools/streetwear-hoodie-mockup-generator" class="dropdown-item">
                    <span>Streetwear Hoodies</span>
                  </a>
                </div>
                <div class="dropdown-section">
                  <span class="dropdown-label">Free resources</span>
                  <a href="/mockups" class="dropdown-item">
                    <span>Free 3D Models</span>
                  </a>
                  <a href="/blog" class="dropdown-item">
                    <span>Design Guides</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side -->
      <div class="navbar-actions">
        <% if (user) { %>
          <a href="/account" class="btn btn-primary navbar-workbench-link">Workbench</a>
        <% } else { %>
          <a href="<%= authLoginUrl %>" class="btn btn-ghost"><%= t('nav.signIn') %></a>
        <% } %>

        <!-- Mobile Menu Toggle -->
        <button class="mobile-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNavigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileNavigation">
      <a href="/mockups" class="mobile-link">3D Models</a>
      <a href="/white-mockups" class="mobile-link">Fashion Mockups</a>
      <a href="/pricing" class="mobile-link">Pricing</a>
      <a href="/tools" class="mobile-link"><%= t('nav.tools') %></a>
      <div class="mobile-divider"></div>
      <% if (user) { %>
        <a href="/account" class="mobile-link">Workbench</a>
        <a href="/tools/t-shirt-mockup-generator" class="mobile-link">Start a new mockup</a>
        <a href="/mockups" class="mobile-link">Browse garment models</a>
        <a href="/auth/logout" class="mobile-link"><%= t('nav.signOut') %></a>
      <% } else { %>
        <a href="<%= authLoginUrl %>" class="mobile-link"><%= t('nav.signIn') %></a>
      <% } %>
    </div>
  </nav>

  <main id="main-content">

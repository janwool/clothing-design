<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title">See Plans</h1>
    <p class="page-subtitle">Choose the plan that works for you</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="pricing-grid">
      <div class="pricing-card">
        <h3>Free</h3>
        <div class="pricing-price">$0<span>/month</span></div>
        <ul class="pricing-features">
          <li>Basic 2D templates</li>
          <li>3 designs per month</li>
          <li>1080p exports</li>
          <li>Community support</li>
        </ul>
        <a href="/auth/register" class="btn btn-ghost btn-full">Get Started</a>
      </div>
      <div class="pricing-card featured">
        <div class="pricing-badge">Popular</div>
        <h3>Pro</h3>
        <div class="pricing-price">$29<span>/month</span></div>
        <ul class="pricing-features">
          <li>All 2D & 3D models</li>
          <li>Unlimited designs</li>
          <li>4K exports</li>
          <li>Priority support</li>
          <li>Pattern downloads</li>
        </ul>
        <a href="/auth/register" class="btn btn-primary btn-full">Get Started</a>
      </div>
      <div class="pricing-card">
        <h3>Enterprise</h3>
        <div class="pricing-price">$99<span>/month</span></div>
        <ul class="pricing-features">
          <li>Everything in Pro</li>
          <li>Team collaboration</li>
          <li>API access</li>
          <li>Dedicated support</li>
          <li>Custom integrations</li>
        </ul>
        <a href="/contact" class="btn btn-ghost btn-full">Contact Us</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

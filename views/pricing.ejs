<%- include('partials/header', {
  bodyClass: 'pricing-page',
  pageStyles: ['/css/pricing.css?v=20260926-ip-currency-v3']
}) %>
<% const aiTryOnAvailable = typeof aiTryOnEnabled !== 'undefined' && Boolean(aiTryOnEnabled); %>

<section class="pricing-hero" aria-labelledby="pricingTitle">
  <div class="container pricing-hero-inner">
    <span class="pricing-eyebrow">Plans for every workflow</span>
    <h1 id="pricingTitle">Choose the space<br>your ideas need.</h1>
    <p>Start with three projects, or unlock more room for mockups, exports, and image storage.</p>
  </div>
</section>

<section class="pricing-plans" aria-label="ClozDesign plans" data-pricing-plans data-authenticated="<%= user ? 'true' : 'false' %>">
  <div class="container pricing-billing">
    <div class="billing-switch" role="group" aria-label="Billing frequency">
      <button class="is-active" type="button" data-billing-option="monthly" data-analytics-managed="true" aria-pressed="true">Monthly</button>
      <button type="button" data-billing-option="yearly" data-analytics-managed="true" aria-pressed="false">Yearly</button>
    </div>
    <select class="pricing-currency" aria-label="Display currency" data-pricing-currency>
      <option value="auto">Local currency</option>
      <option value="USD">USD</option>
    </select>
    <p class="billing-caption" aria-live="polite" data-billing-caption>Flexible monthly billing. Change plans anytime.</p>
  </div>

  <div class="container pricing-grid">
    <article class="pricing-card pricing-card-free">
      <div class="pricing-card-heading"><h2>Free</h2></div>
      <div class="pricing-price-block">
        <div class="pricing-price-line"><strong data-free-price>$0</strong></div>
        <span class="pricing-alt-price" aria-hidden="true">&nbsp;</span>
      </div>
      <ul class="pricing-features">
        <li><span aria-hidden="true">✓</span> 3 projects total</li>
        <li><span aria-hidden="true">✓</span> 20 MB image storage</li>
        <li><span aria-hidden="true">✓</span> Free editing &amp; previews</li>
        <li><span aria-hidden="true">—</span> Exports require Pro</li>
      </ul>
      <a class="pricing-cta pricing-cta-secondary" href="/auth/register" data-pricing-cta data-plan="free" data-analytics-managed="true">Start free</a>
    </article>

    <article class="pricing-card pricing-card-featured">
      <div class="pricing-popular">Most popular</div>
      <div class="pricing-card-heading"><h2>Pro</h2></div>
      <div class="pricing-price-block">
        <div class="pricing-price-line">
          <strong data-plan-price data-monthly="$9.90" data-yearly="$6.67">$9.90</strong>
          <span data-plan-period data-monthly="/ month" data-yearly="/ month">/ month</span>
        </div>
        <div class="pricing-annual-saving" data-plan-saving hidden><s>$9.90 / month</s><span>Save 32.7%</span></div>
        <span class="pricing-alt-price" data-plan-alt data-monthly="Billed monthly" data-yearly="$80 billed annually">Billed monthly</span>
      </div>
      <ul class="pricing-features">
        <li><span aria-hidden="true">✓</span> Unlimited projects</li>
        <li><span aria-hidden="true">✓</span> Unlimited image, video &amp; GLB exports</li>
        <li><span aria-hidden="true">✓</span> No watermarks</li>
        <li><span aria-hidden="true">✓</span> Interactive 3D sharing</li>
        <% if (aiTryOnAvailable) { %><li><span aria-hidden="true">✓</span> All AI models</li>
        <li><span aria-hidden="true">✓</span> 250 monthly credits</li><% } %>
        <li><span aria-hidden="true">✓</span> Unlimited image storage</li>
      </ul>
      <a class="pricing-cta pricing-cta-inverse" href="/auth/register?plan=pro&amp;billing=monthly" data-pricing-cta data-plan-link data-plan="pro" data-analytics-managed="true">Choose Pro</a>
    </article>

    <article class="pricing-card pricing-card-business">
      <div class="pricing-card-heading"><h2>Business</h2></div>
      <div class="pricing-price-block">
        <div class="pricing-price-line"><strong>Custom</strong></div>
        <span class="pricing-alt-price" aria-hidden="true">&nbsp;</span>
      </div>
      <ul class="pricing-features">
        <li><span aria-hidden="true">✓</span> Custom projects &amp; limits</li>
        <li><span aria-hidden="true">✓</span> Custom storage</li>
        <li><span aria-hidden="true">✓</span> Unlimited image, video &amp; GLB exports</li>
        <li><span aria-hidden="true">✓</span> No watermarks</li>
        <li><span aria-hidden="true">✓</span> Interactive 3D sharing</li>
        <li><span aria-hidden="true">✓</span> Priority support</li>
      </ul>
      <a class="pricing-cta pricing-cta-secondary" href="mailto:support@cloz-design.com?subject=ClozDesign%20Business%20plan%20inquiry" data-pricing-cta data-plan="business" data-analytics-managed="true">Contact sales</a>
    </article>
  </div>

  <div class="container pricing-inline-note">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
      <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5"></path>
      <path d="M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7"></path>
    </svg>
    <span aria-hidden="true"></span>
    <p>Create unlimited projects with Pro. Keep your work in one place.</p>
  </div>
</section>

<script src="/js/pricing.js?v=20260926-ip-currency-v3" defer></script>
<%- include('partials/footer') %>

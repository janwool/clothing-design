<%- include('../partials/header') %>

<section class="auth-section">
  <div class="auth-container">
    <div class="auth-card">
      <h1 class="auth-title"><%= t('auth.login') %></h1>
      <p class="auth-intro">Sign in to your ClozDesign account, or start a public mockup without an account.</p>
      
      <% if ((typeof error !== 'undefined' && error) || oauthError) { %>
        <div class="auth-error"><%= (typeof error !== 'undefined' && error) ? error : oauthError %></div>
      <% } %>

      <% if (googleAuthEnabled) { %>
        <a class="auth-google-button" href="<%= googleAuthUrl %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.41Z"/><path fill="#34A853" d="M12 22c2.7 0 4.98-.9 6.63-2.36l-3.24-2.54c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.45H3.04A10 10 0 0 0 2 12c0 1.61.38 3.14 1.04 4.55l3.35-2.62Z"/><path fill="#EA4335" d="M12 5.94c1.47 0 2.79.5 3.83 1.5l2.87-2.88A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.96 5.45l3.35 2.62C7.18 7.7 9.39 5.94 12 5.94Z"/></svg>
          <span>Continue with Google</span>
        </a>
        <div class="auth-divider"><span>or use email</span></div>
      <% } %>
      
      <form action="/auth/login" method="POST" class="auth-form">
        <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '' %>">
        <div class="form-group">
          <label for="email" class="form-label"><%= t('auth.email') %></label>
          <input type="email" id="email" name="email" class="form-input" autocomplete="email" required>
        </div>

        <div class="form-group">
          <label for="password" class="form-label"><%= t('auth.password') %></label>
          <input type="password" id="password" name="password" class="form-input" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn-primary btn-large btn-full"><%= t('auth.login') %></button>
      </form>

      <div class="auth-footer">
        <p><%= t('auth.noAccount') %> <a href="/auth/register<%= typeof next !== 'undefined' && next ? `?next=${encodeURIComponent(next)}` : '' %>"><%= t('auth.signUpNow') %></a></p>
        <p><a href="/tools/t-shirt-mockup-generator">Continue without an account →</a></p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<section class="auth-section">
  <div class="auth-container">
    <div class="auth-card">
      <h1 class="auth-title"><%= t('auth.register') %></h1>
      <p class="auth-intro">Create an account for sign-in access. The public mockup editor can also be used without registering.</p>
      
      <% if (typeof error !== 'undefined') { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <form action="/auth/register" method="POST" class="auth-form">
        <div class="form-group">
          <label for="name" class="form-label"><%= t('auth.name') %></label>
          <input type="text" id="name" name="name" class="form-input" autocomplete="name" minlength="2" maxlength="100" required>
        </div>

        <div class="form-group">
          <label for="email" class="form-label"><%= t('auth.email') %></label>
          <input type="email" id="email" name="email" class="form-input" autocomplete="email" maxlength="180" required>
        </div>

        <div class="form-group">
          <label for="password" class="form-label"><%= t('auth.password') %></label>
          <input type="password" id="password" name="password" class="form-input" autocomplete="new-password" minlength="8" required aria-describedby="passwordHint">
          <small class="form-hint" id="passwordHint">Use at least 8 characters.</small>
        </div>

        <button type="submit" class="btn btn-primary btn-large btn-full"><%= t('auth.register') %></button>
      </form>

      <div class="auth-footer">
        <p><%= t('auth.hasAccount') %> <a href="/auth/login"><%= t('auth.signInNow') %></a></p>
        <p class="auth-legal">By creating an account, you agree to the <a href="/terms">Terms</a> and acknowledge the <a href="/privacy">Privacy overview</a>.</p>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>

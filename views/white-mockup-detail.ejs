<%- include('partials/header', { bodyClass: 'category-catalog-page white-mockup-detail-page' }) %>
<%
  const cleanRelatedTitle = function(item) {
    return String(item.title || item.asset_name || 'White garment mockup')
      .replace(/^Model\s+\d+\s+/i, '')
      .replace(/\s+From3d(?:\s+V\d+)?/i, '')
      .replace(/\s+/g, ' ')
      .trim();
  };
  const baseImageVersionSeparator = String(asset.base_image_url).includes('?') ? '&' : '?';
  const editorBaseImageUrl = `${asset.base_image_url}${baseImageVersionSeparator}v=commercial-refine-v8`;
%>

<div class="white-detail-main">
  <div class="white-detail-shell">
    <nav class="white-detail-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">›</span>
      <a href="/white-mockups">White Mockups</a><span aria-hidden="true">›</span>
      <span aria-current="page"><%= displayTitle %></span>
    </nav>

    <section
      class="white-detail-product"
      id="whiteMockupEditor"
      data-base-image="<%= editorBaseImageUrl %>"
      data-mask-image="<%= asset.mask_image_url %>?v=commercial-refine-v8"
      data-depth-image="<%= asset.depth_image_url %>?v=commercial-refine-v8"
      data-asset-name="<%= asset.asset_name %>"
      data-garment-type="<%= asset.garment_type %>"
      data-canvas-width="<%= asset.canvas_width %>"
      data-canvas-height="<%= asset.canvas_height %>"
      data-artwork-center-x="<%= asset.artwork_center_x %>"
      data-artwork-center-y="<%= asset.artwork_center_y %>"
      data-artwork-base-width="<%= asset.artwork_base_width %>"
      data-artwork-max-height="<%= asset.artwork_max_height %>"
      data-render-left="<%= asset.render_left %>"
      data-render-top="<%= asset.render_top %>"
      data-render-right="<%= asset.render_right %>"
      data-render-bottom="<%= asset.render_bottom %>"
      data-default-scale="<%= asset.default_scale %>"
      data-default-warp="<%= asset.default_warp %>"
    >
      <div class="white-detail-stage-column">
        <div class="white-detail-stage" id="whiteMockupStage">
          <img
            class="white-detail-stage-poster"
            crossorigin="anonymous"
            src="<%= editorBaseImageUrl %>"
            alt="<%= displayTitle %> white mockup preview"
            width="<%= asset.canvas_width %>"
            height="<%= asset.canvas_height %>"
            fetchpriority="high"
            decoding="async"
          >
          <canvas
            id="whiteMockupCanvas"
            width="<%= asset.canvas_width %>"
            height="<%= asset.canvas_height %>"
            tabindex="0"
            aria-label="Customize <%= displayTitle %> white mockup. Drag the selected artwork to move it, use corner handles to scale, and use the top handle to rotate."
          ></canvas>
          <button type="button" class="white-detail-stage-reset" id="whiteMockupReset" hidden>Reset artwork</button>
          <button type="button" class="white-detail-empty" id="whiteMockupEmptyUpload">
            <span>Place your artwork directly on the garment</span>
            <strong>Upload a design to begin</strong>
          </button>
          <div class="white-detail-loading" id="whiteMockupLoading" aria-live="polite">
            <i aria-hidden="true"></i><span>Preparing your mockup</span>
          </div>
          <p class="white-detail-gesture-hint" id="whiteMockupGestureHint" hidden>Drag to move · corners to scale · top handle to rotate</p>
        </div>
      </div>

      <aside class="white-detail-purchase" aria-labelledby="whiteMockupTitle">
        <span class="white-detail-eyebrow">On-model white mockup</span>
        <h1 id="whiteMockupTitle"><%= displayTitle %> White Mockup</h1>
        <p class="white-detail-description">Preview artwork on a natural <%= typeName %> fit before publishing your collection. Adjust it directly on the garment and create a clean product-ready visual.</p>

        <label class="white-detail-upload" id="whiteMockupUploadZone">
          <input type="file" id="whiteMockupArtworkInput" accept="image/png,image/jpeg,image/webp">
          <span class="white-detail-upload-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4"/></svg>
          </span>
          <span>
            <strong id="whiteMockupUploadLabel">Upload your design</strong>
            <small>PNG, JPG or WebP · up to 10 MB</small>
          </span>
        </label>

        <div class="white-detail-garment-colors">
          <div class="white-detail-control-label">
            <span>Garment color</span>
            <small id="whiteMockupGarmentColorLabel">Original white</small>
          </div>
          <div class="white-detail-garment-swatches" role="group" aria-label="Choose garment color">
            <button type="button" class="active" data-garment-color="#ffffff" data-label="Original white" aria-label="White garment" aria-pressed="true"><i style="--swatch:#ffffff"></i></button>
            <button type="button" data-garment-color="#e2d5c2" data-label="Natural ecru" aria-label="Natural ecru garment" aria-pressed="false"><i style="--swatch:#e2d5c2"></i></button>
            <button type="button" data-garment-color="#a9b5a4" data-label="Soft sage" aria-label="Soft sage garment" aria-pressed="false"><i style="--swatch:#a9b5a4"></i></button>
            <button type="button" data-garment-color="#9db3c4" data-label="Dusty blue" aria-label="Dusty blue garment" aria-pressed="false"><i style="--swatch:#9db3c4"></i></button>
            <button type="button" data-garment-color="#a8493f" data-label="Brick red" aria-label="Brick red garment" aria-pressed="false"><i style="--swatch:#a8493f"></i></button>
            <button type="button" data-garment-color="#27384d" data-label="Deep navy" aria-label="Deep navy garment" aria-pressed="false"><i style="--swatch:#27384d"></i></button>
            <button type="button" data-garment-color="#252523" data-label="Black" aria-label="Black garment" aria-pressed="false"><i style="--swatch:#252523"></i></button>
            <label class="white-detail-custom-swatch white-detail-garment-custom-swatch" aria-label="Choose a custom garment color">
              <input type="color" id="whiteMockupGarmentColor" value="#c9b7a2">
              <i aria-hidden="true"></i>
            </label>
          </div>
        </div>

        <div class="white-detail-backgrounds">
          <div class="white-detail-control-label">
            <span>Change background</span>
            <small id="whiteMockupBackgroundLabel">Original studio</small>
          </div>
          <div class="white-detail-swatches" role="group" aria-label="Choose mockup background">
            <button type="button" class="active" data-background="studio" data-label="Original studio" aria-label="Original studio background" aria-pressed="true"><i class="studio"></i></button>
            <button type="button" data-background="#f7f7f4" data-label="Soft white" aria-label="Soft white background" aria-pressed="false"><i style="--swatch:#f7f7f4"></i></button>
            <button type="button" data-background="#d9d3c9" data-label="Warm stone" aria-label="Warm stone background" aria-pressed="false"><i style="--swatch:#d9d3c9"></i></button>
            <button type="button" data-background="#a8b4a6" data-label="Muted sage" aria-label="Muted sage background" aria-pressed="false"><i style="--swatch:#a8b4a6"></i></button>
            <button type="button" data-background="#b8c7d0" data-label="Cool gray" aria-label="Cool gray background" aria-pressed="false"><i style="--swatch:#b8c7d0"></i></button>
            <button type="button" data-background="#242522" data-label="Charcoal" aria-label="Charcoal background" aria-pressed="false"><i style="--swatch:#242522"></i></button>
            <label class="white-detail-custom-swatch" aria-label="Choose a custom background color">
              <input type="color" id="whiteMockupBackgroundColor" value="#d6d3cb">
              <i aria-hidden="true"></i>
            </label>
          </div>
        </div>

        <button type="button" class="white-detail-download" id="whiteMockupDownload" disabled>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"/></svg>
          Download PNG
        </button>
        <p class="white-detail-status" id="whiteMockupStatus" role="status" aria-live="polite">Ready for your design.</p>

        <ul class="white-detail-trust" aria-label="Mockup benefits">
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 3C11 4 5 8 5 15c0 2 1 4 3 5 1-6 4-10 9-13-4 4-6 8-7 13 7 0 11-5 9-17Z"/></svg>
            <span>Free to use</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 10V8a6 6 0 0 1 12 0v2m-13 0h14v11H5V10Zm7 4v3"/></svg>
            <span>Private in your browser</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
            <span>High-resolution export</span>
          </li>
        </ul>
      </aside>
    </section>

    <section class="white-detail-benefits" aria-label="White mockup features">
      <article><span>01</span><h2>Natural garment fit</h2><p>Realistic drape, proportions, and posture provide a more useful preview than a flat product template.</p></article>
      <article><span>02</span><h2>Artwork follows fabric</h2><p>Your design responds to the garment silhouette and visible folds without adding extra controls to the creative workflow.</p></article>
      <article><span>03</span><h2>Ready for product pages</h2><p>Create clean, consistent apparel imagery for product drafts, campaign boards, client reviews, and launch planning.</p></article>
    </section>

    <section class="white-detail-about">
      <div class="white-detail-section-heading">
        <span>About this mockup</span>
        <h2>A commercial <%= typeName %> mockup built around the garment.</h2>
      </div>
      <div class="white-detail-about-copy">
        <p>The <%= displayTitle %> white mockup gives apparel designers and brand teams a neutral on-model starting point. The garment remains the visual focus, making it easier to judge artwork scale, placement, contrast, and overall product-page composition.</p>
        <p>Upload your design and position it directly on the canvas. Build a garment colorway, choose a background that fits your collection, then export a <%= asset.canvas_width %> × <%= asset.canvas_height %> PNG without installing design software.</p>
      </div>
      <ol class="white-detail-steps">
        <li><span>1</span><div><h3>Upload artwork</h3><p>Use a transparent PNG for the cleanest apparel graphic result.</p></div></li>
        <li><span>2</span><div><h3>Place it on the garment</h3><p>Drag to move, use the corners to resize, and rotate from the top handle.</p></div></li>
        <li><span>3</span><div><h3>Set garment and background colors</h3><p>Build a product colorway, then match the setting to a catalog, campaign board, presentation, or store draft.</p></div></li>
        <li><span>4</span><div><h3>Download the PNG</h3><p>Export the finished on-model mockup at its full source dimensions.</p></div></li>
      </ol>
    </section>

    <section class="white-detail-faq">
      <div class="white-detail-section-heading">
        <span>FAQ</span>
        <h2>Using this white mockup</h2>
      </div>
      <div class="white-detail-faq-list">
        <% whiteFaqItems.forEach(function(item, index) { %>
          <details <%= index === 0 ? 'open' : '' %>>
            <summary><%= item.question %><span aria-hidden="true">+</span></summary>
            <p><%= item.answer %></p>
          </details>
        <% }); %>
      </div>
    </section>

    <% if (relatedAssets.length) { %>
      <section class="white-detail-related">
        <div class="white-detail-related-heading">
          <div><span>Continue browsing</span><h2>Related <%= typeLabel.toLowerCase() %> white mockups</h2></div>
          <a href="/white-mockups?type=<%= asset.garment_type %>">View all <span aria-hidden="true">›</span></a>
        </div>
        <div class="white-detail-related-grid">
          <% relatedAssets.forEach(function(item) { %>
            <a href="/white-mockups/<%= item.asset_name %>">
              <figure><img src="<%= item.base_image_url %>" alt="<%= cleanRelatedTitle(item) %> white mockup" loading="lazy" width="<%= item.canvas_width %>" height="<%= item.canvas_height %>"></figure>
              <h3><%= cleanRelatedTitle(item) %></h3>
              <span>Open mockup ›</span>
            </a>
          <% }); %>
        </div>
      </section>
    <% } %>
  </div>
</div>

<script src="/js/white-mockup-editor.js?v=20260826-commercial-v8" defer></script>
<%- include('partials/footer') %>

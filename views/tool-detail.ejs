<%- include('partials/header') %>

<section class="tool-detail-hero">
  <div class="container tool-detail-hero-grid">
    <div class="tool-detail-copy">
      <div class="category-breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/tools">Tools</a>
        <span>/</span>
        <span><%= toolPage.title %></span>
      </div>
      <span class="generator-eyebrow"><%= toolPage.eyebrow %></span>
      <h1><%= toolPage.title %></h1>
      <p><%= toolPage.subtitle %></p>
      <div class="tool-trust-row" aria-label="Mockup planning highlights">
        <% (toolPage.outputHighlights || ['No Photoshop needed', 'Model-based apparel previews', 'Product visual planning']).forEach(function(item) { %>
          <span><%= item %></span>
        <% }); %>
      </div>
      <div class="hero-actions">
        <a href="<%= toolPage.editorHref || toolPage.cta.href %>" class="btn btn-primary btn-large"><%= toolPage.cta.label %></a>
        <a href="<%= toolPage.secondaryCtaHref || '/mockups' %>" class="btn btn-secondary btn-large"><%= toolPage.secondaryCtaLabel || 'Browse Mockup Models' %></a>
      </div>
    </div>
    <div class="tool-detail-visual">
      <% if (toolPage.heroModel && toolPage.heroModel.src) { %>
        <div class="tool-live-preview" data-editor-href="<%= toolPage.editorHref %>">
          <model-viewer
            id="toolHeroModelViewer"
            class="model-viewer-natural tool-hero-model-viewer"
            src="<%= toolPage.heroModel.src %>"
            alt="<%= toolPage.heroModel.alt || toolPage.title %>"
            camera-controls
            auto-rotate
            shadow-intensity="1.55"
            shadow-softness="0.52"
            exposure="0.66"
            environment-image="neutral"
            aria-label="<%= toolPage.heroModel.alt || toolPage.title %>"
          ></model-viewer>
          <div class="tool-quick-editor" aria-label="Quick 3D mockup controls">
            <div class="tool-control-group tool-color-controls">
              <span>Color</span>
              <% ['#f7f7f5', '#171717', '#506b5d', '#a54b43'].forEach(function(color, index) { %>
                <button type="button" class="tool-color-swatch<%= index === 0 ? ' active' : '' %>" data-color="<%= color %>" style="--swatch-color: <%= color %>" aria-label="Set garment color <%= color %>"></button>
              <% }); %>
            </div>
            <div class="tool-control-group tool-angle-controls" aria-label="Model view">
              <button type="button" class="active" data-orbit="0deg 75deg 110%">Front</button>
              <button type="button" data-orbit="90deg 75deg 110%">Side</button>
              <button type="button" data-orbit="180deg 75deg 110%">Back</button>
            </div>
            <div class="tool-preview-actions">
              <label class="btn btn-primary tool-upload-button">
                Upload artwork
                <input id="toolArtworkUpload" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden>
              </label>
              <button type="button" class="btn btn-secondary" id="toolDownloadPreview"><%= toolPage.slug === 'bulk-t-shirt-mockup-generator' ? 'Download colorway sheet' : 'Download PNG' %></button>
            </div>
            <p class="tool-preview-status" id="toolPreviewStatus" aria-live="polite">Rotate the model or start with your own artwork.</p>
          </div>
        </div>
      <% } else { %>
        <img src="<%= toolPage.image %>" alt="<%= toolPage.title %> preview image">
      <% } %>
    </div>
  </div>
</section>

<% if (toolPage.visualGallery && toolPage.visualGallery.length) { %>
  <section class="generator-section tool-visual-section">
    <div class="container">
      <div class="generator-section-header">
        <span class="generator-eyebrow"><%= toolPage.examplesEyebrow || 'Examples' %></span>
        <h2><%= toolPage.examplesTitle || 'Mockup examples for real apparel workflows' %></h2>
        <p><%= toolPage.examplesSubtitle || 'Show the garment, artwork placement, and product framing clearly before you print, sample, or publish.' %></p>
      </div>
      <div class="tool-visual-grid">
        <% toolPage.visualGallery.forEach(function(item) { %>
          <article class="tool-visual-card">
            <img src="<%= item.image %>" alt="<%= item.title %>">
            <div>
              <h3><%= item.title %></h3>
              <p><%= item.caption %></p>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<section class="generator-section">
  <div class="container">
    <div class="tool-answer-grid">
      <div>
        <span class="generator-eyebrow"><%= toolPage.planningEyebrow || 'Plan faster' %></span>
        <h2><%= toolPage.planningTitle || 'Turn a garment idea into a clearer mockup direction' %></h2>
      </div>
      <p><%= toolPage.intent %></p>
    </div>
  </div>
</section>

<% if (toolPage.slug === 't-shirt-mockup-generator' && toolPage.modelStarters && toolPage.modelStarters.length) { %>
  <section class="generator-section tool-model-starters">
    <div class="container">
      <div class="generator-section-header">
        <span class="generator-eyebrow">Choose a T-shirt model</span>
        <h2>Start your T-shirt mockup with the right fit</h2>
        <p>Pick a classic, oversized, polo, or long-sleeve model before testing garment colors and artwork placement.</p>
      </div>
      <div class="generator-output-grid">
        <% toolPage.modelStarters.forEach(function(model) { %>
          <a class="generator-output-card" href="<%= model.href %>">
            <h3><%= model.title %></h3>
            <p><%= model.body %></p>
            <strong>Open free 3D model →</strong>
          </a>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>

<section class="generator-section generator-section-muted">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow"><%= toolPage.benefitsEyebrow || 'Why teams use it' %></span>
      <h2><%= toolPage.benefitsTitle || 'Preview the product before you spend on samples' %></h2>
      <p><%= toolPage.benefitsSubtitle || 'Use ClothingDesign when you need clear apparel direction quickly, without waiting for photography, physical samples, or another PSD pack.' %></p>
    </div>
    <div class="generator-output-grid">
      <% toolPage.competitorInsights.forEach(function(insight) { %>
        <article class="generator-output-card">
          <h3><%= insight.title || 'Why it helps' %></h3>
          <p><%= insight.body || insight %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>


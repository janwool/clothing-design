<% if (toolPage.heroModel && toolPage.heroModel.src) { %>
  <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
  <script>
    (() => {
      const viewer = document.getElementById('toolHeroModelViewer');
      const preview = document.querySelector('.tool-live-preview');
      const upload = document.getElementById('toolArtworkUpload');
      const download = document.getElementById('toolDownloadPreview');
      const status = document.getElementById('toolPreviewStatus');
      const isBulkTool = <%- JSON.stringify(toolPage.slug === 'bulk-t-shirt-mockup-generator') %>;
      if (!viewer || !preview) return;

      const hexFactor = (hex) => {
        const value = parseInt(String(hex).replace('#', ''), 16);
        return [((value >> 16) & 255) / 255, ((value >> 8) & 255) / 255, (value & 255) / 255, 1];
      };

      const applyColor = (hex) => {
        const materials = viewer.model?.materials || [];
        materials.forEach((material) => material.pbrMetallicRoughness?.setBaseColorFactor?.(hexFactor(hex)));
        status.textContent = 'Garment color updated. Upload artwork to continue in the full editor.';
      };

      document.querySelectorAll('.tool-color-swatch').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.tool-color-swatch').forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          applyColor(button.dataset.color);
        });
      });

      document.querySelectorAll('.tool-angle-controls button').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.tool-angle-controls button').forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          viewer.removeAttribute('auto-rotate');
          viewer.cameraOrbit = button.dataset.orbit;
          viewer.jumpCameraToGoal?.();
          status.textContent = `${button.textContent} view selected.`;
        });
      });

      upload?.addEventListener('change', () => {
        const file = upload.files?.[0];
        if (!file) return;
        if (file.size > 8 * 1024 * 1024) {
          status.textContent = 'Choose an artwork file smaller than 8 MB.';
          upload.value = '';
          return;
        }
        const reader = new FileReader();
        reader.onload = () => {
          try {
            sessionStorage.setItem('clothingdesign_pending_artwork', JSON.stringify({
              dataUrl: reader.result,
              name: file.name,
              createdAt: Date.now()
            }));
          } catch (error) {
            status.textContent = 'The artwork is too large to transfer. Open the editor and upload it there.';
            return;
          }
          window.location.href = preview.dataset.editorHref;
        };
        reader.readAsDataURL(file);
      });

      download?.addEventListener('click', async () => {
        try {
          status.textContent = isBulkTool ? 'Rendering four garment colorways...' : 'Preparing transparent preview...';
          await customElements.whenDefined('model-viewer');
          if (isBulkTool) {
            const colors = ['#f7f7f5', '#171717', '#506b5d', '#a54b43'];
            const snapshots = [];
            for (const color of colors) {
              applyColor(color);
              await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
              const snapshot = viewer.toDataURL?.('image/png');
              if (!snapshot) throw new Error('Colorway export unavailable');
              snapshots.push({ color, snapshot });
            }
            const tileSize = 900;
            const canvas = document.createElement('canvas');
            canvas.width = tileSize * 2;
            canvas.height = tileSize * 2;
            const context = canvas.getContext('2d');
            context.fillStyle = '#f5f5f7';
            context.fillRect(0, 0, canvas.width, canvas.height);
            for (let index = 0; index < snapshots.length; index += 1) {
              const item = snapshots[index];
              const image = new Image();
              await new Promise((resolve, reject) => {
                image.onload = resolve;
                image.onerror = reject;
                image.src = item.snapshot;
              });
              const x = (index % 2) * tileSize;
              const y = Math.floor(index / 2) * tileSize;
              context.drawImage(image, x, y, tileSize, tileSize);
              context.fillStyle = item.color;
              context.beginPath();
              context.arc(x + 54, y + tileSize - 54, 22, 0, Math.PI * 2);
              context.fill();
              context.strokeStyle = 'rgba(0, 0, 0, 0.2)';
              context.stroke();
            }
            const link = document.createElement('a');
            link.href = canvas.toDataURL('image/png');
            link.download = 'bulk-t-shirt-colorway-sheet.png';
            document.body.appendChild(link);
            link.click();
            link.remove();
            status.textContent = 'Four-color T-shirt mockup sheet downloaded.';
            return;
          }
          const dataUrl = viewer.toDataURL?.('image/png');
          if (!dataUrl) throw new Error('Preview export unavailable');
          const link = document.createElement('a');
          link.href = dataUrl;
          link.download = '<%= toolPage.slug %>-preview.png';
          document.body.appendChild(link);
          link.click();
          link.remove();
          status.textContent = 'Transparent PNG downloaded.';
        } catch (error) {
          status.textContent = 'Open the full editor to export this model.';
        }
      });
    })();
  </script>
<% } %>


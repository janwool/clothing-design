<%- include('partials/header') %>

<% const featured = articles[0]; %>
<section class="guide-index-hero" aria-labelledby="guide-index-title">
  <div class="container guide-index-hero-grid">
    <div class="guide-index-intro">
      <span class="guide-eyebrow">Design guides <span aria-hidden="true">/</span> ClozDesign</span>
      <h1 id="guide-index-title">Apparel mockup and 3D clothing design guides.</h1>
      <p>Practical answers for choosing garment models, placing artwork, preparing product images, and reviewing a collection before production.</p>
      <a class="guide-primary-link" href="#all-guides">Explore all guides <span aria-hidden="true">↗</span></a>
    </div>
    <a class="guide-featured" href="/blog/<%= featured.slug %>" aria-label="Featured guide: <%= featured.title %>">
      <div class="guide-featured-image">
        <img src="<%= featured.image %>" alt="<%= featured.imageAlt %>" width="960" height="620" fetchpriority="high">
      </div>
      <div class="guide-featured-copy">
        <span class="guide-eyebrow">Featured guide</span>
        <h2><%= featured.title %></h2>
        <span class="guide-read-time"><%= featured.readingTime %> min read <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  </div>
</section>

<section class="guide-library" id="all-guides" aria-labelledby="guide-library-title">
  <div class="container">
    <div class="guide-library-heading">
      <div>
        <span class="guide-eyebrow">The library</span>
        <h2 id="guide-library-title">Explore the design guides</h2>
      </div>
      <span class="guide-library-count"><%= articles.length %> guides</span>
    </div>
    <div class="guide-filters" role="group" aria-label="Filter guides by topic">
      <button type="button" class="is-active" data-guide-filter="all" aria-pressed="true">All guides</button>
      <% [...new Set(articles.map(article => article.category))].forEach(function(category) { %>
        <button type="button" data-guide-filter="<%= category %>" aria-pressed="false"><%= category %></button>
      <% }); %>
    </div>
    <p class="visually-hidden" id="guide-filter-status" role="status" aria-live="polite"><%= articles.length %> guides shown</p>
    <div class="guide-grid">
      <% articles.forEach(function(article) { %>
        <article class="guide-card" data-guide-category="<%= article.category %>">
          <a class="guide-card-image" href="/blog/<%= article.slug %>" tabindex="-1" aria-hidden="true">
            <img src="<%= article.image %>" alt="" width="480" height="300" loading="lazy" decoding="async">
          </a>
          <div class="guide-card-copy">
            <span class="guide-eyebrow"><%= article.category %></span>
            <h3><a href="/blog/<%= article.slug %>"><%= article.title %></a></h3>
            <p><%= article.dek %></p>
            <span class="guide-read-time"><%= article.readingTime %> min read <span aria-hidden="true">↗</span></span>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="guide-method" aria-labelledby="guide-method-title">
  <div class="container guide-method-grid">
    <div class="guide-method-image">
      <img src="/images/design-guide/index.webp" alt="Ivory T-shirt photographed in a neutral studio" width="600" height="600" loading="lazy" decoding="async">
    </div>
    <div class="guide-method-copy">
      <span class="guide-eyebrow">Editorial method</span>
      <h2 id="guide-method-title">Written for the decisions behind the image.</h2>
      <p>Each guide starts with a direct answer, then covers the choices that affect the final mockup: garment shape, artwork placement, color, presentation, and export.</p>
      <a href="/mockups">Browse editable 3D models <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<script src="/js/blog-guide.js?v=20260926-v1" defer></script>
<%- include('partials/footer') %>

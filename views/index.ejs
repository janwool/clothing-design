<%- include('partials/header') %>
<%
  const activeHomepageModel = homeContent.primaryModel;
  const activeHomepageModelHref = `/3d-models/${activeHomepageModel.category_slug}/${activeHomepageModel.slug}#design`;
  const homepageModelCards = Array.isArray(homeContent.modelCards) ? homeContent.modelCards : [];
%>

<section class="home-canvas home-entry" aria-labelledby="home-entry-heading">
  <div class="home-canvas-shell">
    <header class="home-entry-intro">
      <span class="home-entry-kicker">3D MODELS · WHITE MOCKUPS</span>
      <h1 id="home-entry-heading">Create apparel designs with<br> 3D models and white mockups.</h1>
      <p>Choose a garment, test color and artwork, then see every idea from every angle or on a real silhouette.</p>
    </header>
    <div class="home-entry-grid">
      <a class="home-entry-card home-entry-card-models" href="/mockups" data-analytics-event="home_entry_3d_models_click">
        <span class="home-entry-copy">
          <strong>Explore 3D Models</strong>
          <span class="home-entry-arrow" aria-hidden="true">&#8594;</span>
        </span>
        <img src="<%= activeHomepageModel.image_url %>" alt="<%= activeHomepageModel.name %> 3D model" width="1200" height="1500" fetchpriority="high" decoding="async">
      </a>
      <a class="home-entry-card home-entry-card-mockups" href="/white-mockups" data-analytics-event="home_entry_white_mockups_click">
        <span class="home-entry-copy">
          <strong>Browse White Mockups</strong>
          <span class="home-entry-arrow" aria-hidden="true">&#8594;</span>
        </span>
        <img src="/images/mockups/on-model/generated/young-western-female-tee-v4-base.png" alt="Model wearing a blank white T-shirt" width="1024" height="1536" fetchpriority="high" decoding="async">
      </a>
    </div>
    <div class="home-definition">
      <h2>What is ClozDesign?</h2>
      <p>A browser-based apparel mockup workspace built around editable 3D garments and on-model white mockups.</p>
    </div>
  </div>
</section>

<section class="home-canvas home-model-library" aria-labelledby="home-model-heading">
  <div class="home-canvas-shell home-split-layout">
    <div class="home-product-stage home-scroll-reveal" data-home-model-stage aria-busy="true">
      <model-viewer
        class="home-model-viewer"
        data-home-model-viewer
        src="<%= activeHomepageModel.file_url %>"
        poster="<%= activeHomepageModel.image_url %>"
        alt="Interactive <%= activeHomepageModel.name %> 3D model"
        loading="lazy"
        reveal="auto"
        camera-controls
        interaction-prompt="none"
        shadow-intensity="0.32"
        shadow-softness="0.9"
        exposure="0.7"
        environment-image="/environments/commercial-apparel-studio-v4-balanced-20260829.hdr"
        tone-mapping="commerce"
        camera-orbit="-16deg 76deg 108%"
        min-camera-orbit="auto 55deg 82%"
        max-camera-orbit="auto 105deg 145%"
      ></model-viewer>
      <span class="home-model-loading" data-home-model-loading aria-live="polite"><i aria-hidden="true"></i>Loading 3D</span>
      <span class="home-model-gesture" aria-hidden="true">Drag to rotate</span>
      <span class="home-model-caption" aria-hidden="true">Same garment.<br>Every angle.<br>More possibilities.</span>
      <a class="home-model-editor-link" href="<%= activeHomepageModelHref %>" data-analytics-event="home_3d_tshirt_design_click">Open in 3D editor <span aria-hidden="true">&#8594;</span></a>
      <span class="home-orbit-mark" aria-hidden="true">
        <svg viewBox="0 0 120 24" role="presentation"><path d="M3 12c15-12 99-12 114 0-15 12-99 12-114 0Z"/><path d="m110 8 7 4-7 4"/></svg>
      </span>
    </div>
    <div class="home-section-copy home-scroll-reveal">
      <span class="home-eyebrow">3D LIBRARY</span>
      <h2 id="home-model-heading">Start with the right shape.</h2>
      <p>Explore a growing library of editable 3D clothing models. Adjust details, test color and artwork, and view your design from every angle.</p>
      <nav class="home-category-grid" aria-label="3D model categories">
        <% homepageModelCards.forEach(function(card) {%>
          <a class="home-category-card" href="/mockups?q=<%= encodeURIComponent(card.query) %>#free-3d-models" data-analytics-event="<%= card.analytics %>">
            <img src="<%= card.image_url %>" alt="" width="1200" height="1500" loading="lazy"><span><%= card.label %></span><i aria-hidden="true">&#8594;</i>
          </a>
        <% });%>
        <a class="home-category-card" href="/mockups" data-analytics-event="home_category_more_click">
          <span class="home-category-count">100+</span><span>More models</span><i aria-hidden="true">&#8594;</i>
        </a>
      </nav>
    </div>
  </div>
</section>

<section class="home-canvas home-white-mockups" aria-labelledby="home-white-mockups-heading">
  <div class="home-canvas-shell home-split-layout home-white-layout">
    <div class="home-mockup-carousel home-scroll-reveal" data-home-carousel aria-roledescription="carousel" aria-label="White mockup examples">
      <div class="home-carousel-viewport">
        <div class="home-carousel-track" data-home-carousel-track>
          <figure class="home-carousel-slide" data-home-carousel-slide><img src="/images/mockups/on-model/generated/young-western-female-tee-v4-base.png" alt="Woman wearing a blank white T-shirt" width="1024" height="1536" loading="lazy" decoding="async"></figure>
          <figure class="home-carousel-slide" data-home-carousel-slide><img src="/images/mockups/on-model/generated/crewneck-tee-male-front-base.png" alt="Man wearing a blank white T-shirt" width="1024" height="1536" loading="lazy" decoding="async"></figure>
          <figure class="home-carousel-slide" data-home-carousel-slide><img src="/images/mockups/on-model/generated/young-western-female-hoodie-v5-base.png" alt="Woman wearing a blank white hoodie" width="1024" height="1536" loading="lazy" decoding="async"></figure>
        </div>
      </div>
      <button class="home-carousel-control home-carousel-control-prev" type="button" data-home-carousel-prev aria-label="Previous mockup">&#8592;</button>
      <button class="home-carousel-control home-carousel-control-next" type="button" data-home-carousel-next aria-label="Next mockup">&#8594;</button>
      <div class="home-carousel-dots" role="group" aria-label="Choose mockup slide">
        <button type="button" data-home-carousel-dot="0" aria-label="Show mockup 1" aria-current="true"></button>
        <button type="button" data-home-carousel-dot="1" aria-label="Show mockup 2"></button>
        <button type="button" data-home-carousel-dot="2" aria-label="Show mockup 3"></button>
      </div>
    </div>
    <div class="home-section-copy home-scroll-reveal">
      <span class="home-eyebrow">ON-MODEL WHITE MOCKUPS</span>
      <h2 id="home-white-mockups-heading">See every idea on a real silhouette.</h2>
      <p>Switch between people, poses and garment types, then place artwork and adjust color directly in the browser.</p>
      <a class="home-text-link" href="/white-mockups" data-analytics-event="home_white_mockups_browse_click">Browse White Mockups <span aria-hidden="true">&#8594;</span></a>
    </div>
  </div>
</section>

<section class="home-canvas home-production" aria-labelledby="home-production-heading">
  <div class="home-canvas-shell">
    <div class="home-production-copy home-scroll-reveal">
      <span class="home-eyebrow">PRODUCTION</span>
      <h2 id="home-production-heading">From mockup to what comes next.</h2>
      <p>A clearer path from design to production.</p>
    </div>
    <ol class="home-production-flow home-scroll-reveal">
      <li>
        <div class="home-production-media home-production-media-garment"><img src="<%= activeHomepageModel.image_url %>" alt="Designed 3D T-shirt" width="1200" height="1500" loading="lazy"><span class="home-production-print" aria-hidden="true">CLOZ</span></div>
        <div class="home-production-step-copy"><strong>1. 3D Design</strong><span>Customize a model and finalize your design.</span></div>
      </li>
      <li><div class="home-production-media"><img src="/images/mockups/on-model/generated/young-western-female-tee-v4-base.png" alt="On-model white T-shirt review" width="1024" height="1536" loading="lazy"></div><div class="home-production-step-copy"><strong>2. On-Model Review</strong><span>See your design on real silhouettes.</span></div></li>
      <li><div class="home-production-media"><img src="/images/hero/apparel-design-hero-v3.webp" alt="Apparel collection review visual" width="1120" height="1400" loading="lazy"></div><div class="home-production-step-copy"><strong>3. Collection Review</strong><span>Compare styles and build your range.</span></div></li>
      <li><div class="home-production-media home-production-package" aria-hidden="true"><span>CLOZDESIGN</span></div><div class="home-production-step-copy"><strong>4. Supplier Handoff</strong><span>Share visuals and specs with your manufacturer.</span></div></li>
    </ol>
  </div>
</section>

<section class="home-final-cta" aria-labelledby="home-final-heading">
  <div class="home-final-inner home-scroll-reveal">
    <div class="home-final-copy">
      <span class="home-eyebrow">ClozDesign</span>
      <h2 id="home-final-heading">Start with the right model.<br>Make every apparel idea clearer.</h2>
      <p>3D models and white mockups for a more confident creative process.</p>
    </div>
    <a class="home-final-panel" href="/mockups" data-analytics-event="home_bottom_model_library_click">
      <img src="<%= activeHomepageModel.image_url %>" alt="" width="1200" height="1500" loading="lazy">
      <span>Explore the collection <i aria-hidden="true">&#8594;</i></span>
    </a>
  </div>
</section>

<script src="/js/home-v2.js?v=20260916-active-3d-v1" defer></script>
<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title"><%= t('home.heroTitle') %></h1>
      <p class="hero-subtitle"><%= t('home.heroSubtitle') %></p>
      <div class="hero-actions">
        <a href="/design-3d" class="btn btn-primary btn-large"><%= t('home.startDesigning') %></a>
        <a href="/gallery" class="btn btn-ghost btn-large"><%= t('home.browseModels') %></a>
      </div>
    </div>
    <div class="hero-visual">
      <!-- Placeholder for 3D model showcase -->
      <div class="hero-placeholder">
        <div class="placeholder-3d">
          <div class="model-preview">
            <div class="model-body"></div>
            <div class="model-sleeve-left"></div>
            <div class="model-sleeve-right"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <h2 class="section-title"><%= t('home.featuresTitle') %></h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
            <path d="M20 5L35 15V30L20 38L5 30V15L20 5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <path d="M20 20L20 38" stroke="currentColor" stroke-width="2"/>
            <path d="M20 20L35 15" stroke="currentColor" stroke-width="2"/>
            <path d="M20 20L5 15" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <h3 class="feature-title"><%= t('home.feature1Title') %></h3>
        <p class="feature-desc"><%= t('home.feature1Desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
            <rect x="5" y="8" width="30" height="24" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M5 16H35" stroke="currentColor" stroke-width="2"/>
            <path d="M12 12H16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="feature-title"><%= t('home.feature2Title') %></h3>
        <p class="feature-desc"><%= t('home.feature2Desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
            <path d="M8 32L14 14L20 26L26 10L32 32" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8" cy="32" r="3" stroke="currentColor" stroke-width="2"/>
            <circle cx="32" cy="32" r="3" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <h3 class="feature-title"><%= t('home.feature3Title') %></h3>
        <p class="feature-desc"><%= t('home.feature3Desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
            <rect x="6" y="6" width="28" height="28" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M6 14H34" stroke="currentColor" stroke-width="2"/>
            <path d="M14 6V34" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <h3 class="feature-title"><%= t('home.feature4Title') %></h3>
        <p class="feature-desc"><%= t('home.feature4Desc') %></p>
      </div>
    </div>
  </div>
</section>

<section class="cta">
  <div class="container">
    <div class="cta-content">
      <h2 class="cta-title"><%= t('home.ctaTitle') %></h2>
      <p class="cta-subtitle"><%= t('home.ctaSubtitle') %></p>
      <a href="/auth/register" class="btn btn-primary btn-large"><%= t('home.getStarted') %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

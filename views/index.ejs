<%- include('partials/header') %>
<% const content = homeContent || {}; %>
<% const heroImages = content.heroImages || []; %>
<% const stats = content.stats || []; %>
<% const workflow = content.workflow || []; %>
<% const useCases = content.useCases || []; %>
<% const faq = content.faq || []; %>
<% const featuredModels = content.featuredModels || []; %>
<% const featuredCategories = content.featuredCategories || []; %>

<section class="home-hero">
  <div class="container home-hero-container">
    <div class="home-hero-content">
      <span class="generator-eyebrow home-hero-reveal">Free browser apparel studio</span>
      <h1 class="home-hero-reveal">Put your artwork on a real garment shape.</h1>
      <p class="home-hero-reveal">
        Choose a 3D garment, place a graphic, check front and back views,
        then export a transparent PNG for product pages, POD listings, and review.
      </p>
      <div class="hero-actions home-hero-reveal">
        <a href="/3d-models/t-shirt-mockup/basic-short-sleeve-tshirt-3d-model#design" class="btn btn-primary btn-large" data-analytics-event="home_hero_mockup_tool_click">Start with a T-shirt</a>
        <a href="/mockups" class="btn btn-secondary btn-large" data-analytics-event="home_hero_models_click">Choose another garment</a>
      </div>
      <% if (stats.length) { %>
        <dl class="home-hero-stats home-hero-reveal">
          <% stats.forEach(function(stat) { %>
            <div>
              <dt><%= stat.value %></dt>
              <dd><%= stat.label %></dd>
            </div>
          <% }); %>
        </dl>
      <% } %>
    </div>

    <div class="home-studio-preview home-hero-reveal" aria-label="ClothingDesign mockup workflow preview">
      <div class="home-studio-topbar">
        <div>
          <span class="home-studio-status"><i></i> Browser studio</span>
          <strong>T-shirt mockup</strong>
        </div>
        <span>Transparent PNG</span>
      </div>
      <div class="home-studio-body">
        <ol class="home-studio-steps">
          <li class="is-active"><span>01</span><strong>Garment</strong></li>
          <li><span>02</span><strong>Artwork</strong></li>
          <li><span>03</span><strong>Review</strong></li>
          <li><span>04</span><strong>Export</strong></li>
        </ol>
        <div class="home-studio-stage">
          <div class="home-studio-grid" aria-hidden="true"></div>
          <% if (heroImages[0]) { %>
            <img src="<%= heroImages[0].src %>" alt="<%= heroImages[0].alt %> ready for artwork placement" width="1200" height="1500" decoding="async" fetchpriority="high">
          <% } %>
          <div class="home-artwork-zone" aria-hidden="true">
            <span>CLOZ</span>
            <small>Artwork zone</small>
          </div>
          <div class="home-view-switcher" aria-hidden="true"><span class="active">Front</span><span>Side</span><span>Back</span></div>
        </div>
      </div>
      <div class="home-studio-footer">
        <span><i></i> No install required</span>
        <a href="/3d-models/t-shirt-mockup/basic-short-sleeve-tshirt-3d-model#design">Open this workspace →</a>
      </div>
    </div>
  </div>
</section>

<section class="home-answer-section home-reveal">
  <div class="container">
    <div class="home-answer-grid">
      <div>
        <span class="generator-eyebrow home-copy-reveal">Quick answer</span>
        <h2 class="home-copy-reveal">What is ClothingDesign?</h2>
      </div>
      <p class="home-copy-reveal">
        ClothingDesign is a free 3D clothing model library and browser-based apparel mockup workspace.
        Choose a garment, preview artwork placement, test colors, and create clean product visuals before
        samples, photoshoots, or product pages are ready.
      </p>
    </div>
  </div>
</section>

<section class="generator-section home-tshirt-cluster home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Popular T-shirt workflow</span>
      <h2 class="home-copy-reveal">Create a free T-shirt mockup from the right starting point</h2>
      <p class="home-copy-reveal">Choose the generator for a guided workflow, browse every T-shirt fit, or open the classic crew-neck model directly.</p>
    </div>
    <div class="generator-output-grid">
      <a class="generator-output-card home-reveal-card" href="/tools/t-shirt-mockup-generator" data-analytics-event="home_tshirt_generator_click">
        <h3 class="home-copy-reveal">T-shirt mockup generator</h3>
        <p class="home-copy-reveal">Test garment colors, artwork placement, viewing angles, and product-image direction in one workflow.</p>
        <strong>Start a T-shirt mockup →</strong>
      </a>
      <a class="generator-output-card home-reveal-card" href="/mockups/t-shirt-mockup" data-analytics-event="home_tshirt_models_click">
        <h3 class="home-copy-reveal">Free T-shirt 3D models</h3>
        <p class="home-copy-reveal">Compare classic, oversized, polo, and long-sleeve models before choosing a blank.</p>
        <strong>Browse T-shirt models →</strong>
      </a>
      <a class="generator-output-card home-reveal-card" href="/3d-models/t-shirt-mockup/basic-short-sleeve-tshirt-3d-model#design" data-analytics-event="home_tshirt_classic_model_click">
        <h3 class="home-copy-reveal">Basic short-sleeve T-shirt</h3>
        <p class="home-copy-reveal">Open a familiar blank directly in the design studio for chest logos, front graphics, back prints, and POD listings.</p>
        <strong>Customize this T-shirt →</strong>
      </a>
    </div>
  </div>
</section>

<section class="generator-section home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Mockup workflow</span>
      <h2 class="home-copy-reveal">From free 3D garment model to finished mockup direction</h2>
      <p class="home-copy-reveal">A focused browser workflow for apparel teams, print-on-demand stores, merch brands, and product-page planning.</p>
    </div>
    <div class="generator-steps">
      <% workflow.forEach(function(step, index) { %>
        <article class="generator-step <%= step.image_url ? 'generator-step-with-media' : '' %> home-reveal-card">
          <% if (step.image_url) { %>
            <div class="generator-step-media">
              <img src="<%= step.image_url %>" alt="<%= step.title %> apparel mockup workflow step" loading="lazy">
            </div>
          <% } %>
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <h3 class="home-copy-reveal"><%= step.title %></h3>
          <p class="home-copy-reveal"><%= step.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<% if (featuredCategories.length) { %>
<section class="generator-section generator-section-muted home-reveal">
  <div class="container">
    <div class="generator-section-header generator-section-header-row">
      <span class="generator-eyebrow home-copy-reveal">Free model categories</span>
      <h2 class="home-copy-reveal">Browse 3D clothing models by garment type</h2>
      <p class="home-copy-reveal">Find shirts, hoodies, dresses, coats, pants, bags, hats, skirts, and other apparel models for mockup and print placement work.</p>
    </div>
    <div class="generator-category-grid">
      <% featuredCategories.forEach(function(category) { %>
        <a href="/mockups/<%= category.slug %>" class="generator-category-card home-reveal-card" data-analytics-event="home_category_<%= category.slug %>_select" data-analytics-item="<%= category.name %>" data-analytics-category="<%= category.slug %>">
          <% if (category.image_url) { %>
            <div class="generator-category-media">
              <img src="<%= category.image_url %>" alt="Free <%= category.name %> 3D clothing model mockup category" loading="lazy">
            </div>
          <% } %>
          <div class="generator-category-copy">
            <small class="home-copy-reveal">Free mockup category</small>
            <strong class="home-copy-reveal"><%= category.name %></strong>
          </div>
          <svg class="generator-category-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="generator-section home-tool-links home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Free mockup tools</span>
      <h2 class="home-copy-reveal">Start with the garment you actually need</h2>
      <p class="home-copy-reveal">Open a live 3D garment, test colors and views, upload artwork, then export a transparent apparel mockup.</p>
    </div>
    <div class="tool-picker-grid home-reveal-card">
      <a href="/tools/t-shirt-mockup-generator">T-shirt mockup generator</a>
      <a href="/tools/oversized-t-shirt-mockup-generator">Oversized T-shirt mockup</a>
      <a href="/tools/front-and-back-t-shirt-mockup">Front and back T-shirt mockup</a>
      <a href="/tools/dress-designer">Online dress designer</a>
      <a href="/tools/polo-shirt-mockup-generator">Polo shirt mockup generator</a>
      <a href="/tools/long-sleeve-shirt-mockup-generator">Long sleeve shirt mockup</a>
      <a href="/tools/streetwear-hoodie-mockup-generator">Streetwear hoodie mockup</a>
      <a href="/tools/transparent-apparel-mockup-generator">Transparent apparel mockup</a>
      <a href="/tools/print-on-demand-mockup-generator">POD clothing mockup generator</a>
    </div>
  </div>
</section>

<% if (featuredModels.length) { %>
<section class="home-featured-models home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Featured models</span>
      <h2 class="home-copy-reveal">Popular free 3D apparel models for mockups</h2>
      <p class="home-copy-reveal">Open a model detail page to view the garment, plan artwork placement, customize colors, and export a clean transparent product image.</p>
    </div>
    <div class="models-grid">
      <% featuredModels.forEach(function(model) { %>
        <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="model-card home-reveal-card" data-analytics-event="home_model_<%= model.slug %>_select" data-analytics-item="<%= model.name %>" data-analytics-category="<%= model.category_slug || model.category %>">
          <div class="model-preview-3d">
            <% if (model.image_url) { %>
              <img src="<%= model.image_url %>" alt="<%= model.name %>" class="model-img">
            <% } else { %>
              <div class="model-placeholder">
                <span><%= model.name.charAt(0) %></span>
              </div>
            <% } %>
          </div>
          <div class="model-info">
            <h3 class="model-name home-copy-reveal"><%= model.name %></h3>
            <p class="model-meta home-copy-reveal"><%= model.category_label || model.category %></p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="generator-section generator-section-muted home-reveal" id="use-cases">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Use cases</span>
      <h2 class="home-copy-reveal">Built for apparel mockups, not generic 3D downloads</h2>
      <p class="home-copy-reveal">Use ClothingDesign when you need free garment models, quick print placement previews, transparent product images, and mockup-ready visuals for real apparel workflows.</p>
    </div>
    <div class="generator-output-grid">
      <% useCases.forEach(function(item) { %>
        <article class="generator-output-card <%= item.image_url ? 'generator-output-card-with-media' : '' %> home-reveal-card">
          <% if (item.image_url) { %>
            <div class="generator-output-media">
              <img src="<%= item.image_url %>" alt="<%= item.title %> apparel mockup use case" loading="lazy">
            </div>
          <% } %>
          <h3 class="home-copy-reveal"><%= item.title %></h3>
          <p class="home-copy-reveal"><%= item.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-section generator-faq-section home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">FAQ</span>
      <h2 class="home-copy-reveal">Free 3D clothing model questions</h2>
    </div>
    <div class="generator-faq-list">
      <% faq.forEach(function(item, index) { %>
        <details class="generator-faq-item home-reveal-card" data-analytics-event="home_faq_<%= index + 1 %>_toggle" data-analytics-item="<%= item.question %>" <%= index === 0 ? 'open' : '' %>>
          <summary class="home-copy-reveal"><%= item.question %></summary>
          <p class="home-copy-reveal"><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<section class="pattern-design-cta home-reveal">
  <div class="container">
    <div class="pattern-design-cta-inner">
      <div>
        <span class="generator-eyebrow home-copy-reveal">Start designing</span>
        <h2 class="home-copy-reveal">Start with a free 3D clothing model and create a clearer apparel mockup.</h2>
        <p class="home-copy-reveal">Choose a garment model, test print placement, adjust the surface design, and export product visuals for review or listing pages.</p>
      </div>
      <div class="generator-final-actions">
        <a href="/tools/t-shirt-mockup-generator" class="btn btn-primary" data-analytics-event="home_bottom_models_click">Start a guided mockup</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

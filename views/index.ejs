<%- include('partials/header') %>
<% const content = homeContent || {}; %>
<% const heroImages = content.heroImages || []; %>
<% const stats = content.stats || []; %>
<% const workflow = content.workflow || []; %>
<% const useCases = content.useCases || []; %>
<% const faq = content.faq || []; %>
<% const featuredModels = content.featuredModels || []; %>
<% const featuredCategories = content.featuredCategories || []; %>

<section class="home-hero">
  <div class="home-hero-media" aria-hidden="true">
    <% heroImages.forEach(function(image, index) { %>
      <img src="<%= image.src %>" alt="" class="home-hero-model home-hero-model-<%= index + 1 %>">
    <% }); %>
  </div>
  <div class="container home-hero-container">
    <div class="home-hero-content">
      <span class="generator-eyebrow">Design3D apparel mockups</span>
      <h1>3D Clothing Design and Apparel Mockup Generator</h1>
      <p>
        Customize web-ready 3D clothing models, preview artwork on realistic garment shapes,
        and export high-resolution transparent renders for ecommerce, fashion reviews, and product launches.
      </p>
      <div class="hero-actions">
        <a href="/design-3d" class="btn btn-primary btn-large">Browse 3D Models</a>
        <a href="/patterns" class="btn btn-secondary btn-large">Browse Sewing Patterns</a>
      </div>
      <% if (stats.length) { %>
        <dl class="home-hero-stats">
          <% stats.forEach(function(stat) { %>
            <div>
              <dt><%= stat.value %></dt>
              <dd><%= stat.label %></dd>
            </div>
          <% }); %>
        </dl>
      <% } %>
    </div>
  </div>
</section>

<section class="home-answer-section">
  <div class="container">
    <div class="home-answer-grid">
      <div>
        <span class="generator-eyebrow">Quick answer</span>
        <h2>What can you do with ClothingDesign?</h2>
      </div>
      <p>
        ClothingDesign helps apparel teams create 3D garment mockups online. Pick a model,
        add colors or artwork, inspect the design in the browser, and download a clean render
        before samples, photoshoots, or final product pages are ready.
      </p>
    </div>
  </div>
</section>

<section class="generator-section">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow">Workflow</span>
      <h2>From garment model to finished apparel preview</h2>
      <p>A focused Design3D workflow for product teams, print-on-demand stores, fashion designers, and brand presentation work.</p>
    </div>
    <div class="generator-steps">
      <% workflow.forEach(function(step, index) { %>
        <article class="generator-step">
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <h3><%= step.title %></h3>
          <p><%= step.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<% if (featuredCategories.length) { %>
<section class="generator-section generator-section-muted">
  <div class="container">
    <div class="generator-section-header generator-section-header-row">
      <span class="generator-eyebrow">Model categories</span>
      <h2>Start with the right clothing silhouette</h2>
      <p>Browse SEO-friendly Design3D categories and choose the garment base closest to your product idea.</p>
    </div>
    <div class="generator-category-grid">
      <% featuredCategories.forEach(function(category) { %>
        <a href="/3d-models/<%= category.slug %>" class="generator-category-card">
          <small>Design3D category</small>
          <strong><%= category.name %></strong>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (featuredModels.length) { %>
<section class="home-featured-models">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow">Featured models</span>
      <h2>Popular 3D apparel models for mockups</h2>
      <p>Open a model detail page to view the garment, read use cases, customize artwork, and export an HD transparent render.</p>
    </div>
    <div class="models-grid">
      <% featuredModels.forEach(function(model) { %>
        <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="model-card">
          <div class="model-preview-3d">
            <% if (model.image_url) { %>
              <img src="<%= model.image_url %>" alt="<%= model.name %>" class="model-img">
            <% } else { %>
              <div class="model-placeholder">
                <span><%= model.name.charAt(0) %></span>
              </div>
            <% } %>
          </div>
          <div class="model-info">
            <h3 class="model-name"><%= model.name %></h3>
            <p class="model-meta"><%= model.category_label || model.category %></p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="generator-section generator-section-muted">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow">Use cases</span>
      <h2>Built for apparel content that needs to be understood fast</h2>
      <p>Clear model names, descriptive URLs, detail-page FAQs, and structured data help both search engines and AI answer systems understand every garment resource.</p>
    </div>
    <div class="generator-output-grid">
      <% useCases.forEach(function(item) { %>
        <article class="generator-output-card">
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-section generator-faq-section">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow">FAQ</span>
      <h2>3D clothing design questions</h2>
    </div>
    <div class="generator-faq-list">
      <% faq.forEach(function(item, index) { %>
        <details class="generator-faq-item" <%= index === 0 ? 'open' : '' %>>
          <summary><%= item.question %></summary>
          <p><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<section class="pattern-design-cta">
  <div class="container">
    <div class="pattern-design-cta-inner">
      <div>
        <span class="generator-eyebrow">Start designing</span>
        <h2>Create your next 3D apparel mockup.</h2>
        <p>Choose a garment model, customize the surface design, and export a clean render for review or product presentation.</p>
      </div>
      <div class="generator-final-actions">
        <a href="/design-3d" class="btn btn-primary">Browse Design3D models</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

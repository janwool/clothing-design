<%- include('partials/header') %>
<% const content = homeContent || {}; %>
<% const heroImages = content.heroImages || []; %>
<% const stats = content.stats || []; %>
<% const workflow = content.workflow || []; %>
<% const useCases = content.useCases || []; %>
<% const faq = content.faq || []; %>
<% const featuredModels = content.featuredModels || []; %>
<% const featuredCategories = content.featuredCategories || []; %>

<section class="home-hero">
  <div class="home-hero-media" aria-hidden="true">
    <% heroImages.forEach(function(image, index) { %>
      <img src="<%= image.src %>" alt="" class="home-hero-model home-hero-model-<%= index + 1 %>">
    <% }); %>
  </div>
  <div class="container home-hero-container">
    <div class="home-hero-content">
      <span class="generator-eyebrow home-hero-reveal">Free apparel mockup resources</span>
      <h1 class="home-hero-reveal">Free 3D Clothing Models for Apparel Mockups</h1>
      <p class="home-hero-reveal">
        Browse free 3D garment models, place artwork on clothing, preview print placement,
        and export clean product images for ecommerce, POD listings, and design review.
      </p>
      <div class="hero-actions home-hero-reveal">
        <a href="/mockups" class="btn btn-primary btn-large">Browse Free 3D Models</a>
        <a href="/tools/3d-clothing-mockup-generator" class="btn btn-secondary btn-large">Create a Clothing Mockup</a>
      </div>
      <% if (stats.length) { %>
        <dl class="home-hero-stats home-hero-reveal">
          <% stats.forEach(function(stat) { %>
            <div>
              <dt><%= stat.value %></dt>
              <dd><%= stat.label %></dd>
            </div>
          <% }); %>
        </dl>
      <% } %>
    </div>
  </div>
</section>

<section class="home-answer-section home-reveal">
  <div class="container">
    <div class="home-answer-grid">
      <div>
        <span class="generator-eyebrow home-copy-reveal">Quick answer</span>
        <h2 class="home-copy-reveal">What is ClothingDesign?</h2>
      </div>
      <p class="home-copy-reveal">
        ClothingDesign is a free 3D clothing model library and browser-based apparel mockup workspace.
        Choose a garment, preview artwork placement, test colors, and create clean product visuals before
        samples, photoshoots, or product pages are ready.
      </p>
    </div>
  </div>
</section>

<section class="generator-section home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Mockup workflow</span>
      <h2 class="home-copy-reveal">From free 3D garment model to finished mockup direction</h2>
      <p class="home-copy-reveal">A focused browser workflow for apparel teams, print-on-demand stores, merch brands, and product-page planning.</p>
    </div>
    <div class="generator-steps">
      <% workflow.forEach(function(step, index) { %>
        <article class="generator-step <%= step.image_url ? 'generator-step-with-media' : '' %> home-reveal-card">
          <% if (step.image_url) { %>
            <div class="generator-step-media">
              <img src="<%= step.image_url %>" alt="<%= step.title %> apparel mockup workflow step" loading="lazy">
            </div>
          <% } %>
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <h3 class="home-copy-reveal"><%= step.title %></h3>
          <p class="home-copy-reveal"><%= step.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<% if (featuredCategories.length) { %>
<section class="generator-section generator-section-muted home-reveal">
  <div class="container">
    <div class="generator-section-header generator-section-header-row">
      <span class="generator-eyebrow home-copy-reveal">Free model categories</span>
      <h2 class="home-copy-reveal">Browse 3D clothing models by garment type</h2>
      <p class="home-copy-reveal">Find shirts, hoodies, dresses, coats, pants, bags, hats, skirts, and other apparel models for mockup and print placement work.</p>
    </div>
    <div class="generator-category-grid">
      <% featuredCategories.forEach(function(category) { %>
        <a href="/3d-models/<%= category.slug %>" class="generator-category-card home-reveal-card">
          <% if (category.image_url) { %>
            <div class="generator-category-media">
              <img src="<%= category.image_url %>" alt="Free <%= category.name %> 3D clothing model mockup category" loading="lazy">
            </div>
          <% } %>
          <div class="generator-category-copy">
            <small class="home-copy-reveal">Free mockup category</small>
            <strong class="home-copy-reveal"><%= category.name %></strong>
          </div>
          <svg class="generator-category-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<% if (featuredModels.length) { %>
<section class="home-featured-models home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Featured models</span>
      <h2 class="home-copy-reveal">Popular free 3D apparel models for mockups</h2>
      <p class="home-copy-reveal">Open a model detail page to view the garment, plan artwork placement, customize colors, and export a clean transparent product image.</p>
    </div>
    <div class="models-grid">
      <% featuredModels.forEach(function(model) { %>
        <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="model-card home-reveal-card">
          <div class="model-preview-3d">
            <% if (model.image_url) { %>
              <img src="<%= model.image_url %>" alt="<%= model.name %>" class="model-img">
            <% } else { %>
              <div class="model-placeholder">
                <span><%= model.name.charAt(0) %></span>
              </div>
            <% } %>
          </div>
          <div class="model-info">
            <h3 class="model-name home-copy-reveal"><%= model.name %></h3>
            <p class="model-meta home-copy-reveal"><%= model.category_label || model.category %></p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="generator-section generator-section-muted home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">Use cases</span>
      <h2 class="home-copy-reveal">Built for apparel mockups, not generic 3D downloads</h2>
      <p class="home-copy-reveal">Use ClothingDesign when you need free garment models, quick print placement previews, transparent product images, and mockup-ready visuals for real apparel workflows.</p>
    </div>
    <div class="generator-output-grid">
      <% useCases.forEach(function(item) { %>
        <article class="generator-output-card <%= item.image_url ? 'generator-output-card-with-media' : '' %> home-reveal-card">
          <% if (item.image_url) { %>
            <div class="generator-output-media">
              <img src="<%= item.image_url %>" alt="<%= item.title %> apparel mockup use case" loading="lazy">
            </div>
          <% } %>
          <h3 class="home-copy-reveal"><%= item.title %></h3>
          <p class="home-copy-reveal"><%= item.text %></p>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="generator-section generator-faq-section home-reveal">
  <div class="container">
    <div class="generator-section-header">
      <span class="generator-eyebrow home-copy-reveal">FAQ</span>
      <h2 class="home-copy-reveal">Free 3D clothing model questions</h2>
    </div>
    <div class="generator-faq-list">
      <% faq.forEach(function(item, index) { %>
        <details class="generator-faq-item home-reveal-card" <%= index === 0 ? 'open' : '' %>>
          <summary class="home-copy-reveal"><%= item.question %></summary>
          <p class="home-copy-reveal"><%= item.answer %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>

<section class="pattern-design-cta home-reveal">
  <div class="container">
    <div class="pattern-design-cta-inner">
      <div>
        <span class="generator-eyebrow home-copy-reveal">Start designing</span>
        <h2 class="home-copy-reveal">Start with a free 3D clothing model and create a clearer apparel mockup.</h2>
        <p class="home-copy-reveal">Choose a garment model, test print placement, adjust the surface design, and export product visuals for review or listing pages.</p>
      </div>
      <div class="generator-final-actions">
        <a href="/mockups" class="btn btn-primary">Browse free 3D clothing models</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

    <div class="gallery-grid">
      <!-- Gallery Item 1 -->
      <div class="gallery-item">
        <div class="gallery-image">
          <svg viewBox="0 0 400 500" class="gallery-svg">
            <rect width="400" height="500" fill="#f5f5f5"/>
            <path d="M140 80 L260 80 L280 120 L260 140 L240 120 L240 400 L160 400 L160 120 L140 140 L120 120 Z" fill="#e8e8e8" stroke="#999" stroke-width="1"/>
            <path d="M160 120 L240 120" stroke="#999" stroke-width="0.5" stroke-dasharray="4"/>
            <circle cx="200" cy="250" r="60" fill="none" stroke="#ccc" stroke-width="1"/>
            <text x="200" y="450" text-anchor="middle" fill="#999" font-size="14">T-Shirt Design</text>
          </svg>
        </div>
        <div class="gallery-info">
          <h3 class="gallery-title">Minimalist Tee</h3>
          <p class="gallery-author">by Sarah Chen</p>
          <div class="gallery-tags">
            <span class="tag">3D</span>
            <span class="tag">Casual</span>
          </div>
        </div>
      </div>


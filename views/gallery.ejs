<%- include('partials/header') %>

<section class="page-header">
  <div class="container">
    <h1 class="page-title"><%= t('gallery.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('gallery.pageSubtitle') %></p>
  </div>
</section>


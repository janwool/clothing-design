<%- include('partials/header') %>
<% const mockupPagination = typeof catalogPagination !== 'undefined' && catalogPagination ? catalogPagination : { page: 1, pageCount: 1, total: models.length, start: models.length ? 1 : 0, end: models.length, pages: [1] }; %>
<% const mockupTotal = typeof catalogTotal !== 'undefined' ? catalogTotal : models.length; %>
<% const mockupResultTotal = typeof catalogResultTotal !== 'undefined' ? catalogResultTotal : mockupPagination.total; %>
<% const mockupQuery = typeof catalogQuery !== 'undefined' && catalogQuery ? catalogQuery : { q: '', sort: 'featured' }; %>
<% const mockupPageHref = function(pageNumber) {
  const params = [];
  if (pageNumber > 1) params.push(`page=${pageNumber}`);
  if (mockupQuery.q) params.push(`q=${encodeURIComponent(mockupQuery.q)}`);
  if (mockupQuery.sort && mockupQuery.sort !== 'featured') params.push(`sort=${encodeURIComponent(mockupQuery.sort)}`);
  return `/mockups${params.length ? `?${params.join('&')}` : ''}#free-3d-models`;
}; %>

<section class="page-header">
  <div class="container">
    <div class="category-breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span><%= t('design3d.pageTitle') %></span>
    </div>
    <h1 class="page-title"><%= t('design3d.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('design3d.pageSubtitle') %></p>
    <div class="category-hero-meta mockup-library-meta">
      <span><%= mockupTotal ? `${mockupTotal} free 3D models` : 'Free 3D model library' %></span>
      <span>Browser-based customization</span>
      <span>Transparent PNG export</span>
    </div>
    <div class="category-hero-actions">
      <a href="#free-3d-models" class="btn btn-primary">Browse free models</a>
      <a href="/tools/3d-clothing-mockup-generator" class="btn btn-secondary">Open 3D mockup generator</a>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <form class="catalog-toolbar" action="/mockups#free-3d-models" method="get" role="search">
      <label class="catalog-search-field">
        <span>Find a garment</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" value="<%= mockupQuery.q %>" placeholder="Try hoodie, V-neck, coat…" autocomplete="off">
      </label>
      <label class="catalog-sort-field">
        <span>Sort</span>
        <select name="sort" onchange="this.form.submit()">
          <option value="featured" <%= mockupQuery.sort === 'featured' ? 'selected' : '' %>>Category order</option>
          <option value="name" <%= mockupQuery.sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
          <option value="newest" <%= mockupQuery.sort === 'newest' ? 'selected' : '' %>>Recently updated</option>
        </select>
      </label>
      <button class="btn btn-primary" type="submit">Search models</button>
      <% if (mockupQuery.q || mockupQuery.sort !== 'featured') { %>
        <a class="catalog-clear" href="/mockups#free-3d-models">Clear</a>
      <% } %>
    </form>

    <nav class="mockup-intent-links" aria-label="Popular 3D clothing mockup searches">
      <a href="/mockups/jacket">Jacket 3D models</a>
      <a href="/mockups/pants">3D pants design models</a>
      <a href="/mockups/dress">Free dress mockups</a>
      <a href="/mockups/shirt">Shirt 3D models</a>
      <a href="/tools/dress-designer">Online dress designer</a>
      <a href="/tools/transparent-apparel-mockup-generator">Transparent apparel mockups</a>
    </nav>

    <!-- Filters -->
    <div class="filters-bar">
      <div class="filter-group">
        <a href="/mockups" class="filter-btn active">
          <%- include('partials/category-icon', { slug: 'all', name: t('design3d.filterAll') }) %>
          <span><%= t('design3d.filterAll') %></span>
        </a>
        <% categories.forEach(function(cat) { %>
          <a href="/mockups/<%= cat.slug %>" class="filter-btn">
            <%- include('partials/category-icon', { slug: cat.slug, name: cat.name }) %>
            <span><%= cat.name %></span>
          </a>
        <% }); %>
      </div>
    </div>

    <div class="mockup-library-heading" id="free-3d-models">
      <div>
        <span class="generator-eyebrow">3D mockup clothing library</span>
        <h2><%= mockupQuery.q ? `Results for “${mockupQuery.q}”` : 'Choose a free 3D clothing model' %></h2>
      </div>
      <p><strong><%= mockupResultTotal %></strong> <%= mockupResultTotal === 1 ? 'model' : 'models' %>. Open a garment to inspect its shape, test artwork placement, and create a mockup for ecommerce, print-on-demand, or design review.</p>
    </div>

    <!-- 3D Models Grid -->
    <div class="models-grid">
      <% if (models && models.length > 0) { %>
        <% models.forEach(function(model) { %>
          <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="model-card" data-category="<%= model.category_slug || model.category %>">
            <div class="model-preview-3d">
              <% if (model.image_url) { %>
                <img src="<%= model.image_url %>" alt="Free <%= model.name %> 3D clothing model and apparel mockup" class="model-img" loading="lazy">
              <% } else { %>
                <div class="model-placeholder">
                  <span><%= model.name.charAt(0) %></span>
                </div>
              <% } %>
            </div>
              <div class="model-info">
                <h3 class="model-name"><%= model.name %></h3>
                <div class="model-tags">
                  <span class="tag tag-free">Free</span>
                  <span class="tag">3D mockup</span>
                </div>
              </div>
            </a>
        <% }); %>
      <% } else { %>
        <div class="empty-state">
          <strong>No garments match this search.</strong>
          <p>Try a broader garment type or clear the current filters.</p>
          <a class="btn btn-secondary" href="/mockups#free-3d-models">Clear search</a>
        </div>
      <% } %>
    </div>

    <% if (mockupPagination.pageCount > 1) { %>
      <div class="catalog-pagination-shell">
        <p class="catalog-pagination-summary">
          Showing <strong><%= mockupPagination.start %>–<%= mockupPagination.end %></strong> of <strong><%= mockupPagination.total %></strong> models
        </p>
        <nav class="catalog-pagination" aria-label="3D model pages">
          <% if (mockupPagination.page > 1) { %>
            <a class="catalog-page-direction" href="<%= mockupPageHref(mockupPagination.page - 1) %>" rel="prev" aria-label="Previous page">← <span>Previous</span></a>
          <% } else { %>
            <span class="catalog-page-direction is-disabled" aria-disabled="true">← <span>Previous</span></span>
          <% } %>
          <div class="catalog-page-numbers">
            <% mockupPagination.pages.forEach(function(pageNumber) { %>
              <% if (pageNumber === null) { %>
                <span class="catalog-page-ellipsis" aria-hidden="true">…</span>
              <% } else if (pageNumber === mockupPagination.page) { %>
                <span class="catalog-page-number is-current" aria-current="page"><%= pageNumber %></span>
              <% } else { %>
                <a class="catalog-page-number" href="<%= mockupPageHref(pageNumber) %>" aria-label="Page <%= pageNumber %>"><%= pageNumber %></a>
              <% } %>
            <% }); %>
          </div>
          <% if (mockupPagination.page < mockupPagination.pageCount) { %>
            <a class="catalog-page-direction" href="<%= mockupPageHref(mockupPagination.page + 1) %>" rel="next" aria-label="Next page"><span>Next</span> →</a>
          <% } else { %>
            <span class="catalog-page-direction is-disabled" aria-disabled="true"><span>Next</span> →</span>
          <% } %>
        </nav>
      </div>
    <% } %>
  </div>
</section>

<% if (mockupPagination.page === 1 && !mockupQuery.q) { %>
  <%- include('partials/generator-sections', { landingContent, categories, models: (typeof catalogModels !== 'undefined' ? catalogModels : models) }) %>
<% } %>

<%- include('partials/footer') %>

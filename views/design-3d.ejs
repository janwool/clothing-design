<%- include('partials/header', { bodyClass: 'category-catalog-page all-models-catalog-page mockup-library-page' }) %>
<%
  const mockupPagination = typeof catalogPagination !== 'undefined' && catalogPagination
    ? catalogPagination
    : { page: 1, pageCount: 1, total: models.length, start: models.length ? 1 : 0, end: models.length, pages: [1] };
  const mockupTotal = typeof catalogTotal !== 'undefined' ? catalogTotal : models.length;
  const activeMockupCategory = typeof activeCategory !== 'undefined' && activeCategory ? activeCategory : null;
  const mockupBasePath = activeMockupCategory ? `/mockups/${activeMockupCategory.slug}` : '/mockups';
  const currentCatalogTotal = activeMockupCategory
    ? (typeof currentCategoryTotal !== 'undefined' ? currentCategoryTotal : mockupPagination.total)
    : mockupTotal;
  const mockupQuery = typeof catalogQuery !== 'undefined' && catalogQuery ? catalogQuery : { q: '', sort: 'featured' };
  const mockupPageHref = function(pageNumber) {
    const params = [];
    if (pageNumber > 1) params.push(`page=${pageNumber}`);
    if (mockupQuery.q) params.push(`q=${encodeURIComponent(mockupQuery.q)}`);
    if (mockupQuery.sort && mockupQuery.sort !== 'featured') params.push(`sort=${encodeURIComponent(mockupQuery.sort)}`);
    return `${mockupBasePath}${params.length ? `?${params.join('&')}` : ''}#free-3d-models`;
  };
  const allModelCountLabel = currentCatalogTotal ? `${currentCatalogTotal} free 3D models` : 'Free 3D model library';
  const libraryFaqItems = activeMockupCategory && typeof landingContent !== 'undefined'
    ? (landingContent.faq?.items || [])
    : [
      { question: 'What types of clothing models are available?', answer: 'The library includes T-shirts, shirts, hoodies, dresses, pants and other garment categories. Use the category menu or search to find a style.' },
      { question: 'What can I customize?', answer: 'Open a model to adjust garment colors and materials, place artwork, and change the viewing angle in the browser editor.' },
      { question: 'How can I use apparel mockups?', answer: 'Use apparel mockups to review artwork placement and color options, present designs, or prepare product visuals. A mockup does not replace a physical garment sample or a manufacturing tech pack.' }
    ];
  const masonryTones = ['ice', 'white', 'mist', 'cloud', 'frost', 'silver'];

%>

<div class="mockups-page-shell">
  <aside class="mockups-sidebar" aria-label="3D model library navigation">
    <div class="mockups-sidebar-inner">
      <nav class="mockups-sidebar-nav" aria-label="Garment categories">
        <a href="/mockups#free-3d-models" class="<%= activeMockupCategory ? '' : 'is-active' %>" <%= activeMockupCategory ? '' : 'aria-current="page"' %>>
          <svg class="category-filter-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="6.5" height="6.5" rx="1"/>
            <rect x="14" y="3.5" width="6.5" height="6.5" rx="1"/>
            <rect x="3.5" y="14" width="6.5" height="6.5" rx="1"/>
            <rect x="14" y="14" width="6.5" height="6.5" rx="1"/>
          </svg>
          <span>All models</span>
          <strong><%= mockupTotal %></strong>
        </a>
        <% categories.forEach(function(cat) { %>
          <a href="/mockups/<%= cat.slug %>" class="<%= activeMockupCategory && cat.slug === activeMockupCategory.slug ? 'is-active' : '' %>" <%= activeMockupCategory && cat.slug === activeMockupCategory.slug ? 'aria-current="page"' : '' %>>
            <%- include('partials/category-icon', { slug: cat.slug, name: cat.name }) %>
            <span><%= cat.name %></span>
            <strong><%= typeof categoryCounts !== 'undefined' && categoryCounts[cat.slug] ? categoryCounts[cat.slug] : '' %></strong>
          </a>
        <% }); %>
      </nav>

    </div>
  </aside>

  <div class="mockups-content">
    <header class="mockups-hero" aria-labelledby="mockups-hero-title">
      <div class="mockups-hero-shell">
        <div class="mockups-hero-copy">
          <h1 id="mockups-hero-title"><%= activeMockupCategory ? `${activeMockupCategory.name} 3D models` : '3D clothing models' %></h1>

          <p><%= activeMockupCategory ? `Browse ${activeMockupCategory.name.toLowerCase()} 3D models for apparel mockups. Customize garment colors, materials and artwork in the browser.` : 'Browse 3D clothing models for T-shirts, hoodies, shirts, dresses and pants. Customize garment colors, materials and artwork in the browser.' %></p>

          <div class="mockups-hero-tools">
            <form class="mockups-search" action="<%= mockupBasePath %>#free-3d-models" method="get" role="search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
              <label class="sr-only" for="mockups-search-input">Search 3D garment models</label>
              <input id="mockups-search-input" type="search" name="q" value="<%= mockupQuery.q %>" placeholder="Search garments and styles" autocomplete="off">
              <% if (mockupQuery.sort && mockupQuery.sort !== 'featured') { %>
                <input type="hidden" name="sort" value="<%= mockupQuery.sort %>">
              <% } %>
              <button class="sr-only" type="submit">Search models</button>
            </form>
            <span class="mockups-model-count" aria-label="<%= allModelCountLabel %>"><strong><%= currentCatalogTotal %></strong> models</span>
          </div>
        </div>

        <div class="mockups-hero-media">
          <picture>
            <source srcset="/images/hero/mockups-library-brand-studio-v2.webp" type="image/webp">
            <img src="/images/hero/mockups-library-brand-studio-v2.webp" alt="Ivory T-shirt, charcoal hoodie and ivory dress in the daylight ClozDesign studio" width="1536" height="1024" fetchpriority="high" decoding="async">
          </picture>
        </div>
      </div>
    </header>

    <section class="mockups-catalog" id="free-3d-models">
  <div class="mockups-catalog-shell">
    <div class="mockups-catalog-heading">
      <div>
        <h2><%= mockupQuery.q ? `Results for “${mockupQuery.q}”` : (activeMockupCategory ? `${activeMockupCategory.name} collection` : 'All models') %></h2>
        <p aria-live="polite">
          <% if (mockupPagination.total) { %>
            Showing <%= mockupPagination.start %>–<%= mockupPagination.end %> of <%= mockupPagination.total %>
          <% } else { %>
            No matching models
          <% } %>
        </p>
      </div>

      <form class="mockups-sort" action="<%= mockupBasePath %>#free-3d-models" method="get">
        <% if (mockupQuery.q) { %><input type="hidden" name="q" value="<%= mockupQuery.q %>"><% } %>
        <label class="sr-only" for="mockups-sort-select">Sort models</label>
        <select id="mockups-sort-select" name="sort" onchange="this.form.submit()" aria-label="Sort models">
          <option value="featured" <%= mockupQuery.sort === 'featured' ? 'selected' : '' %>>Featured</option>
          <option value="name" <%= mockupQuery.sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
          <option value="newest" <%= mockupQuery.sort === 'newest' ? 'selected' : '' %>>Newest</option>
        </select>
      </form>
    </div>

    <div class="models-grid mockups-masonry-grid">
      <% if (models && models.length > 0) { %>
        <% models.forEach(function(model, index) { %>
          <% const modelDisplayName = String(model.name || '').replace(/\s+(?:3D\s+)?(?:Garment\s+)?Model$/i, ''); %>
          <a href="/3d-models/<%= model.category_slug || model.category %>/<%= model.slug %>" class="model-card mockups-masonry-card mockups-card-<%= masonryTones[index % masonryTones.length] %>" data-category="<%= model.category_slug || model.category %>" aria-label="Open <%= modelDisplayName %> 3D model">
            <div class="model-preview-3d">
              <% if (model.image_url) { %>
                <img src="<%= model.cover_image_url || model.image_url %>" alt="" class="model-img" loading="lazy" decoding="async">
              <% } else { %>
                <div class="model-placeholder" aria-hidden="true"></div>
              <% } %>
              <span class="mockups-model-type-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M12 2.75 20 7.25v9.5l-8 4.5-8-4.5v-9.5l8-4.5Z"/>
                  <path d="m4 7.25 8 4.5 8-4.5M12 11.75v9.5"/>
                </svg>
                <span>3D</span>
              </span>
            </div>
            <span class="sr-only"><%= modelDisplayName %></span>
          </a>
        <% }); %>
      <% } else { %>
        <div class="empty-state all-catalog-empty-state">
          <strong>No garments match this search.</strong>
          <a class="btn btn-secondary" href="<%= mockupBasePath %>#free-3d-models">Clear search</a>
        </div>
      <% } %>
    </div>

    <% if (mockupPagination.pageCount > 1) { %>
      <div class="catalog-pagination-shell">
        <p class="catalog-pagination-summary">
          Showing <strong><%= mockupPagination.start %>–<%= mockupPagination.end %></strong> of <strong><%= mockupPagination.total %></strong> models
        </p>
        <nav class="catalog-pagination" aria-label="3D model pages">
          <% if (mockupPagination.page > 1) { %>
            <a class="catalog-page-direction" href="<%= mockupPageHref(mockupPagination.page - 1) %>" rel="prev" aria-label="Previous page">‹ <span>Previous</span></a>
          <% } else { %>
            <span class="catalog-page-direction is-disabled" aria-disabled="true">‹ <span>Previous</span></span>
          <% } %>
          <div class="catalog-page-numbers">
            <% mockupPagination.pages.forEach(function(pageNumber) { %>
              <% if (pageNumber === null) { %>
                <span class="catalog-page-ellipsis" aria-hidden="true">…</span>
              <% } else if (pageNumber === mockupPagination.page) { %>
                <span class="catalog-page-number is-current" aria-current="page"><%= pageNumber %></span>
              <% } else { %>
                <a class="catalog-page-number" href="<%= mockupPageHref(pageNumber) %>" aria-label="Page <%= pageNumber %>"><%= pageNumber %></a>
              <% } %>
            <% }); %>
          </div>
          <% if (mockupPagination.page < mockupPagination.pageCount) { %>
            <a class="catalog-page-direction" href="<%= mockupPageHref(mockupPagination.page + 1) %>" rel="next" aria-label="Next page"><span>Next</span> ›</a>
          <% } else { %>
            <span class="catalog-page-direction is-disabled" aria-disabled="true"><span>Next</span> ›</span>
          <% } %>
        </nav>
      </div>
    <% } %>
  </div>
</section>


<% if (mockupPagination.page === 1 && !mockupQuery.q) { %>
  <section class="category-field-guide all-catalog-field-guide" aria-labelledby="mockups-about-title">
    <div class="category-catalog-shell">
      <div class="category-field-guide-panel">
        <div class="category-field-guide-intro">
          <h2 id="mockups-about-title"><%= activeMockupCategory ? `${activeMockupCategory.name} apparel mockups` : '3D apparel mockups' %></h2>
          <p>Model types, customization and uses.</p>
        </div>
        <div class="generator-faq-list">
          <% libraryFaqItems.forEach(function(item) { %>
            <details class="generator-faq-item">
              <summary><%= item.question %></summary>
              <p><%= item.answer %></p>
            </details>
          <% }); %>
        </div>
        <nav class="category-field-guide-links" aria-label="Apparel mockup resources">
          <a href="/tools/3d-clothing-mockup-generator">3D mockup editor <span aria-hidden="true">›</span></a>
          <a href="/blog/3d-apparel-mockup-workflow">Apparel mockup workflow <span aria-hidden="true">›</span></a>
        </nav>
      </div>
    </div>
  </section>
<% } %>

  </div>
</div>

<script src="/js/catalog-reveal.js?v=20261011-v1" defer></script>
<%- include('partials/footer') %>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f6f1">
  <meta name="description" content="Explore a 3D clothing design made with ClozDesign.">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/shared-design.css?v=20260925-fullscreen-v2">
</head>
<body>
  <main class="share-page">
    <h1 class="visually-hidden"><%= share.name %></h1>
    <section class="share-stage" aria-label="<%= share.name %> 3D design">
      <% if (share.model_url) { %>
        <model-viewer
          src="<%= share.model_url %>"
          poster="<%= share.preview_image_url %>"
          alt="Interactive 3D view of <%= share.name %>"
          camera-controls
          disable-tap
          interaction-prompt="none"
          loading="eager"
          reveal="auto"
          camera-orbit="0deg 72deg 142%"
          field-of-view="28deg"
          shadow-intensity="0.32"
          shadow-softness="0.9"
          exposure="0.7"
          environment-image="/environments/commercial-apparel-studio-v5-front-white-20260917.hdr"
          tone-mapping="commerce"
        ></model-viewer>
      <% } else { %>
        <img class="share-poster" src="<%= share.preview_image_url %>" alt="Preview of <%= share.name %>">
      <% } %>
      <footer class="share-footer">
        <a class="share-brand" href="/" aria-label="ClozDesign home">
          <img src="/images/brand/clozdesign-icon.png" alt="" width="40" height="40">
          <span>ClozDesign</span>
        </a>
        <a class="share-create" href="<%= share.source_url %>">
          I want to design too <span aria-hidden="true">↗</span>
        </a>
      </footer>
    </section>
  </main>
  <% if (share.model_url) { %>
    <script>window.ModelViewerElement=window.ModelViewerElement||{};window.ModelViewerElement.meshoptDecoderLocation='/vendor/model-viewer/meshopt_decoder.js?v=three-0.183.0';</script>
    <script type="module" src="/vendor/model-viewer/model-viewer.min.js?v=4.3.1"></script>
  <% } %>
</body>
</html>

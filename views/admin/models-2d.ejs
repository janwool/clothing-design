<%- include('partials/header') %>

<div class="admin-wrapper">
  <%- include('partials/sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title">2D Templates</h1>
      <div class="admin-actions">
        <button class="btn btn-primary" onclick="openModal()">+ Add Template</button>
      </div>
    </div>

    <div class="data-card">
      <div class="data-header">
        <h2 class="data-title">All Templates</h2>
        <div class="data-search">
          <input type="text" class="search-input" placeholder="Search templates..." id="searchInput">
        </div>
      </div>

      <% if (items && items.length > 0) { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Category</th>
              <th>Format</th>
              <th>Tags</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr data-id="<%= item.id %>">
                <td>#<%= item.id %></td>
                <td><%= item.name %></td>
                <td><%= item.category %></td>
                <td><%= item.format || 'svg' %></td>
                <td><%= item.tags || '-' %></td>
                <td>
                  <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
                </td>
                <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                <td>
                  <div class="table-actions">
                    <button class="btn btn-ghost btn-small" data-action="edit" data-id="<%= item.id %>">Edit</button>
                    <button class="btn btn-ghost btn-small btn-delete" data-action="delete" data-id="<%= item.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <line x1="3" y1="9" x2="21" y2="9"/>
            <line x1="9" y1="21" x2="9" y2="9"/>
          </svg>
          <h3>No templates yet</h3>
          <p>Add your first 2D template to get started.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modal" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Add 2D Template</h3>
      <button class="modal-close" onclick="closeModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <form id="templateForm">
        <input type="hidden" id="templateId">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" class="form-input" id="templateName" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Category</label>
            <select class="form-select" id="templateCategory" required>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.name %>"><%= cat.name %></option>
                <% }) %>
              <% } else { %>
                <option value="">No categories available</option>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Format</label>
            <select class="form-select" id="templateFormat">
              <option value="svg">SVG</option>
              <option value="ai">AI</option>
              <option value="psd">PSD</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-select" id="templateStatus">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <input type="text" class="form-input" id="templateTags" placeholder="e.g. Free, Vector">
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-textarea" id="templateDescription" rows="3"></textarea>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveTemplate()">Save</button>
    </div>
  </div>
</div>

<script>
const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const templateForm = document.getElementById('templateForm');

function openModal() {
  modalTitle.textContent = 'Add 2D Template';
  templateForm.reset();
  document.getElementById('templateId').value = '';
  modal.style.display = 'flex';
}

function closeModal() {
  modal.style.display = 'none';
}

function editTemplate(id) {
  const row = document.querySelector('tr[data-id="' + id + '"]');
  if (!row) return;

  const cells = row.querySelectorAll('td');
  document.getElementById('templateId').value = id;
  document.getElementById('templateName').value = cells[1].textContent;
  document.getElementById('templateCategory').value = cells[2].textContent;
  document.getElementById('templateFormat').value = cells[3].textContent;
  document.getElementById('templateTags').value = cells[4].textContent === '-' ? '' : cells[4].textContent;

  const statusBadge = cells[5].querySelector('.status-badge');
  document.getElementById('templateStatus').value = statusBadge ? statusBadge.textContent.trim() : 'active';

  modalTitle.textContent = 'Edit 2D Template';
  modal.style.display = 'flex';
}

async function saveTemplate() {
  const id = document.getElementById('templateId').value;
  const data = {
    name: document.getElementById('templateName').value,
    category: document.getElementById('templateCategory').value,
    format: document.getElementById('templateFormat').value,
    status: document.getElementById('templateStatus').value,
    tags: document.getElementById('templateTags').value,
    description: document.getElementById('templateDescription').value
  };

  const url = id ? '/admin/models-2d/' + id : '/admin/models-2d';
  const method = id ? 'PUT' : 'POST';

  try {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error saving template');
  }
}

async function deleteTemplate(id) {
  if (!confirm('Are you sure you want to delete this template?')) return;

  try {
    const response = await fetch('/admin/models-2d/' + id, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error deleting template');
  }
}

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
  const term = e.target.value.toLowerCase();
  document.querySelectorAll('.data-table tbody tr').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(term) ? '' : 'none';
  });
});

// Close modal on overlay click
modal.addEventListener('click', function(e) {
  if (e.target === modal) closeModal();
});

// Event delegation for edit/delete buttons
document.querySelector('.data-table tbody').addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const action = btn.getAttribute('data-action');
  if (action === 'edit') {
    editTemplate(id);
  } else if (action === 'delete') {
    deleteTemplate(id);
  }
});
</script>

<%- include('partials/footer') %>

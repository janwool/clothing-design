<%- include('partials/header') %>

<div class="admin-wrapper">
  <%- include('partials/sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title">Users</h1>
    </div>

    <div class="data-card">
      <div class="data-header">
        <h2 class="data-title">All Users</h2>
        <div class="data-search">
          <input type="text" class="search-input" placeholder="Search users..." id="searchInput">
        </div>
      </div>

      <% if (items && items.length > 0) { %>
        <div class="users-table-scroll" role="region" aria-label="Users table" tabindex="0">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Email</th>
              <th>Plan</th>
              <th>Projects</th>
              <th>Image storage</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr data-id="<%= item.id %>">
                <td>#<%= item.id %></td>
                <td><%= item.name || '-' %></td>
                <td><%= item.email %></td>
                <td>
                  <div class="user-plan-control" data-user-plan-control>
                    <select aria-label="Plan for <%= item.email %>" data-user-plan>
                      <% if (item.plan === 'max') { %><option value="max" selected disabled>Max (legacy)</option><% } %>
                      <% ['free', 'pro', 'business'].forEach(function(plan) { %>
                        <option value="<%= plan %>" <%= item.plan === plan ? 'selected' : '' %>><%= plan.charAt(0).toUpperCase() + plan.slice(1) %></option>
                      <% }); %>
                    </select>
                    <select aria-label="Billing interval for <%= item.email %>" data-user-billing <%= item.plan === 'free' || item.plan === 'business' ? 'disabled' : '' %>>
                      <option value="monthly" <%= item.billing_interval !== 'yearly' ? 'selected' : '' %>>Monthly</option>
                      <option value="yearly" <%= item.billing_interval === 'yearly' ? 'selected' : '' %>>Yearly</option>
                    </select>
                    <button class="btn btn-secondary btn-small" type="button" data-action="save-plan" data-id="<%= item.id %>">Save</button>
                  </div>
                </td>
                <td><%= item.project_count %></td>
                <td><%= item.storage_display %></td>
                <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                <td>
                  <div class="table-actions">
                    <button class="btn btn-ghost btn-small btn-delete" data-action="delete" data-id="<%= item.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <h3>No users yet</h3>
          <p>Users will appear here once they register.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
  const term = e.target.value.toLowerCase();
  document.querySelectorAll('.data-table tbody tr').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(term) ? '' : 'none';
  });
});

// Delete user
async function deleteUser(id) {
  if (!confirm('Are you sure you want to delete this user?')) return;

  try {
    const response = await fetch('/admin/users/' + id, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error deleting user');
  }
}

async function saveUserPlan(id, row) {
  const control = row.querySelector('[data-user-plan-control]');
  const plan = control.querySelector('[data-user-plan]').value;
  const billingInterval = control.querySelector('[data-user-billing]').value;
  const button = control.querySelector('[data-action="save-plan"]');
  button.disabled = true;
  try {
    const response = await fetch('/admin/users/' + id + '/plan', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ plan, billingInterval })
    });
    const result = await response.json();
    if (!response.ok || !result.success) throw new Error(result.error || 'Plan could not be updated.');
    button.textContent = 'Saved';
    window.setTimeout(() => { button.textContent = 'Save'; }, 1500);
  } catch (error) {
    alert(error.message || 'Plan could not be updated.');
  } finally {
    button.disabled = false;
  }
}

document.querySelectorAll('[data-user-plan]').forEach(select => {
  select.addEventListener('change', () => {
    const billing = select.closest('[data-user-plan-control]').querySelector('[data-user-billing]');
    billing.disabled = select.value === 'free' || select.value === 'business';
  });
});

// Event delegation for delete buttons
document.querySelector('.data-table tbody')?.addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const action = btn.getAttribute('data-action');
  if (action === 'delete') {
    deleteUser(id);
  } else if (action === 'save-plan') {
    saveUserPlan(id, btn.closest('tr'));
  }
});
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="admin-wrapper">
  <%- include('partials/sidebar') %>

  <main class="admin-main project-admin-main">
    <div class="admin-header project-page-header">
      <div>
        <span class="admin-eyebrow">Operations / Saved work</span>
        <h1 class="admin-title">User Projects</h1>
        <p class="admin-subtitle">A visual library of every 3D study and white mockup saved by your users.</p>
      </div>
      <button class="sidebar-toggle" type="button" aria-label="Open admin navigation">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>

    <section class="project-stats" aria-label="Project summary">
      <article class="project-stat project-stat-total">
        <span>All projects</span>
        <strong><%= projectStats.total %></strong>
        <small>Saved across the workspace</small>
      </article>
      <article class="project-stat">
        <span>3D studies</span>
        <strong><%= projectStats.projects3d %></strong>
        <small>Garment and material projects</small>
      </article>
      <article class="project-stat">
        <span>White mockups</span>
        <strong><%= projectStats.whiteMockups %></strong>
        <small>Print-ready composition work</small>
      </article>
      <article class="project-stat">
        <span>Creators</span>
        <strong><%= projectStats.creators %></strong>
        <small>Users with saved projects</small>
      </article>
    </section>

    <section class="project-library">
      <header class="project-library-header">
        <div>
          <span class="admin-eyebrow">Project library</span>
          <h2><%= projectPagination.total %> matching <%= projectPagination.total === 1 ? 'project' : 'projects' %></h2>
        </div>
        <form class="project-filters" action="/admin/projects" method="get">
          <label class="project-search-field">
            <span class="sr-only">Search projects</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="search" name="q" value="<%= projectFilters.search %>" placeholder="Project, user or ID…">
          </label>
          <select name="type" aria-label="Filter by project type">
            <option value="all" <%= projectFilters.type === 'all' ? 'selected' : '' %>>All project types</option>
            <option value="3d" <%= projectFilters.type === '3d' ? 'selected' : '' %>>3D studies</option>
            <option value="white_mockup" <%= projectFilters.type === 'white_mockup' ? 'selected' : '' %>>White mockups</option>
          </select>
          <button type="submit" class="btn btn-primary btn-small">Filter</button>
          <% if (projectFilters.search || projectFilters.type !== 'all') {%>
            <a href="/admin/projects" class="project-clear-filter">Clear</a>
          <% }%>
        </form>
      </header>

      <% if (error) {%>
        <div class="inquiry-error" role="alert"><%= error %></div>
      <% }%>

      <% if (items && items.length > 0) {%>
        <div class="project-admin-grid" id="projectAdminGrid">
          <% items.forEach(function(item, index) {%>
            <article class="project-admin-card" data-project-card="<%= item.id %>">
              <div class="project-admin-preview">
                <% if (item.preview_image_url_safe) {%>
                  <a href="<%= item.preview_image_url_safe %>" target="_blank" rel="noopener" aria-label="Open preview for <%= item.name %>">
                    <img src="<%= item.preview_image_url_safe %>" alt="<%= item.name %> preview" loading="lazy">
                  </a>
                <% } else {%>
                  <div class="project-admin-placeholder">
                    <span><%= String(index + 1 + ((projectPagination.page - 1) * 24)).padStart(2, '0') %></span>
                    <small>Preview unavailable</small>
                  </div>
                <% }%>
                <span class="project-type-chip project-type-<%= item.project_type === '3d' ? '3d' : 'mockup' %>">
                  <i aria-hidden="true"></i><%= item.project_type === '3d' ? '3D study' : 'White mockup' %>
                </span>
                <button class="project-delete-button" type="button" data-delete-project="<%= item.id %>" data-project-name="<%= item.name %>" aria-label="Delete <%= item.name %>">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"/>
                  </svg>
                </button>
              </div>
              <div class="project-admin-content">
                <div class="project-admin-owner">
                  <span class="project-owner-avatar"><%= String(item.user_name || item.user_email || '?').charAt(0).toUpperCase() %></span>
                  <div>
                    <strong><%= item.user_name || 'Unnamed user' %></strong>
                    <span><%= item.user_email || `User #${item.user_id}` %></span>
                  </div>
                </div>
                <div class="project-admin-title-row">
                  <div>
                    <h3><%= item.name %></h3>
                    <p>Updated <%= item.updated_at_display %></p>
                  </div>
                  <% if (item.source_url_safe) {%>
                    <a href="<%= item.source_url_safe %>" target="_blank" rel="noopener" aria-label="Open source page for <%= item.name %>">↗</a>
                  <% }%>
                </div>
                <dl class="project-admin-meta">
                  <div><dt>Project ID</dt><dd title="<%= item.id %>"><%= item.id %></dd></div>
                  <div><dt>Source</dt><dd title="<%= item.source_id || '—' %>"><%= item.source_id || '—' %></dd></div>
                </dl>
              </div>
            </article>
          <% });%>
        </div>

        <% if (projectPagination.pageCount > 1) {%>
          <nav class="inquiry-pagination project-pagination" aria-label="Project pages">
            <% if (projectPagination.page > 1) {%>
              <a href="/admin/projects?q=<%= encodeURIComponent(projectFilters.search) %>&type=<%= encodeURIComponent(projectFilters.type) %>&page=<%= projectPagination.page - 1 %>">← Previous</a>
            <% } else {%>
              <span>← Previous</span>
            <% }%>
            <strong>Page <%= projectPagination.page %> of <%= projectPagination.pageCount %></strong>
            <% if (projectPagination.page < projectPagination.pageCount) {%>
              <a href="/admin/projects?q=<%= encodeURIComponent(projectFilters.search) %>&type=<%= encodeURIComponent(projectFilters.type) %>&page=<%= projectPagination.page + 1 %>">Next →</a>
            <% } else {%>
              <span>Next →</span>
            <% }%>
          </nav>
        <% }%>
      <% } else if (!error) {%>
        <div class="empty-state project-empty-state">
          <div class="project-empty-mark" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/>
              <path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
            </svg>
          </div>
          <h3><%= projectFilters.search || projectFilters.type !== 'all' ? 'No matching projects' : 'No user projects yet' %></h3>
          <p><%= projectFilters.search || projectFilters.type !== 'all' ? 'Try another search or clear the active filter.' : 'Projects will appear here as soon as users save work from an editor.' %></p>
          <% if (projectFilters.search || projectFilters.type !== 'all') {%>
            <a href="/admin/projects" class="btn btn-secondary btn-small">Clear filters</a>
          <% }%>
        </div>
      <% }%>
    </section>

    <p class="project-action-message" id="projectActionMessage" role="status" aria-live="polite"></p>
  </main>
</div>

<script>
(() => {
  const grid = document.getElementById('projectAdminGrid');
  const message = document.getElementById('projectActionMessage');

  grid?.addEventListener('click', async event => {
    const button = event.target.closest('[data-delete-project]');
    if (!button) return;

    const projectId = button.dataset.deleteProject;
    const projectName = button.dataset.projectName || 'this project';
    if (!window.confirm(`Delete “${projectName}”? This removes the saved project for its user and cannot be undone.`)) return;

    button.disabled = true;
    try {
      const response = await fetch(`/admin/projects/${encodeURIComponent(projectId)}`, {
        method: 'DELETE',
        headers: { Accept: 'application/json' }
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.error || 'Project could not be deleted.');

      const card = button.closest('[data-project-card]');
      card?.classList.add('is-removing');
      window.setTimeout(() => window.location.reload(), 220);
    } catch (error) {
      button.disabled = false;
      message.textContent = error.message || 'Project could not be deleted.';
      message.classList.add('is-visible');
    }
  });
})();
</script>

<%- include('partials/footer') %>

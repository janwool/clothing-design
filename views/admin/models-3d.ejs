<%- include('partials/header') %>

<div class="admin-wrapper">
  <%- include('partials/sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title">3D Models</h1>
      <div class="admin-actions">
        <button class="btn btn-primary" onclick="openModal()">+ Add Model</button>
      </div>
    </div>

    <div class="data-card">
      <div class="data-header">
        <h2 class="data-title">All Models</h2>
        <div class="data-search">
          <input type="text" class="search-input" placeholder="Search models..." id="searchInput">
        </div>
      </div>

      <% if (items && items.length > 0) { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Preview</th>
              <th>Name</th>
              <th>Category</th>
              <th>Files</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr data-id="<%= item.id %>" data-item='<%- JSON.stringify(item) %>'>
                <td>#<%= item.id %></td>
                <td>
                  <% if (item.image_url) { %>
                    <img src="<%= item.image_url %>" alt="<%= item.name %>" class="table-preview" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;">
                  <% } else { %>
                    <div class="table-preview-placeholder" style="width: 48px; height: 48px; background: var(--gray-100); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--gray-400);">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  <% } %>
                </td>
                <td><%= item.name %></td>
                <td><%= item.category %></td>
                <td>
                  <div class="file-badges">
                    <% if (item.file_url) { %>
                      <span class="file-badge glb">GLB</span>
                    <% } %>
                    <% if (item.texture_url) { %>
                      <span class="file-badge svg">SVG</span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
                </td>
                <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                <td>
                  <div class="table-actions">
                    <button class="btn btn-ghost btn-small" data-action="edit" data-id="<%= item.id %>">Edit</button>
                    <button class="btn btn-ghost btn-small btn-delete" data-action="delete" data-id="<%= item.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
          </svg>
          <h3>No models yet</h3>
          <p>Add your first 3D model to get started.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modal" style="display: none;">
  <div class="modal-content" style="max-width: 640px;">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Add 3D Model</h3>
      <button class="modal-close" onclick="closeModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <form id="modelForm" enctype="multipart/form-data">
        <input type="hidden" id="modelId">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" class="form-input" id="modelName" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Category</label>
            <select class="form-select" id="modelCategory" required>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.name %>"><%= cat.name %></option>
                <% }) %>
              <% } else { %>
                <option value="">No categories available</option>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-select" id="modelStatus">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <input type="text" class="form-input" id="modelTags" placeholder="e.g. Free, 4K">
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-textarea" id="modelDescription" rows="3"></textarea>
        </div>

        <!-- File Uploads -->
        <div class="form-section">
          <h4 class="form-section-title">Files</h4>

          <div class="form-group">
            <label class="form-label">GLB File <span class="label-hint">(3D Model)</span></label>
            <div class="file-upload" id="glbUpload">
              <input type="file" name="glbFile" id="glbFile" accept=".glb" class="file-input" onchange="handleFileSelect(this, 'glbPreview')">
              <div class="file-upload-content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                <span class="file-upload-text">Click to upload GLB file</span>
                <span class="file-upload-hint">or drag and drop</span>
              </div>
              <div class="file-preview" id="glbPreview" style="display: none;">
                <span class="file-name"></span>
                <button type="button" class="file-remove" onclick="removeFile('glbFile', 'glbPreview')">×</button>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Preview Image <span class="label-hint">(PNG, JPG)</span></label>
            <div class="file-upload" id="previewUpload">
              <input type="file" name="previewImage" id="previewImage" accept="image/*" class="file-input" onchange="handleFileSelect(this, 'previewPreview')">
              <div class="file-upload-content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
                <span class="file-upload-text">Click to upload preview image</span>
                <span class="file-upload-hint">or drag and drop</span>
              </div>
              <div class="file-preview" id="previewPreview" style="display: none;">
                <img class="file-preview-img" src="" alt="Preview">
                <button type="button" class="file-remove" onclick="removeFile('previewImage', 'previewPreview')">×</button>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Texture SVG <span class="label-hint">(Optional)</span></label>
            <div class="file-upload" id="textureUpload">
              <input type="file" name="textureSvg" id="textureSvg" accept=".svg" class="file-input" onchange="handleFileSelect(this, 'texturePreview')">
              <div class="file-upload-content">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
                <span class="file-upload-text">Click to upload texture SVG</span>
                <span class="file-upload-hint">or drag and drop</span>
              </div>
              <div class="file-preview" id="texturePreview" style="display: none;">
                <span class="file-name"></span>
                <button type="button" class="file-remove" onclick="removeFile('textureSvg', 'texturePreview')">×</button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveModel()">Save</button>
    </div>
  </div>
</div>

<style>
.file-badges {
  display: flex;
  gap: 0.375rem;
}
.file-badge {
  font-size: 0.625rem;
  font-weight: 600;
  padding: 0.125rem 0.5rem;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}
.file-badge.glb {
  background: #dbeafe;
  color: #1e40af;
}
.file-badge.svg {
  background: #dcfce7;
  color: #166534;
}

.form-section {
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--gray-200);
}
.form-section-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--gray-900);
  margin-bottom: 1rem;
}

.label-hint {
  font-weight: 400;
  color: var(--gray-500);
  font-size: 0.75rem;
}

.file-upload {
  position: relative;
  border: 2px dashed var(--gray-300);
  border-radius: 8px;
  padding: 1.25rem;
  text-align: center;
  transition: border-color 0.2s, background 0.2s;
  cursor: pointer;
}
.file-upload:hover {
  border-color: var(--primary);
  background: var(--gray-50);
}
.file-upload.has-file {
  border-style: solid;
  border-color: var(--gray-300);
  background: var(--gray-50);
}
.file-input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}
.file-upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.375rem;
  color: var(--gray-500);
}
.file-upload-content svg {
  color: var(--gray-400);
  margin-bottom: 0.25rem;
}
.file-upload-text {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--gray-700);
}
.file-upload-hint {
  font-size: 0.75rem;
  color: var(--gray-500);
}
.file-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.5rem 0.75rem;
  background: var(--white);
  border-radius: 6px;
}
.file-preview-img {
  width: 40px;
  height: 40px;
  object-fit: cover;
  border-radius: 4px;
}
.file-name {
  font-size: 0.875rem;
  color: var(--gray-700);
  word-break: break-all;
  flex: 1;
}
.file-remove {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: var(--gray-200);
  color: var(--gray-600);
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
}
.file-remove:hover {
  background: var(--gray-300);
  color: var(--gray-900);
}
</style>

<script>
const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const modelForm = document.getElementById('modelForm');

function openModal() {
  modalTitle.textContent = 'Add 3D Model';
  modelForm.reset();
  document.getElementById('modelId').value = '';
  resetFilePreviews();
  modal.style.display = 'flex';
}

function closeModal() {
  modal.style.display = 'none';
}

function resetFilePreviews() {
  ['glbPreview', 'previewPreview', 'texturePreview'].forEach(id => {
    document.getElementById(id).style.display = 'none';
  });
  ['glbUpload', 'previewUpload', 'textureUpload'].forEach(id => {
    document.getElementById(id).classList.remove('has-file');
  });
}

function handleFileSelect(input, previewId) {
  const file = input.files[0];
  if (!file) return;

  const preview = document.getElementById(previewId);
  const uploadBox = input.closest('.file-upload');
  uploadBox.classList.add('has-file');
  preview.style.display = 'flex';

  if (previewId === 'previewPreview') {
    const img = preview.querySelector('.file-preview-img');
    img.src = URL.createObjectURL(file);
  } else {
    preview.querySelector('.file-name').textContent = file.name;
  }
}

function removeFile(inputId, previewId) {
  document.getElementById(inputId).value = '';
  document.getElementById(previewId).style.display = 'none';
  document.getElementById(inputId).closest('.file-upload').classList.remove('has-file');
}

function editModel(id) {
  const row = document.querySelector('tr[data-id="' + id + '"]');
  if (!row) return;

  const itemData = row.getAttribute('data-item');
  let item;
  try {
    item = JSON.parse(itemData);
  } catch (e) {
    return;
  }

  document.getElementById('modelId').value = id;
  document.getElementById('modelName').value = item.name || '';
  document.getElementById('modelCategory').value = item.category || 'tops';
  document.getElementById('modelTags').value = item.tags || '';
  document.getElementById('modelDescription').value = item.description || '';
  document.getElementById('modelStatus').value = item.status || 'active';

  resetFilePreviews();
  modalTitle.textContent = 'Edit 3D Model';
  modal.style.display = 'flex';
}

async function getUploadToken(filename, contentType, folder) {
  const response = await fetch('/admin/upload-token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ filename, contentType, folder })
  });
  const result = await response.json();
  if (!result.success) {
    throw new Error(result.error || 'Failed to get upload token');
  }
  return result;
}

async function uploadFileToR2(file, folder) {
  const uploadContentType = file.type || 'application/octet-stream';
  const token = await getUploadToken(file.name, uploadContentType, folder);

  const response = await fetch(token.signedUrl, {
    method: 'PUT',
    headers: {
      'Content-Type': uploadContentType,
    },
    body: file
  });

  if (!response.ok) {
    throw new Error('Upload failed: ' + response.statusText);
  }

  return token.publicUrl;
}

async function saveModel() {
  const id = document.getElementById('modelId').value;

  const glbFile = document.getElementById('glbFile').files[0];
  const previewImage = document.getElementById('previewImage').files[0];
  const textureSvg = document.getElementById('textureSvg').files[0];

  let file_url = null;
  let image_url = null;
  let texture_url = null;

  try {
    if (glbFile) {
      file_url = await uploadFileToR2(glbFile, 'd3');
    }
    if (previewImage) {
      image_url = await uploadFileToR2(previewImage, 'image');
    }
    if (textureSvg) {
      texture_url = await uploadFileToR2(textureSvg, 'd2');
    }
  } catch (err) {
    alert('Upload error: ' + err.message);
    return;
  }

  const data = {
    name: document.getElementById('modelName').value,
    category: document.getElementById('modelCategory').value,
    tags: document.getElementById('modelTags').value,
    description: document.getElementById('modelDescription').value,
    status: document.getElementById('modelStatus').value,
    file_url,
    image_url,
    texture_url
  };

  const url = id ? '/admin/models-3d/' + id : '/admin/models-3d';
  const method = id ? 'PUT' : 'POST';

  try {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error saving model');
  }
}

async function deleteModel(id) {
  if (!confirm('Are you sure you want to delete this model?')) return;

  try {
    const response = await fetch('/admin/models-3d/' + id, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error deleting model');
  }
}

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
  const term = e.target.value.toLowerCase();
  document.querySelectorAll('.data-table tbody tr').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(term) ? '' : 'none';
  });
});

// Close modal on overlay click
modal.addEventListener('click', function(e) {
  if (e.target === modal) closeModal();
});

// Event delegation for edit/delete buttons
document.querySelector('.data-table tbody').addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const action = btn.getAttribute('data-action');
  if (action === 'edit') {
    editModel(id);
  } else if (action === 'delete') {
    deleteModel(id);
  }
});
</script>

<%- include('partials/footer') %>

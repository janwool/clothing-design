<%- include('partials/header') %>

<div class="admin-wrapper">
  <%- include('partials/sidebar') %>

  <main class="admin-main">
    <div class="admin-header">
      <h1 class="admin-title">Tools</h1>
      <div class="admin-actions">
        <button class="btn btn-primary" onclick="openModal()">+ Add Tool</button>
      </div>
    </div>

    <div class="data-card">
      <div class="data-header">
        <h2 class="data-title">All Tools</h2>
        <div class="data-search">
          <input type="text" class="search-input" placeholder="Search tools..." id="searchInput">
        </div>
      </div>

      <% if (items && items.length > 0) { %>
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Type</th>
              <th>URL</th>
              <th>Tags</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr data-id="<%= item.id %>">
                <td>#<%= item.id %></td>
                <td><%= item.name %></td>
                <td><%= item.type %></td>
                <td><%= item.url || '-' %></td>
                <td><%= item.tags || '-' %></td>
                <td>
                  <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
                </td>
                <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                <td>
                  <div class="table-actions">
                    <button class="btn btn-ghost btn-small" data-action="edit" data-id="<%= item.id %>">Edit</button>
                    <button class="btn btn-ghost btn-small btn-delete" data-action="delete" data-id="<%= item.id %>">Delete</button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
          <h3>No tools yet</h3>
          <p>Add your first tool to get started.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal -->
<div class="modal-overlay" id="modal" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title" id="modalTitle">Add Tool</h3>
      <button class="modal-close" onclick="closeModal()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <form id="toolForm">
        <input type="hidden" id="toolId">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" class="form-input" id="toolName" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Category</label>
            <select class="form-select" id="toolType" required>
              <% if (categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.name %>"><%= cat.name %></option>
                <% }) %>
              <% } else { %>
                <option value="">No categories available</option>
              <% } %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-select" id="toolStatus">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">URL</label>
          <input type="url" class="form-input" id="toolUrl" placeholder="https://...">
        </div>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <input type="text" class="form-input" id="toolTags" placeholder="e.g. Free, Tutorial">
        </div>
        <div class="form-group">
          <label class="form-label">Description</label>
          <textarea class="form-textarea" id="toolDescription" rows="3"></textarea>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="saveTool()">Save</button>
    </div>
  </div>
</div>

<script>
const modal = document.getElementById('modal');
const modalTitle = document.getElementById('modalTitle');
const toolForm = document.getElementById('toolForm');

function openModal() {
  modalTitle.textContent = 'Add Tool';
  toolForm.reset();
  document.getElementById('toolId').value = '';
  modal.style.display = 'flex';
}

function closeModal() {
  modal.style.display = 'none';
}

function editTool(id) {
  const row = document.querySelector('tr[data-id="' + id + '"]');
  if (!row) return;

  const cells = row.querySelectorAll('td');
  document.getElementById('toolId').value = id;
  document.getElementById('toolName').value = cells[1].textContent;
  document.getElementById('toolType').value = cells[2].textContent;
  document.getElementById('toolUrl').value = cells[3].textContent === '-' ? '' : cells[3].textContent;
  document.getElementById('toolTags').value = cells[4].textContent === '-' ? '' : cells[4].textContent;

  const statusBadge = cells[5].querySelector('.status-badge');
  document.getElementById('toolStatus').value = statusBadge ? statusBadge.textContent.trim() : 'active';

  modalTitle.textContent = 'Edit Tool';
  modal.style.display = 'flex';
}

async function saveTool() {
  const id = document.getElementById('toolId').value;
  const data = {
    name: document.getElementById('toolName').value,
    type: document.getElementById('toolType').value,
    status: document.getElementById('toolStatus').value,
    url: document.getElementById('toolUrl').value,
    tags: document.getElementById('toolTags').value,
    description: document.getElementById('toolDescription').value
  };

  const url = id ? '/admin/tools/' + id : '/admin/tools';
  const method = id ? 'PUT' : 'POST';

  try {
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error saving tool');
  }
}

async function deleteTool(id) {
  if (!confirm('Are you sure you want to delete this tool?')) return;

  try {
    const response = await fetch('/admin/tools/' + id, { method: 'DELETE' });
    const result = await response.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Error: ' + result.error);
    }
  } catch (err) {
    alert('Error deleting tool');
  }
}

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
  const term = e.target.value.toLowerCase();
  document.querySelectorAll('.data-table tbody tr').forEach(row => {
    const text = row.textContent.toLowerCase();
    row.style.display = text.includes(term) ? '' : 'none';
  });
});

// Close modal on overlay click
modal.addEventListener('click', function(e) {
  if (e.target === modal) closeModal();
});

// Event delegation for edit/delete buttons
document.querySelector('.data-table tbody').addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const id = btn.getAttribute('data-id');
  const action = btn.getAttribute('data-action');
  if (action === 'edit') {
    editTool(id);
  } else if (action === 'delete') {
    deleteTool(id);
  }
});
</script>

<%- include('partials/footer') %>

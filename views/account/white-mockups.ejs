<%
  const visibleProjects = projects.filter(project => project.projectType === 'white_mockup');
  const formatDate = function(value) {
    if (!value) return 'Just now';
    const parsed = new Date(String(value).includes('T') ? value : `${value}Z`);
    return Number.isNaN(parsed.getTime()) ? value : parsed.toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' });
  };
  const projectUrl = function(project) {
    return `${project.sourceUrl}?project=${encodeURIComponent(project.id)}`;
  };
%>
<%- include('partials/workspace-shell', {
  currentView: 'whiteMockups',
  headerEyebrow: 'Fashion mockup library',
  headerDetail: 'Continue saved on-model compositions.'
}) %>

    <section class="workspace-section workspace-page-section workspace-project-list" aria-label="Saved fashion mockups">
      <div class="workspace-library-toolbar"><span class="workspace-library-count"><%= visibleProjects.length %> <%= visibleProjects.length === 1 ? 'mockup' : 'mockups' %></span><a class="workspace-create-link" href="/white-mockups"><span aria-hidden="true">+</span> Create mockup</a></div>
      <% if (visibleProjects.length) { %><div class="workspace-list-controls"><label><span class="sr-only">Search fashion mockups</span><input type="search" data-project-search placeholder="Search mockups" autocomplete="off"></label><label><span class="sr-only">Sort fashion mockups</span><select data-project-sort><option value="recent">Last updated</option><option value="oldest">Oldest updated</option><option value="name">Name A–Z</option></select></label></div><% } %>
      <div class="workspace-results-scroll" role="region" aria-label="Fashion mockup list" tabindex="0">
      <div class="workspace-project-grid" id="workspaceProjectGrid">
        <% visibleProjects.forEach(function(project) { %>
          <article class="workspace-project-card" data-project-id="<%= project.id %>" data-project-type="<%= project.projectType %>" data-project-name="<%= project.name.toLowerCase() %>" data-project-updated="<%= project.updatedAt || '' %>">
            <a class="workspace-project-image" href="<%= projectUrl(project) %>">
              <% if (project.previewImageUrl) { %><img src="<%= project.previewImageUrl %>" alt="<%= project.name %> preview" loading="lazy"><% } else { %><span class="workspace-card-placeholder">Preview unavailable</span><% } %>
            </a>
            <div class="workspace-project-details"><div><h3 data-project-title><a href="<%= projectUrl(project) %>"><%= project.name %></a></h3><span>Edited <%= formatDate(project.updatedAt) %></span></div><button type="button" class="workspace-more" data-project-menu-button aria-label="Actions for <%= project.name %>" aria-expanded="false">⋮</button></div>
            <div class="workspace-card-menu" hidden><button type="button" data-project-action="rename">Rename</button><button type="button" data-project-action="duplicate">Duplicate</button><a href="<%= projectUrl(project) %>">Open project</a><button class="is-danger" type="button" data-project-action="delete">Delete</button></div>
          </article>
        <% }); %>
      </div>
      <div class="workspace-search-empty" id="workspaceSearchEmpty" hidden><h3>No matching mockups</h3><p>Try another name or clear the search.</p><button type="button" data-project-clear-search>Clear search</button></div>
      <% if (!visibleProjects.length) { %><div class="workspace-empty-archive"><h3>No fashion mockups yet</h3><p>Create an on-model mockup and save it to your workbench.</p><div><a class="btn btn-primary" href="/white-mockups">Create a mockup</a></div></div><% } %>
      </div>
    </section>

    <dialog class="workspace-dialog" id="workspaceRenameDialog"><form method="dialog"><button class="workspace-dialog-close" value="cancel" aria-label="Close">×</button><span>PROJECT DETAILS</span><h2>Rename mockup</h2><label><span>Mockup name</span><input id="workspaceRenameInput" maxlength="120" required></label><div><button value="cancel">Cancel</button><button id="workspaceRenameConfirm" value="default">Save</button></div></form></dialog>
<%- include('partials/workspace-end', { showWorkspaceFooter: false }) %>

<%- include('partials/header') %>

<%
  const patternItems = patterns || [];
  const normalizeCategory = function(value) {
    return String(value || 'uncategorized')
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'uncategorized';
  };
  const categoryFilters = (categories && categories.length > 0)
    ? categories.map(cat => ({ name: cat.name, key: normalizeCategory(cat.name) }))
    : Array.from(new Set(patternItems.map(item => item.category).filter(Boolean)))
      .sort()
      .map(name => ({ name, key: normalizeCategory(name) }));
%>

<section class="page-header">
  <div class="container">
    <h1 class="page-title"><%= t('patterns.pageTitle') %></h1>
    <p class="page-subtitle"><%= t('patterns.pageSubtitle') %></p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="filters-bar">
      <div class="filter-group">
        <button class="filter-btn active" data-filter="all"><%= t('patterns.filterAll') %></button>
        <% categoryFilters.forEach(function(cat) { %>
          <button class="filter-btn" data-filter="<%= cat.key %>"><%= cat.name %></button>
        <% }); %>
      </div>
      <div class="sort-group">
        <select class="sort-select" id="patternsSort">
          <option value="newest"><%= t('patterns.sortNewest') %></option>
          <option value="name"><%= t('patterns.sortName') %></option>
          <option value="category">Category</option>
        </select>
      </div>
    </div>

    <div class="models-grid" id="patternsGrid">
      <% if (patternItems.length > 0) { %>
        <% patternItems.forEach(function(pattern) { %>
          <div
            class="model-card"
            data-category="<%= normalizeCategory(pattern.category) %>"
            data-name="<%= pattern.name || '' %>"
            data-created="<%= pattern.created_at || '' %>"
          >
            <a href="/patterns/item/<%= pattern.id %>" class="pattern-card-link" aria-label="<%= pattern.name %>">
            <div class="model-preview-3d">
              <div class="model-thumbnail">
                <% if (pattern.image_url) { %>
                  <img src="<%= pattern.image_url %>" alt="<%= pattern.name %>" class="model-img">
                <% } else { %>
                  <svg viewBox="0 0 200 200" class="model-svg" aria-hidden="true">
                    <rect x="40" y="40" width="120" height="120" rx="4" fill="#f5f5f5" stroke="#999" stroke-width="1"/>
                    <path d="M40 70H160" stroke="#999" stroke-width="1" stroke-dasharray="4"/>
                    <path d="M70 40V160" stroke="#999" stroke-width="1" stroke-dasharray="4"/>
                    <circle cx="100" cy="100" r="20" fill="none" stroke="#999" stroke-width="1"/>
                    <text x="100" y="140" text-anchor="middle" fill="#999" font-size="12"><%= pattern.format || 'zprj' %></text>
                  </svg>
                <% } %>
              </div>
            </div>
            <div class="model-info">
              <h3 class="model-name"><%= pattern.name %></h3>
              <p class="model-meta"><%= pattern.category %></p>
              <% if (pattern.description) { %>
                <p class="model-card-description"><%= pattern.description %></p>
              <% } %>
              <div class="model-tags">
                <% if (pattern.tags) { %>
                  <% pattern.tags.split(',').forEach(function(tag) { %>
                    <% if (tag.trim()) { %>
                      <span class="tag"><%= tag.trim() %></span>
                    <% } %>
                  <% }); %>
                <% } %>
                <span class="tag">.<%= pattern.format || 'zprj' %></span>
              </div>
            </div>
            </a>
            <div class="model-actions-overlay">
              <% if (pattern.file_url) { %>
                <a href="<%= pattern.file_url %>" class="btn btn-primary btn-small" download><%= t('patterns.downloadNow') %></a>
              <% } else { %>
                <button class="btn btn-primary btn-small" type="button" disabled><%= t('patterns.downloadNow') %></button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="empty-state model-empty-state">
          <svg class="empty-state-illustration" width="120" height="96" viewBox="0 0 120 96" fill="none" aria-hidden="true">
            <rect x="24" y="18" width="72" height="58" rx="6" fill="#f5f5f5" stroke="#d4d4d4" stroke-width="2"/>
            <path d="M43 18c2.8 9.2 31.2 9.2 34 0" stroke="#d4d4d4" stroke-width="2" stroke-linecap="round"/>
            <path d="M24 31 13 43l13 13M96 31l11 12-11 13" stroke="#d4d4d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M43 52h34M49 62h22" stroke="#b8b8b8" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <h3>No patterns yet</h3>
          <p>Active sew patterns from the admin database will appear here.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
(function() {
  const grid = document.getElementById('patternsGrid');
  if (!grid) return;

  const cards = Array.from(grid.querySelectorAll('.model-card'));
  const filterButtons = Array.from(document.querySelectorAll('.filter-btn[data-filter]'));
  const sortSelect = document.getElementById('patternsSort');
  let activeFilter = 'all';

  function applyFilter() {
    cards.forEach(card => {
      const matches = activeFilter === 'all' || card.dataset.category === activeFilter;
      card.style.display = matches ? '' : 'none';
    });
  }

  function applySort() {
    const sortValue = sortSelect ? sortSelect.value : 'newest';
    const sorted = cards.slice().sort((a, b) => {
      if (sortValue === 'name') {
        return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      }
      if (sortValue === 'category') {
        return (a.dataset.category || '').localeCompare(b.dataset.category || '');
      }
      return new Date(b.dataset.created || 0) - new Date(a.dataset.created || 0);
    });
    sorted.forEach(card => grid.appendChild(card));
    applyFilter();
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.filter;
      filterButtons.forEach(item => item.classList.toggle('active', item === button));
      applyFilter();
    });
  });

  if (sortSelect) {
    sortSelect.addEventListener('change', applySort);
  }
})();
</script>

<%- include('partials/footer') %>

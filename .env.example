# Public SEO origin
PUBLIC_SITE_ORIGIN=https://www.cloz-design.com
SESSION_SECRET=replace_with_a_long_random_secret
APP_BASE_URL=https://www.cloz-design.com

# Google sign-in (both credentials are required to display the sign-in button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.cloz-design.com/auth/google/callback

# Feature flags (disabled unless explicitly enabled)
AI_TRY_ON_ENABLED=true

# Dodo Payments subscriptions
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_payments_webhook_key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_MONTHLY_PRODUCT_ID=pdt_your_pro_monthly_product
DODO_PRO_YEARLY_PRODUCT_ID=pdt_your_pro_yearly_product
DODO_MAX_MONTHLY_PRODUCT_ID=pdt_your_max_monthly_product
DODO_MAX_YEARLY_PRODUCT_ID=pdt_your_max_yearly_product

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_PUBLIC_URL=https://pub-your_hash.r2.dev
